    "var_5a66b5340c87": {
      "type": "variant",
      "label": "Exercise Card — Focus Premium",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n  .focus-card * { box-sizing: border-box; }\n  .focus-card { font-family: 'Inter', sans-serif; }\n  .focus-card .hero-image { transition: transform 450ms ease; }\n  .focus-card:hover .hero-image { transform: scale(1.025); }\n  .focus-card .pressable { transition: background-color 180ms ease, border-color 180ms ease, transform 180ms ease, color 180ms ease; }\n  .focus-card .pressable:hover { transform: translateY(-1px); }\n  .focus-card .pressable:active { transform: translateY(1px) scale(.985); }\n  .focus-card .pressable:focus-visible, .focus-card input:focus-visible { outline: 3px solid rgba(195,244,0,.52); outline-offset: 3px; }\n  .focus-card .weight-input { caret-color: #c3f400; }\n  .focus-card .status { opacity: 0; transform: translateY(4px); transition: opacity 220ms ease, transform 220ms ease; }\n  .focus-card .status.is-visible { opacity: 1; transform: translateY(0); }\n  .focus-card .edit-mode .weight-display { display: none; }\n  .focus-card .edit-mode .weight-editor { display: flex; }\n  .focus-card .weight-editor { display: none; }\n  .focus-card .is-loading .play-icon { display: none; }\n  .focus-card .is-loading .loader-icon { display: inline-flex; }\n  .focus-card .loader-icon { display: none; }\n  .focus-card .primary-cta.is-loading { background: #abd600; color: #161e00; }\n</style>\n<div class=\"min-h-screen w-full bg-[#111508] px-[15px] py-[18px] text-[#e2e4cf] antialiased\" data-kid=\"1\" data-name=\"page background layout container\">\n    <div class=\"mx-auto flex min-h-[330px] w-full max-w-[344px] items-center justify-center\" data-kid=\"1-1\" data-name=\"exercise card alignment container\">\n        <article aria-label=\"Ejercicio Press banca plana\" class=\"focus-card w-full overflow-hidden rounded-[24px] border border-[#444933]/70 bg-[#1e2113]\" data-kid=\"1-1-1\" data-name=\"exercise card component\">\n            <div class=\"relative h-[190px] overflow-hidden bg-[#0c0f04]\" data-kid=\"1-1-1-1\" data-name=\"exercise card hero section\">\n                <img alt=\"Atleta haciendo press banca — foto de Marius Aholou, Pexels\" class=\"hero-image h-full w-full object-cover object-[center_54%]\" data-kid=\"1-1-1-1-1\" data-name=\"exercise hero image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11433060/pexels-photo-11433060.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n                <div class=\"pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(12,15,4,.18)_0%,rgba(12,15,4,.12)_38%,rgba(12,15,4,.92)_100%)]\" data-kid=\"1-1-1-1-2\" data-name=\"hero image overlay\">\n                </div>\n                <div class=\"absolute left-[16px] right-[16px] top-[16px] flex items-center justify-between\" data-kid=\"1-1-1-1-3\" data-name=\"exercise header badge container\">\n                    <span class=\"inline-flex items-center gap-[6px] rounded-full border border-[#c3f400]/40 bg-[#c3f400] px-[10px] py-[6px] text-[10px] font-extrabold uppercase tracking-[1.4px] text-[#161e00]\" data-kid=\"1-1-1-1-3-1\" data-name=\"exercise muscle target badge\">\n                        <i aria-hidden=\"true\" class=\"h-[12px] w-[12px]\" data-kid=\"1-1-1-1-3-1-1\" data-lucide=\"target\" data-name=\"target muscle icon\">\n                        </i>\n                        Pecho\n                    </span>\n                    <span class=\"rounded-full border border-white/15 bg-black/25 px-[9px] py-[5px] text-[10px] font-semibold tracking-[.4px] text-[#e2e4cf]/80 backdrop-blur-sm\" data-kid=\"1-1-1-1-3-2\" data-name=\"exercise type badge\">\n                        Fuerza · A\n                    </span>\n                </div>\n                <div class=\"absolute bottom-[16px] left-[16px] right-[16px]\" data-kid=\"1-1-1-1-4\" data-name=\"exercise title and subtitle container\">\n                    <div class=\"mb-[10px] h-[2px] w-[34px] bg-[#c3f400]\" data-kid=\"1-1-1-1-4-1\" data-name=\"decorative accent line\">\n                    </div>\n                    <h1 class=\"m-0 text-[24px] font-black leading-[1.05] tracking-[-.8px] text-[#f3f5e6]\" data-kid=\"1-1-1-1-4-2\" data-name=\"exercise name heading\">\n                        Press banca plana\n                    </h1>\n                    <p class=\"m-0 mt-[7px] text-[11px] font-medium tracking-[.25px] text-[#c4c9ac]\" data-kid=\"1-1-1-1-4-3\" data-name=\"exercise instructional subtitle\">\n                        Controlá la bajada · empujá con potencia\n                    </p>\n                </div>\n            </div>\n            <div class=\"border-t border-[#c3f400]/75 bg-[#1e2113]\" data-kid=\"1-1-1-2\" data-name=\"exercise details and control section\">\n                <div class=\"grid grid-cols-4 divide-x divide-[#444933]/60\" data-kid=\"1-1-1-2-1\" data-name=\"exercise metrics grid\">\n                    <div class=\"min-w-0 px-[12px] pb-[14px] pt-[16px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"sets metric container\">\n                        <p class=\"m-0 text-[9px] font-bold uppercase tracking-[1.25px] text-[#aeb49a]\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"sets label\">\n                            Series\n                        </p>\n                        <p class=\"m-0 mt-[7px] text-[22px] font-extrabold leading-none tracking-[-.5px] text-[#e2e4cf]\" data-kid=\"1-1-1-2-1-1-2\" data-name=\"sets count value\">\n                            4\n                        </p>\n                        <p class=\"m-0 mt-[5px] text-[10px] font-medium text-[#8e9379]\" data-kid=\"1-1-1-2-1-1-3\" data-name=\"sets description text\">\n                            totales\n                        </p>\n                    </div>\n                    <div class=\"min-w-0 px-[12px] pb-[14px] pt-[16px]\" data-kid=\"1-1-1-2-1-2\" data-name=\"reps metric container\">\n                        <p class=\"m-0 text-[9px] font-bold uppercase tracking-[1.25px] text-[#aeb49a]\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"reps label\">\n                            Reps\n                        </p>\n                        <p class=\"m-0 mt-[7px] text-[22px] font-extrabold leading-none tracking-[-.5px] text-[#c3f400]\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"reps count value\">\n                            12\n                        </p>\n                        <p class=\"m-0 mt-[5px] text-[10px] font-medium text-[#8e9379]\" data-kid=\"1-1-1-2-1-2-3\" data-name=\"reps description text\">\n                            por serie\n                        </p>\n                    </div>\n                    <div class=\"min-w-0 px-[12px] pb-[14px] pt-[16px]\" data-kid=\"1-1-1-2-1-3\" data-name=\"rest metric container\">\n                        <p class=\"m-0 text-[9px] font-bold uppercase tracking-[1.25px] text-[#aeb49a]\" data-kid=\"1-1-1-2-1-3-1\" data-name=\"rest label\">\n                            Descanso\n                        </p>\n                        <p class=\"m-0 mt-[7px] flex items-baseline gap-[2px] text-[22px] font-extrabold leading-none tracking-[-.5px] text-[#e2e4cf]\" data-kid=\"1-1-1-2-1-3-2\" data-name=\"rest duration value\">\n                            90\n                            <span class=\"text-[10px] font-semibold tracking-normal text-[#c4c9ac]\" data-kid=\"1-1-1-2-1-3-2-1\" data-name=\"rest unit label\">\n                                s\n                            </span>\n                        </p>\n                        <p class=\"m-0 mt-[5px] text-[10px] font-medium text-[#8e9379]\" data-kid=\"1-1-1-2-1-3-3\" data-name=\"rest description text\">\n                            entre series\n                        </p>\n                    </div>\n                    <div class=\"min-w-0 px-[10px] pb-[12px] pt-[16px]\" data-kid=\"1-1-1-2-1-4\" data-name=\"weight metric container\">\n                        <p class=\"m-0 text-[9px] font-bold uppercase tracking-[1.25px] text-[#aeb49a]\" data-kid=\"1-1-1-2-1-4-1\" data-name=\"weight label\">\n                            Peso\n                        </p>\n                        <button aria-controls=\"weightEditor\" aria-label=\"Editar peso, actualmente sin definir\" class=\"pressable weight-display mt-[5px] flex min-h-[44px] w-full items-center justify-center rounded-[12px] border border-[#c3f400]/65 bg-[#c3f400]/[.06] px-[5px] py-[6px] text-[#c3f400]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-4-2\" data-name=\"weight display interactive button\" data-reason=\"text value updated by weight save script\" id=\"weightControl\" type=\"button\">\n                            <span class=\"text-[20px] font-extrabold leading-none\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-4-2-1\" data-name=\"weight display number\" data-reason=\"text updated when user saves new weight\">\n                                —\n                            </span>\n                            <span class=\"ml-[2px] text-[10px] font-semibold\" data-kid=\"1-1-1-2-1-4-2-2\" data-name=\"weight display unit\">\n                                kg\n                            </span>\n                        </button>\n                        <div aria-hidden=\"true\" class=\"weight-editor mt-[2px] min-h-[44px] items-center gap-[3px]\" data-kid=\"1-1-1-2-1-4-3\" data-name=\"weight editor input form\" id=\"weightEditor\">\n                            <input aria-label=\"Peso en kilogramos\" class=\"weight-input min-w-0 w-[38px] rounded-[9px] border border-[#c3f400]/65 bg-[#0c0f04] px-[3px] py-[7px] text-center text-[14px] font-bold text-[#e2e4cf]\" data-kid=\"1-1-1-2-1-4-3-1\" data-name=\"weight input field\" id=\"weightInput\" inputmode=\"decimal\" placeholder=\"—\"/>\n                            <span class=\"text-[9px] font-semibold text-[#c4c9ac]\" data-kid=\"1-1-1-2-1-4-3-2\" data-name=\"weight unit label\">\n                                kg\n                            </span>\n                            <button aria-label=\"Guardar peso\" class=\"pressable inline-flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-full bg-[#c3f400] text-[#161e00]\" data-kid=\"1-1-1-2-1-4-3-3\" data-name=\"weight save button\" id=\"saveWeight\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"h-[12px] w-[12px]\" data-kid=\"1-1-1-2-1-4-3-3-1\" data-lucide=\"check\" data-name=\"checkmark icon\">\n                                </i>\n                            </button>\n                            <button aria-label=\"Cancelar edición de peso\" class=\"pressable inline-flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-full border border-[#444933] text-[#c4c9ac]\" data-kid=\"1-1-1-2-1-4-3-4\" data-name=\"weight cancel button\" id=\"cancelWeight\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"h-[12px] w-[12px]\" data-kid=\"1-1-1-2-1-4-3-4-1\" data-lucide=\"x\" data-name=\"x close icon\">\n                                </i>\n                            </button>\n                        </div>\n                        <p class=\"m-0 mt-[5px] text-center text-[10px] font-medium text-[#8e9379]\" data-kid=\"1-1-1-2-1-4-4\" data-name=\"editable hint text\">\n                            editable\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-[12px] border-t border-[#444933]/60 px-[16px] py-[14px]\" data-kid=\"1-1-1-2-2\" data-name=\"exercise action buttons container\">\n                    <button aria-label=\"Ver técnica de press banca plana\" class=\"pressable primary-cta flex min-h-[48px] flex-1 items-center justify-center gap-[8px] rounded-[14px] bg-[#c3f400] px-[14px] text-[13px] font-extrabold tracking-[.1px] text-[#161e00]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-2-1\" data-name=\"primary technique action button\" data-reason=\"text and aria-busy state updated by script\" id=\"techButton\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"play-icon h-[17px] w-[17px] fill-current\" data-kid=\"1-1-1-2-2-1-1\" data-lucide=\"play-circle\" data-name=\"play circle icon\">\n                        </i>\n                        <i aria-hidden=\"true\" class=\"loader-icon h-[17px] w-[17px]\" data-kid=\"1-1-1-2-2-1-2\" data-lucide=\"loader-circle\" data-name=\"loader icon\">\n                        </i>\n                        <span data-dynamic=\"true\" data-kid=\"1-1-1-2-2-1-3\" data-name=\"technique action button label\" data-reason=\"text updated during loading state\" id=\"techButtonLabel\">\n                            Ver técnica\n                        </span>\n                    </button>\n                    <button aria-label=\"Editar peso del ejercicio\" class=\"pressable min-h-[44px] shrink-0 rounded-[12px] px-[4px] text-[11px] font-bold text-[#c4c9ac] underline decoration-[#c3f400]/60 underline-offset-[3px] hover:text-[#c3f400]\" data-kid=\"1-1-1-2-2-2\" data-name=\"edit weight action button\" id=\"editWeightText\" type=\"button\">\n                        Editar peso\n                    </button>\n                </div>\n                <p aria-live=\"polite\" class=\"status m-0 px-[16px] pb-[13px] text-center text-[10px] font-semibold tracking-[.25px] text-[#c3f400]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-3\" data-name=\"status message text\" data-reason=\"text updated by script for interaction feedback\" id=\"statusMessage\" role=\"status\">\n                    Preparado para revisar tu técnica\n                </p>\n            </div>\n        </article>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n  const card = document.querySelector('.focus-card');\n  const weightControl = document.getElementById('weightControl');\n  const editWeightText = document.getElementById('editWeightText');\n  const editor = document.getElementById('weightEditor');\n  const input = document.getElementById('weightInput');\n  const save = document.getElementById('saveWeight');\n  const cancel = document.getElementById('cancelWeight');\n  const techButton = document.getElementById('techButton');\n  const techLabel = document.getElementById('techButtonLabel');\n  const status = document.getElementById('statusMessage');\n\n  function openWeightEditor() {\n    card.classList.add('edit-mode');\n    editor.setAttribute('aria-hidden', 'false');\n    weightControl.setAttribute('aria-hidden', 'true');\n    input.focus();\n  }\n  function closeWeightEditor() {\n    card.classList.remove('edit-mode');\n    editor.setAttribute('aria-hidden', 'true');\n    weightControl.setAttribute('aria-hidden', 'false');\n    weightControl.focus();\n  }\n  function showStatus(message) {\n    status.textContent = message;\n    status.classList.add('is-visible');\n  }\n  weightControl.addEventListener('click', openWeightEditor);\n  editWeightText.addEventListener('click', openWeightEditor);\n  cancel.addEventListener('click', closeWeightEditor);\n  save.addEventListener('click', () => {\n    const value = input.value.trim();\n    if (value) {\n      weightControl.querySelector('span').textContent = value;\n      weightControl.setAttribute('aria-label', 'Editar peso, actualmente ' + value + ' kilogramos');\n      showStatus('Peso guardado para esta sesión');\n    }\n    closeWeightEditor();\n  });\n  techButton.addEventListener('click', () => {\n    if (techButton.classList.contains('is-loading')) return;\n    techButton.classList.add('is-loading');\n    techButton.setAttribute('aria-busy', 'true');\n    techLabel.textContent = 'Abriendo técnica…';\n    showStatus('Cargando guía de press banca');\n    setTimeout(() => {\n      techButton.classList.remove('is-loading');\n      techButton.setAttribute('aria-busy', 'false');\n      techLabel.textContent = 'Ver técnica';\n      showStatus('Guía lista para comenzar');\n    }, 1500);\n  });\n</script>\n",
