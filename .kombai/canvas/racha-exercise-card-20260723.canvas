        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n\n  .timer-screen {\n    --bg: #0d1108;\n    --surface: #171b0f;\n    --surface-raised: #202518;\n    --surface-quiet: #12160c;\n    --ink: #e2e4cf;\n    --ink-soft: #c4c9ac;\n    --muted: #8e9379;\n    --line: rgba(226, 228, 207, 0.13);\n    --line-strong: rgba(226, 228, 207, 0.22);\n    --lime: #c3f400;\n    --lime-quiet: rgba(195, 244, 0, 0.12);\n    min-height: 100vh;\n    box-sizing: border-box;\n    padding: 24px 16px 28px;\n    color: var(--ink);\n    background: var(--bg);\n    font-family: 'Inter', sans-serif;\n  }\n\n  .timer-screen *,\n  .timer-screen *::before,\n  .timer-screen *::after { box-sizing: border-box; }\n\n  .workout-shell {\n    width: min(100%, 344px);\n    min-height: 704px;\n    margin: 0 auto;\n    padding: 16px;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n    background: var(--surface);\n    border: 1px solid var(--line);\n    border-radius: 22px;\n    box-shadow: 0 22px 54px rgba(0,0,0,.42), 0 1px 0 rgba(255,255,255,.035) inset;\n  }\n\n  .utility-bar {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    min-height: 32px;\n  }\n\n  .utility-back,\n  .utility-more {\n    width: 40px;\n    height: 40px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ink-soft);\n    background: transparent;\n    border: 1px solid transparent;\n    border-radius: 12px;\n    cursor: pointer;\n  }\n\n  .utility-back:hover,\n  .utility-more:hover,\n  .utility-back:focus-visible,\n  .utility-more:focus-visible {\n    color: var(--lime);\n    border-color: var(--line-strong);\n    background: var(--lime-quiet);\n    outline: 3px solid rgba(195,244,0,.12);\n    outline-offset: 2px;\n  }\n\n  .utility-copy {\n    color: var(--muted);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 1.4px;\n    text-transform: uppercase;\n  }\n\n  .rest-block {\n    position: relative;\n    display: grid;\n    grid-template-columns: 1fr auto;\n    align-items: end;\n    gap: 12px;\n    padding: 16px;\n    background: var(--surface-quiet);\n    border: 1px solid var(--line-strong);\n    border-radius: 18px;\n    overflow: hidden;\n  }\n\n  .rest-block::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: 3px;\n    background: rgba(195,244,0,.14);\n  }\n\n  .rest-block::after {\n    content: '';\n    position: absolute;\n    left: 0;\n    bottom: 0;\n    width: 64%;\n    height: 3px;\n    background: var(--lime);\n    box-shadow: 0 0 14px rgba(195,244,0,.35);\n  }\n\n  .rest-label {\n    margin-bottom: 6px;\n    color: var(--muted);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 1.1px;\n    text-transform: uppercase;\n  }\n\n  .timer-value {\n    color: var(--ink);\n    font-size: 36px;\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n    letter-spacing: -1.8px;\n    line-height: 1;\n  }\n\n  .skip-button {\n    min-height: 40px;\n    padding: 0 12px;\n    color: var(--ink-soft);\n    background: transparent;\n    border: 1px solid var(--line-strong);\n    border-radius: 10px;\n    font: inherit;\n    font-size: 11px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .skip-button:hover,\n  .skip-button:focus-visible {\n    color: var(--lime);\n    border-color: var(--lime);\n    background: var(--lime-quiet);\n    outline: 3px solid rgba(195,244,0,.14);\n    outline-offset: 2px;\n  }\n\n  .exercise-head {\n    display: grid;\n    grid-template-columns: 64px 1fr auto;\n    align-items: center;\n    gap: 12px;\n    padding: 2px 0 16px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .exercise-thumb {\n    width: 64px;\n    height: 64px;\n    object-fit: cover;\n    border-radius: 14px;\n    filter: grayscale(.7) contrast(1.05) brightness(.82);\n    border: 1px solid var(--line-strong);\n  }\n\n  .exercise-kicker {\n    margin: 0 0 5px;\n    color: var(--lime);\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: 1.1px;\n    text-transform: uppercase;\n  }\n\n  .exercise-title {\n    margin: 0;\n    color: var(--ink);\n    font-size: 20px;\n    font-weight: 800;\n    letter-spacing: -0.7px;\n    line-height: 1.05;\n  }\n\n  .exercise-meta {\n    margin: 6px 0 0;\n    color: var(--muted);\n    font-size: 10px;\n    line-height: 1.25;\n  }\n\n  .set-count {\n    align-self: start;\n    padding: 6px 7px;\n    color: var(--ink-soft);\n    background: var(--surface-raised);\n    border: 1px solid var(--line);\n    border-radius: 8px;\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: .3px;\n    white-space: nowrap;\n  }\n\n  .progress-rail {\n    display: grid;\n    gap: 7px;\n  }\n\n  .progress-topline {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    color: var(--muted);\n    font-size: 10px;\n    font-weight: 700;\n  }\n\n  .progress-topline strong {\n    color: var(--ink-soft);\n    font-weight: 700;\n  }\n\n  .rail {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 5px;\n  }\n\n  .rail-segment {\n    height: 5px;\n    background: var(--surface-raised);\n    border-radius: 999px;\n  }\n\n  .rail-segment.is-active { background: var(--lime); box-shadow: 0 0 10px rgba(195,244,0,.28); }\n\n  .prescription {\n    padding: 10px 12px;\n    color: var(--muted);\n    background: rgba(32,37,24,.46);\n    border-left: 2px solid rgba(195,244,0,.48);\n    border-radius: 0 10px 10px 0;\n    font-size: 11px;\n  }\n\n  .prescription strong { color: var(--ink-soft); font-weight: 700; }\n\n  .current-set {\n    display: grid;\n    gap: 12px;\n    padding-top: 2px;\n  }\n\n  .section-heading {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 12px;\n  }\n\n  .section-heading h2 {\n    margin: 0;\n    color: var(--ink);\n    font-size: 13px;\n    font-weight: 800;\n    letter-spacing: .1px;\n  }\n\n  .section-heading span {\n    color: var(--muted);\n    font-size: 10px;\n  }\n\n  .field-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 10px;\n  }\n\n  .metric-field {\n    position: relative;\n    min-width: 0;\n    min-height: 112px;\n    padding: 12px;\n    display: grid;\n    align-content: space-between;\n    gap: 9px;\n    background: var(--surface-quiet);\n    border: 1px solid var(--line-strong);\n    border-radius: 15px;\n  }\n\n  .metric-field:focus-within,\n  .metric-field.is-active {\n    border-color: rgba(195,244,0,.7);\n    box-shadow: 0 0 0 3px rgba(195,244,0,.1);\n  }\n\n  .field-label {\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: 1.1px;\n  }\n\n  .field-row {\n    display: grid;\n    grid-template-columns: 40px 1fr 40px;\n    align-items: center;\n    gap: 5px;\n  }\n\n  .step-button {\n    width: 40px;\n    height: 40px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ink-soft);\n    background: var(--surface-raised);\n    border: 1px solid var(--line-strong);\n    border-radius: 11px;\n    font-size: 18px;\n    line-height: 1;\n    cursor: pointer;\n  }\n\n  .step-button:hover,\n  .step-button:focus-visible {\n    color: var(--lime);\n    border-color: var(--lime);\n    background: var(--lime-quiet);\n    outline: 3px solid rgba(195,244,0,.12);\n    outline-offset: 2px;\n  }\n\n  .metric-input {\n    width: 100%;\n    min-width: 0;\n    padding: 0;\n    color: var(--ink);\n    background: transparent;\n    border: 0;\n    outline: 0;\n    font: inherit;\n    font-size: 27px;\n    font-weight: 800;\n    font-variant-numeric: tabular-nums;\n    letter-spacing: -1px;\n    text-align: center;\n  }\n\n  .metric-input::placeholder { color: var(--ink); opacity: .86; }\n  .metric-input:focus { color: var(--lime); }\n\n  .field-helper {\n    color: var(--muted);\n    font-size: 9px;\n  }\n\n  .field-helper strong { color: var(--lime); font-weight: 700; }\n\n  .bottom-actions {\n    display: grid;\n    gap: 8px;\n    margin-top: auto;\n    padding-top: 4px;\n  }\n\n  .complete-button {\n    min-height: 54px;\n    width: 100%;\n    color: #111508;\n    background: var(--lime);\n    border: 0;\n    border-radius: 14px;\n    box-shadow: 0 10px 22px rgba(195,244,0,.15), 0 1px 0 rgba(255,255,255,.5) inset;\n    font: inherit;\n    font-size: 13px;\n    font-weight: 800;\n    letter-spacing: .1px;\n    cursor: pointer;\n  }\n\n  .complete-button:hover,\n  .complete-button:focus-visible {\n    filter: brightness(1.06);\n    outline: 3px solid rgba(195,244,0,.2);\n    outline-offset: 3px;\n  }\n\n  .complete-button:active { transform: scale(.985); }\n\n  .technique-link {\n    justify-self: center;\n    min-height: 36px;\n    padding: 8px 12px;\n    color: var(--ink-soft);\n    background: transparent;\n    border: 0;\n    border-radius: 9px;\n    font: inherit;\n    font-size: 11px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .technique-link:hover,\n  .technique-link:focus-visible {\n    color: var(--lime);\n    background: var(--lime-quiet);\n    outline: 3px solid rgba(195,244,0,.12);\n    outline-offset: 2px;\n  }\n\n  .live-status {\n    min-height: 18px;\n    color: var(--muted);\n    font-size: 10px;\n    text-align: center;\n  }\n\n  .sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0,0,0,0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  @media (max-width: 340px) {\n    .timer-screen { padding-inline: 8px; }\n    .workout-shell { padding: 13px; }\n    .exercise-title { font-size: 18px; }\n    .metric-field { padding-inline: 9px; }\n    .field-row { grid-template-columns: 36px 1fr 36px; }\n    .step-button { width: 36px; }\n  }\n</style>\n<main aria-label=\"Registro de ejercicio\" class=\"timer-screen\" data-kid=\"1\">\n    <article class=\"workout-shell\" data-kid=\"1-1\" id=\"workout-card\">\n        <header class=\"utility-bar\" data-kid=\"1-1-1\">\n            <button aria-label=\"Volver al entrenamiento\" class=\"utility-back\" data-kid=\"1-1-1-1\" type=\"button\">\n                ‹\n            </button>\n            <span class=\"utility-copy\" data-kid=\"1-1-1-2\">\n                Sesión de hoy\n            </span>\n            <button aria-label=\"Más opciones\" class=\"utility-more\" data-kid=\"1-1-1-3\" type=\"button\">\n                •••\n            </button>\n        </header>\n        <section aria-labelledby=\"rest-label\" class=\"rest-block\" data-kid=\"1-1-2\">\n            <div data-kid=\"1-1-2-1\">\n                <div class=\"rest-label\" data-kid=\"1-1-2-1-1\" id=\"rest-label\">\n                    Descanso\n                </div>\n                <div aria-live=\"off\" class=\"timer-value\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2\" data-name=\"workout timer display\" data-reason=\"time string updated every second by countdown script\" id=\"timer-value\">\n                    01:30\n                </div>\n            </div>\n            <button aria-label=\"Saltar descanso\" class=\"skip-button\" data-kid=\"1-1-2-2\" id=\"skip-button\" type=\"button\">\n                Saltar\n            </button>\n        </section>\n        <section aria-labelledby=\"exercise-title\" class=\"exercise-head\" data-kid=\"1-1-3\">\n            <img alt=\"Atleta haciendo press banca — foto de Marius Aholou, Pexels\" class=\"exercise-thumb\" data-kid=\"1-1-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11433060/pexels-photo-11433060.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n            <div data-kid=\"1-1-3-2\">\n                <p class=\"exercise-kicker\" data-kid=\"1-1-3-2-1\">\n                    Pecho\n                </p>\n                <h1 class=\"exercise-title\" data-kid=\"1-1-3-2-2\" id=\"exercise-title\">\n                    Press banca plana\n                </h1>\n                <p class=\"exercise-meta\" data-kid=\"1-1-3-2-3\">\n                    Pecho · barra libre\n                </p>\n            </div>\n            <span class=\"set-count\" data-dynamic=\"true\" data-kid=\"1-1-3-3\" data-name=\"set counter status text\" data-reason=\"text replaced when series increments\" id=\"set-count\">\n                Serie 1 de 4\n            </span>\n        </section>\n        <section aria-label=\"Progreso de series\" class=\"progress-rail\" data-kid=\"1-1-4\">\n            <div class=\"progress-topline\" data-kid=\"1-1-4-1\">\n                <span data-kid=\"1-1-4-1-1\">\n                    Progreso\n                </span>\n                <strong data-dynamic=\"true\" data-kid=\"1-1-4-1-2\" data-name=\"progress label text\" data-reason=\"text replaced when series increments\" id=\"progress-label\">\n                    1 / 4\n                </strong>\n            </div>\n            <div aria-label=\"Series completadas\" class=\"rail\" data-kid=\"1-1-4-2\" data-name=\"progress rail container\" role=\"list\">\n                <span aria-label=\"Serie actual\" class=\"rail-segment is-active\" data-dynamic=\"true\" data-kid=\"1-1-4-2-1\" data-name=\"active progress segment\" data-reason=\"class toggled by script based on current set\" role=\"listitem\">\n                </span>\n                <span aria-label=\"Serie 2 pendiente\" class=\"rail-segment\" data-dynamic=\"true\" data-kid=\"1-1-4-2-2\" data-name=\"inactive progress segment\" data-reason=\"class toggled by script based on current set\" role=\"listitem\">\n                </span>\n                <span aria-label=\"Serie 3 pendiente\" class=\"rail-segment\" data-dynamic=\"true\" data-kid=\"1-1-4-2-3\" data-name=\"inactive progress segment\" data-reason=\"class toggled by script based on current set\" role=\"listitem\">\n                </span>\n                <span aria-label=\"Serie 4 pendiente\" class=\"rail-segment\" data-dynamic=\"true\" data-kid=\"1-1-4-2-4\" data-name=\"inactive progress segment\" data-reason=\"class toggled by script based on current set\" role=\"listitem\">\n                </span>\n            </div>\n        </section>\n        <div aria-label=\"Objetivo de la serie\" class=\"prescription\" data-kid=\"1-1-5\">\n            Objetivo ·\n            <strong data-kid=\"1-1-5-1\">\n                12 reps\n            </strong>\n            ·\n            <strong data-kid=\"1-1-5-2\">\n                90 s\n            </strong>\n        </div>\n        <section aria-labelledby=\"current-set-title\" class=\"current-set\" data-kid=\"1-1-6\">\n            <div class=\"section-heading\" data-kid=\"1-1-6-1\">\n                <h2 data-kid=\"1-1-6-1-1\" id=\"current-set-title\">\n                    Serie actual\n                </h2>\n                <span data-kid=\"1-1-6-1-2\">\n                    Toque para editar\n                </span>\n            </div>\n            <div class=\"field-grid\" data-kid=\"1-1-6-2\">\n                <div class=\"metric-field\" data-field=\"weight\" data-kid=\"1-1-6-2-1\">\n                    <label class=\"field-label\" data-kid=\"1-1-6-2-1-1\" for=\"weight-input\">\n                        PESO (KG)\n                    </label>\n                    <div class=\"field-row\" data-kid=\"1-1-6-2-1-2\">\n                        <button aria-label=\"Reducir peso\" class=\"step-button\" data-direction=\"down\" data-kid=\"1-1-6-2-1-2-1\" data-step=\"weight\" type=\"button\">\n                            −\n                        </button>\n                        <input aria-label=\"Peso en kilogramos\" class=\"metric-input\" data-kid=\"1-1-6-2-1-2-2\" data-name=\"weight input field\" id=\"weight-input\" inputmode=\"decimal\" min=\"0\" placeholder=\"—\" step=\"2.5\" type=\"number\"/>\n                        <button aria-label=\"Aumentar peso\" class=\"step-button\" data-direction=\"up\" data-kid=\"1-1-6-2-1-2-3\" data-step=\"weight\" type=\"button\">\n                            ＋\n                        </button>\n                    </div>\n                    <div class=\"field-helper\" data-kid=\"1-1-6-2-1-3\">\n                        <strong data-kid=\"1-1-6-2-1-3-1\">\n                            Editar\n                        </strong>\n                        · carga\n                    </div>\n                </div>\n                <div class=\"metric-field\" data-field=\"reps\" data-kid=\"1-1-6-2-2\">\n                    <label class=\"field-label\" data-kid=\"1-1-6-2-2-1\" for=\"reps-input\">\n                        REPS\n                    </label>\n                    <div class=\"field-row\" data-kid=\"1-1-6-2-2-2\">\n                        <button aria-label=\"Reducir repeticiones\" class=\"step-button\" data-direction=\"down\" data-kid=\"1-1-6-2-2-2-1\" data-step=\"reps\" type=\"button\">\n                            −\n                        </button>\n                        <input aria-label=\"Repeticiones\" class=\"metric-input\" data-kid=\"1-1-6-2-2-2-2\" data-name=\"reps input field\" id=\"reps-input\" inputmode=\"numeric\" max=\"30\" min=\"1\" type=\"number\" value=\"12\"/>\n                        <button aria-label=\"Aumentar repeticiones\" class=\"step-button\" data-direction=\"up\" data-kid=\"1-1-6-2-2-2-3\" data-step=\"reps\" type=\"button\">\n                            ＋\n                        </button>\n                    </div>\n                    <div class=\"field-helper\" data-kid=\"1-1-6-2-2-3\">\n                        Objetivo ·\n                        <strong data-kid=\"1-1-6-2-2-3-1\">\n                            12\n                        </strong>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <div class=\"bottom-actions\" data-kid=\"1-1-7\">\n            <button class=\"complete-button\" data-dynamic=\"true\" data-kid=\"1-1-7-1\" data-name=\"complete set button\" data-reason=\"text and state updated by script\" id=\"complete-button\" type=\"button\">\n                Completar serie\n            </button>\n            <button class=\"technique-link\" data-kid=\"1-1-7-2\" id=\"technique-button\" type=\"button\">\n                Ver técnica\n            </button>\n            <div aria-live=\"polite\" class=\"live-status\" data-dynamic=\"true\" data-kid=\"1-1-7-3\" data-name=\"live status announcer\" data-reason=\"text and accessibility notification updated by script events\" id=\"live-status\" role=\"status\">\n                Listo para registrar la primera serie.\n            </div>\n        </div>\n    </article>\n</main>\n<script type=\"module\">\n    import { animate } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n\n  const card = document.querySelector('#workout-card');\n  const timerValue = document.querySelector('#timer-value');\n  const skipButton = document.querySelector('#skip-button');\n  const completeButton = document.querySelector('#complete-button');\n  const techniqueButton = document.querySelector('#technique-button');\n  const status = document.querySelector('#live-status');\n  const weightInput = document.querySelector('#weight-input');\n  const repsInput = document.querySelector('#reps-input');\n  const setCount = document.querySelector('#set-count');\n  const progressLabel = document.querySelector('#progress-label');\n  const segments = [...document.querySelectorAll('.rail-segment')];\n  const fields = [...document.querySelectorAll('.metric-field')];\n  let timer = 90;\n  let timerId = null;\n  let currentSet = 1;\n  let complete = false;\n\n  animate(card, { opacity: [0, 1], y: [14, 0] }, { duration: .55, easing: [0.22, 1, 0.36, 1] });\n\n  const formatTime = (seconds) => `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;\n\n  function announce(message) {\n    status.textContent = message;\n    animate(status, { opacity: [0, 1], y: [3, 0] }, { duration: .2, easing: 'ease-out' });\n  }\n\n  function pulse(target) {\n    animate(target, { scale: [1, .9, 1] }, { duration: .24, easing: 'ease-out' });\n  }\n\n  function renderTimer() {\n    timerValue.textContent = formatTime(timer);\n    timerValue.style.color = timer <= 10 ? '#c3f400' : '';\n  }\n\n  function startTimer() {\n    clearInterval(timerId);\n    timerId = setInterval(() => {\n      timer = Math.max(0, timer - 1);\n      renderTimer();\n      if (timer === 0) {\n        clearInterval(timerId);\n        announce('Descanso terminado. Prepará la próxima serie.');\n      }\n    }, 1000);\n  }\n\n  function updateSet(nextSet) {\n    currentSet = Math.min(4, nextSet);\n    setCount.textContent = `Serie ${currentSet} de 4`;\n    progressLabel.textContent = `${currentSet} / 4`;\n    segments.forEach((segment, index) => segment.classList.toggle('is-active', index === currentSet - 1));\n    completeButton.textContent = currentSet === 4 ? 'Finalizar ejercicio' : 'Completar serie';\n  }\n\n  document.querySelectorAll('[data-step]').forEach((button) => {\n    button.addEventListener('click', () => {\n      const type = button.dataset.step;\n      const direction = button.dataset.direction === 'up' ? 1 : -1;\n      const input = type === 'weight' ? weightInput : repsInput;\n      const current = Number(input.value || (type === 'weight' ? 0 : 12));\n      const next = type === 'weight' ? Math.max(0, current + direction * 2.5) : Math.max(1, Math.min(30, current + direction));\n      input.value = next === 0 && type === 'weight' ? '' : String(next);\n      button.closest('.metric-field').classList.add('is-active');\n      setTimeout(() => button.closest('.metric-field').classList.remove('is-active'), 500);\n      pulse(input);\n      announce(type === 'weight' ? `Peso ajustado a ${next || 'sin definir'} kilos.` : `Repeticiones ajustadas a ${next}.`);\n    });\n  });\n\n  [weightInput, repsInput].forEach((input) => {\n    input.addEventListener('focus', () => input.closest('.metric-field').classList.add('is-active'));\n    input.addEventListener('blur', () => input.closest('.metric-field').classList.remove('is-active'));\n    input.addEventListener('change', () => announce(`${input.id === 'weight-input' ? 'Peso' : 'Repeticiones'} actualizado.`));\n  });\n\n  skipButton.addEventListener('click', () => {\n    clearInterval(timerId);\n    timer = 0;\n    renderTimer();\n    announce('Descanso saltado. Cuando estés listo, completá la serie.');\n    pulse(skipButton);\n  });\n\n  completeButton.addEventListener('click', () => {\n    if (currentSet >= 4) {\n      completeButton.textContent = 'Ejercicio finalizado';\n      completeButton.disabled = true;\n      announce('Ejercicio completado. Buen trabajo.');\n      animate(completeButton, { scale: [1, .97, 1] }, { duration: .3, easing: 'ease-out' });\n      return;\n    }\n    complete = true;\n    completeButton.textContent = 'Siguiente serie';\n    timer = 90;\n    renderTimer();\n    startTimer();\n    announce('Descanso iniciado. La próxima serie estará lista en 90 segundos.');\n    animate(timerValue, { scale: [1, 1.08, 1] }, { duration: .35, easing: 'ease-out' });\n    animate(completeButton, { scale: [1, .97, 1] }, { duration: .3, easing: 'ease-out' });\n  });\n\n  completeButton.addEventListener('click', () => {\n    if (complete && currentSet < 4) {\n      setTimeout(() => {\n        updateSet(currentSet + 1);\n        complete = false;\n        completeButton.textContent = 'Completar serie';\n      }, 300);\n    }\n  });\n\n  techniqueButton.addEventListener('click', () => announce('Técnica: escápulas atrás, pies firmes y barra al centro del pecho.'));\n</script>\n",
      "comments": [],
      "created": "2026-07-23T17:32:19.876595+00:00",
      "modified": "2026-07-23T17:33:07.894363+00:00",
      "id": "var_4342c571d655"
    },
    "var_0e4b02c3a4ec": {
      "type": "variant",
      "label": "Coach Detail — Log Set",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4750,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .coach-detail-canvas {\n    --canvas: #0d1008;\n    --surface: #171b0f;\n    --surface-low: #1d2114;\n    --surface-high: #252a19;\n    --text: #e2e4cf;\n    --text-muted: #a8ad93;\n    --text-soft: #858b74;\n    --line: rgba(226, 228, 207, 0.14);\n    --line-strong: rgba(226, 228, 207, 0.24);\n    --lime: #c3f400;\n    --lime-ink: #151b05;\n    --orange: #f59e55;\n    min-height: 100vh;\n    padding: 18px 10px 28px;\n    background: var(--canvas);\n    color: var(--text);\n    font-family: 'Inter', sans-serif;\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n  }\n\n  .coach-detail-card {\n    width: min(100%, 355px);\n    margin: 0 auto;\n    overflow: hidden;\n    background: var(--surface);\n    border: 1px solid var(--line-strong);\n    border-radius: 20px;\n    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.42), 0 1px 0 rgba(255, 255, 255, 0.045) inset;\n  }\n\n  .topbar {\n    min-height: 54px;\n    padding: 10px 14px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .icon-button {\n    width: 44px;\n    height: 44px;\n    border: 1px solid var(--line);\n    border-radius: 12px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--text-muted);\n    background: transparent;\n    cursor: pointer;\n  }\n\n  .icon-button:hover,\n  .icon-button:focus-visible {\n    color: var(--lime);\n    border-color: rgba(195, 244, 0, 0.7);\n    background: rgba(195, 244, 0, 0.08);\n    outline: 3px solid rgba(195, 244, 0, 0.14);\n    outline-offset: 2px;\n  }\n\n  .topbar-copy {\n    min-width: 0;\n    flex: 1;\n    padding: 0 12px;\n  }\n\n  .topbar-label {\n    margin: 0;\n    color: var(--text-soft);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 1.3px;\n    text-transform: uppercase;\n  }\n\n  .topbar-step {\n    margin: 3px 0 0;\n    color: var(--text);\n    font-size: 12px;\n    font-weight: 600;\n  }\n\n  .topbar-progress {\n    width: 42px;\n    height: 4px;\n    overflow: hidden;\n    border-radius: 999px;\n    background: var(--surface-high);\n  }\n\n  .topbar-progress span {\n    display: block;\n    width: 25%;\n    height: 100%;\n    border-radius: inherit;\n    background: var(--lime);\n  }\n\n  .exercise-preview {\n    padding: 16px 14px 15px;\n    display: grid;\n    grid-template-columns: 120px minmax(0, 1fr);\n    gap: 14px;\n    align-items: center;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .media-frame {\n    position: relative;\n    width: 120px;\n    height: 94px;\n    overflow: hidden;\n    border: 1px solid rgba(226, 228, 207, 0.2);\n    border-radius: 14px;\n    background: #0b0d07;\n  }\n\n  .media-frame img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: center;\n    filter: saturate(0.72) contrast(1.06) brightness(0.8);\n  }\n\n  .media-frame::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    background: rgba(5, 7, 3, 0.2);\n  }\n\n  .demo-button {\n    position: absolute;\n    z-index: 1;\n    right: 8px;\n    bottom: 8px;\n    width: 38px;\n    height: 38px;\n    border: 1px solid rgba(255, 255, 255, 0.34);\n    border-radius: 12px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: #fff;\n    background: rgba(12, 15, 4, 0.78);\n    cursor: pointer;\n  }\n\n  .demo-button:hover,\n  .demo-button:focus-visible {\n    color: var(--lime);\n    border-color: var(--lime);\n    outline: 3px solid rgba(195, 244, 0, 0.16);\n    outline-offset: 2px;\n  }\n\n  .exercise-copy {\n    min-width: 0;\n  }\n\n  .exercise-kicker {\n    margin: 0 0 6px;\n    color: var(--lime);\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: 1.6px;\n    text-transform: uppercase;\n  }\n\n  .exercise-title {\n    max-width: 170px;\n    margin: 0;\n    color: var(--text);\n    font-size: 23px;\n    font-weight: 800;\n    letter-spacing: -0.7px;\n    line-height: 1.04;\n  }\n\n  .exercise-subtitle {\n    margin: 7px 0 0;\n    color: var(--text-soft);\n    font-size: 11px;\n    line-height: 1.35;\n  }\n\n  .prescription {\n    padding: 15px 14px 14px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .section-label {\n    margin: 0 0 11px;\n    color: var(--text-soft);\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: 1.45px;\n    text-transform: uppercase;\n  }\n\n  .prescription-row {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    border-top: 1px solid var(--line);\n    border-bottom: 1px solid var(--line);\n  }\n\n  .prescription-item {\n    min-width: 0;\n    padding: 10px 9px 9px 0;\n  }\n\n  .prescription-item + .prescription-item {\n    padding-left: 12px;\n    border-left: 1px solid var(--line);\n  }\n\n  .prescription-value {\n    color: var(--text);\n    font-size: 18px;\n    font-weight: 800;\n    letter-spacing: -0.45px;\n  }\n\n  .prescription-unit {\n    margin-left: 3px;\n    color: var(--text-muted);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: 0;\n  }\n\n  .prescription-label {\n    margin-top: 5px;\n    color: var(--text-soft);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.6px;\n    text-transform: uppercase;\n  }\n\n  .technique-cue {\n    margin: 14px 14px 0;\n    padding: 11px 12px;\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    border-left: 2px solid rgba(195, 244, 0, 0.72);\n    border-top: 1px solid var(--line);\n    border-bottom: 1px solid var(--line);\n    background: rgba(37, 42, 25, 0.4);\n  }\n\n  .technique-icon {\n    width: 26px;\n    height: 26px;\n    flex: 0 0 26px;\n    border-radius: 8px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--lime);\n    background: rgba(195, 244, 0, 0.1);\n  }\n\n  .technique-copy {\n    min-width: 0;\n  }\n\n  .technique-label {\n    margin: 0 0 3px;\n    color: var(--text-soft);\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: 1.2px;\n    text-transform: uppercase;\n  }\n\n  .technique-text {\n    margin: 0;\n    color: var(--text-muted);\n    font-size: 11px;\n    line-height: 1.35;\n  }\n\n  .log-form {\n    margin: 14px;\n    padding: 14px;\n    border: 1px solid var(--line-strong);\n    border-radius: 15px;\n    background: var(--surface-low);\n  }\n\n  .log-heading-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    margin-bottom: 13px;\n  }\n\n  .log-heading {\n    margin: 0;\n    color: var(--text);\n    font-size: 14px;\n    font-weight: 800;\n    letter-spacing: -0.1px;\n  }\n\n  .log-status {\n    margin: 0;\n    color: var(--text-soft);\n    font-size: 10px;\n    font-weight: 600;\n  }\n\n  .fields {\n    display: grid;\n    grid-template-columns: 1.05fr 0.95fr;\n    gap: 9px;\n  }\n\n  .field {\n    min-width: 0;\n  }\n\n  .field-label {\n    display: block;\n    margin: 0 0 6px;\n    color: var(--text-muted);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.65px;\n    text-transform: uppercase;\n  }\n\n  .input-shell {\n    min-height: 58px;\n    position: relative;\n    display: flex;\n    align-items: center;\n    border: 1px solid var(--line-strong);\n    border-radius: 12px;\n    background: #12160c;\n  }\n\n  .input-shell:focus-within {\n    border-color: rgba(195, 244, 0, 0.86);\n    box-shadow: 0 0 0 3px rgba(195, 244, 0, 0.12);\n  }\n\n  .field input {\n    width: 100%;\n    min-height: 56px;\n    padding: 0 10px;\n    border: 0;\n    outline: 0;\n    color: var(--text);\n    background: transparent;\n    font: inherit;\n    font-size: 22px;\n    font-weight: 800;\n    letter-spacing: -0.7px;\n  }\n\n  .field input::placeholder {\n    color: var(--text-soft);\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 0;\n  }\n\n  .field-suffix {\n    padding-right: 10px;\n    color: var(--text-soft);\n    font-size: 11px;\n    font-weight: 700;\n  }\n\n  .field-helper {\n    min-height: 15px;\n    margin: 5px 0 0;\n    color: var(--text-soft);\n    font-size: 9px;\n    line-height: 1.25;\n  }\n\n  .field-helper.is-warning {\n    color: var(--orange);\n  }\n\n  .completion-row {\n    margin-top: 12px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .check-control {\n    width: 48px;\n    height: 48px;\n    flex: 0 0 48px;\n    border: 1px solid var(--line-strong);\n    border-radius: 14px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--text-muted);\n    background: #11150b;\n    cursor: pointer;\n  }\n\n  .check-control:hover,\n  .check-control:focus-visible {\n    color: var(--lime);\n    border-color: rgba(195, 244, 0, 0.8);\n    outline: 3px solid rgba(195, 244, 0, 0.12);\n    outline-offset: 2px;\n  }\n\n  .check-control.is-checked {\n    color: var(--lime-ink);\n    border-color: var(--lime);\n    background: var(--lime);\n  }\n\n  .check-copy {\n    min-width: 0;\n  }\n\n  .check-title {\n    margin: 0;\n    color: var(--text);\n    font-size: 11px;\n    font-weight: 700;\n  }\n\n  .check-note {\n    margin: 3px 0 0;\n    color: var(--text-soft);\n    font-size: 10px;\n  }\n\n  .primary-action {\n    width: 100%;\n    min-height: 50px;\n    margin-top: 12px;\n    border: 0;\n    border-radius: 12px;\n    color: var(--lime-ink);\n    background: var(--lime);\n    font: inherit;\n    font-size: 13px;\n    font-weight: 800;\n    cursor: pointer;\n    box-shadow: 0 10px 20px rgba(195, 244, 0, 0.11), 0 1px 0 rgba(255, 255, 255, 0.42) inset;\n  }\n\n  .primary-action:hover,\n  .primary-action:focus-visible {\n    filter: brightness(1.05);\n    outline: 3px solid rgba(195, 244, 0, 0.2);\n    outline-offset: 3px;\n  }\n\n  .primary-action:active {\n    transform: translateY(1px);\n  }\n\n  .secondary-actions {\n    padding: 0 14px 16px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n  }\n\n  .text-action {\n    min-height: 44px;\n    padding: 0;\n    border: 0;\n    color: var(--text-muted);\n    background: transparent;\n    font: inherit;\n    font-size: 11px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .text-action:hover,\n  .text-action:focus-visible {\n    color: var(--lime);\n    outline: 3px solid rgba(195, 244, 0, 0.14);\n    outline-offset: 3px;\n  }\n\n  .history-link {\n    min-width: 0;\n    padding: 5px 0;\n    border: 0;\n    color: var(--text-soft);\n    background: transparent;\n    font: inherit;\n    font-size: 10px;\n    text-align: right;\n    cursor: pointer;\n  }\n\n  .history-link strong {\n    display: block;\n    margin-top: 2px;\n    color: var(--text-muted);\n    font-size: 10px;\n    font-weight: 600;\n  }\n\n  .history-link:hover strong,\n  .history-link:focus-visible strong {\n    color: var(--lime);\n  }\n\n  .history-link:focus-visible,\n  .text-action:focus-visible {\n    outline: 3px solid rgba(195, 244, 0, 0.14);\n    outline-offset: 3px;\n  }\n\n  .live-status {\n    min-height: 20px;\n    padding: 0 14px 13px;\n    color: var(--text-soft);\n    font-size: 10px;\n    line-height: 1.3;\n  }\n\n  .live-status.is-visible {\n    color: var(--text-muted);\n  }\n</style>\n<main aria-label=\"Detalle de ejercicio y registro de serie\" class=\"coach-detail-canvas\" data-kid=\"1\">\n    <article class=\"coach-detail-card\" data-kid=\"1-1\" id=\"coach-card\">\n        <header class=\"topbar\" data-kid=\"1-1-1\">\n            <button aria-label=\"Volver a la rutina\" class=\"icon-button\" data-kid=\"1-1-1-1\" id=\"back-button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-chevron-left\" data-kid=\"1-1-1-1-1\" style=\"font-size:18px;color:currentColor\">\n                </i>\n            </button>\n            <div class=\"topbar-copy\" data-kid=\"1-1-1-2\">\n                <p class=\"topbar-label\" data-kid=\"1-1-1-2-1\">\n                    Rutina de hoy\n                </p>\n                <p class=\"topbar-step\" data-kid=\"1-1-1-2-2\">\n                    Pecho · ejercicio 1 de 6\n                </p>\n            </div>\n            <div aria-label=\"Progreso de la rutina: ejercicio 1 de 6\" class=\"topbar-progress\" data-kid=\"1-1-1-3\">\n                <span data-kid=\"1-1-1-3-1\" data-name=\"progress bar fill\">\n                </span>\n            </div>\n        </header>\n        <section aria-labelledby=\"exercise-title\" class=\"exercise-preview\" data-kid=\"1-1-2\">\n            <div class=\"media-frame\" data-kid=\"1-1-2-1\">\n                <img alt=\"Atleta haciendo press banca — foto de Marius Aholou, Pexels\" data-kid=\"1-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11433060/pexels-photo-11433060.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                <button aria-label=\"Ver demo de Press banca plana\" class=\"demo-button\" data-kid=\"1-1-2-1-2\" id=\"demo-button\" title=\"Ver demo\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-player-play-filled\" data-kid=\"1-1-2-1-2-1\" style=\"font-size:16px;color:currentColor\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"exercise-copy\" data-kid=\"1-1-2-2\">\n                <p class=\"exercise-kicker\" data-kid=\"1-1-2-2-1\">\n                    Pecho\n                </p>\n                <h1 class=\"exercise-title\" data-kid=\"1-1-2-2-2\" id=\"exercise-title\">\n                    Press banca plana\n                </h1>\n                <p class=\"exercise-subtitle\" data-kid=\"1-1-2-2-3\">\n                    Barra libre · fuerza\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"prescription-title\" class=\"prescription\" data-kid=\"1-1-3\">\n            <p class=\"section-label\" data-kid=\"1-1-3-1\" id=\"prescription-title\">\n                Hoy\n            </p>\n            <div class=\"prescription-row\" data-kid=\"1-1-3-2\">\n                <div class=\"prescription-item\" data-kid=\"1-1-3-2-1\">\n                    <div class=\"prescription-value\" data-kid=\"1-1-3-2-1-1\">\n                        4\n                        <span class=\"prescription-unit\" data-kid=\"1-1-3-2-1-1-1\">\n                            series\n                        </span>\n                    </div>\n                    <div class=\"prescription-label\" data-kid=\"1-1-3-2-1-2\">\n                        Volumen\n                    </div>\n                </div>\n                <div class=\"prescription-item\" data-kid=\"1-1-3-2-2\">\n                    <div class=\"prescription-value\" data-kid=\"1-1-3-2-2-1\">\n                        12\n                        <span class=\"prescription-unit\" data-kid=\"1-1-3-2-2-1-1\">\n                            reps\n                        </span>\n                    </div>\n                    <div class=\"prescription-label\" data-kid=\"1-1-3-2-2-2\">\n                        Objetivo\n                    </div>\n                </div>\n                <div class=\"prescription-item\" data-kid=\"1-1-3-2-3\">\n                    <div class=\"prescription-value\" data-kid=\"1-1-3-2-3-1\">\n                        90\n                        <span class=\"prescription-unit\" data-kid=\"1-1-3-2-3-1-1\">\n                            s\n                        </span>\n                    </div>\n                    <div class=\"prescription-label\" data-kid=\"1-1-3-2-3-2\">\n                        Descanso\n                    </div>\n                </div>\n            </div>\n        </section>\n        <aside aria-label=\"Clave de técnica\" class=\"technique-cue\" data-kid=\"1-1-4\">\n            <span class=\"technique-icon\" data-kid=\"1-1-4-1\">\n                <i aria-hidden=\"true\" class=\"ti ti-bulb\" data-kid=\"1-1-4-1-1\" style=\"font-size:15px;color:currentColor\">\n                </i>\n            </span>\n            <div class=\"technique-copy\" data-kid=\"1-1-4-2\">\n                <p class=\"technique-label\" data-kid=\"1-1-4-2-1\">\n                    Clave de técnica\n                </p>\n                <p class=\"technique-text\" data-kid=\"1-1-4-2-2\">\n                    Escápulas atrás · pies firmes · barra al centro del pecho\n                </p>\n            </div>\n        </aside>\n        <form class=\"log-form\" data-kid=\"1-1-5\" id=\"log-form\">\n            <div class=\"log-heading-row\" data-kid=\"1-1-5-1\">\n                <h2 class=\"log-heading\" data-kid=\"1-1-5-1-1\">\n                    Serie 1 / 4\n                </h2>\n                <p class=\"log-status\" data-dynamic=\"true\" data-kid=\"1-1-5-1-2\" data-name=\"log status text\" data-reason=\"text updated by script upon interaction\" id=\"log-status\">\n                    Sin registrar\n                </p>\n            </div>\n            <div class=\"fields\" data-kid=\"1-1-5-2\">\n                <div class=\"field\" data-kid=\"1-1-5-2-1\">\n                    <label class=\"field-label\" data-kid=\"1-1-5-2-1-1\" for=\"weight-input\">\n                        Peso\n                    </label>\n                    <div class=\"input-shell\" data-kid=\"1-1-5-2-1-2\">\n                        <input aria-describedby=\"weight-helper\" data-kid=\"1-1-5-2-1-2-1\" id=\"weight-input\" inputmode=\"decimal\" min=\"0\" name=\"weight\" placeholder=\"Añadir kg\" step=\"0.5\" type=\"number\"/>\n                        <span class=\"field-suffix\" data-kid=\"1-1-5-2-1-2-2\">\n                            kg\n                        </span>\n                    </div>\n                    <p class=\"field-helper\" data-dynamic=\"true\" data-kid=\"1-1-5-2-1-3\" data-name=\"weight input helper text\" data-reason=\"text updated by script upon validation error or success\" id=\"weight-helper\">\n                        Tocá para editar\n                    </p>\n                </div>\n                <div class=\"field\" data-kid=\"1-1-5-2-2\">\n                    <label class=\"field-label\" data-kid=\"1-1-5-2-2-1\" for=\"reps-input\">\n                        Reps\n                    </label>\n                    <div class=\"input-shell\" data-kid=\"1-1-5-2-2-2\">\n                        <input aria-describedby=\"reps-helper\" data-kid=\"1-1-5-2-2-2-1\" id=\"reps-input\" inputmode=\"numeric\" max=\"50\" min=\"1\" name=\"reps\" type=\"number\" value=\"12\"/>\n                    </div>\n                    <p class=\"field-helper\" data-kid=\"1-1-5-2-2-3\" id=\"reps-helper\">\n                        Objetivo por serie\n                    </p>\n                </div>\n            </div>\n            <div class=\"completion-row\" data-kid=\"1-1-5-3\">\n                <button aria-label=\"Marcar serie 1 como completada\" aria-pressed=\"false\" class=\"check-control\" data-kid=\"1-1-5-3-1\" id=\"check-control\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-1-5-3-1-1\" style=\"font-size:21px;color:currentColor\">\n                    </i>\n                </button>\n                <div class=\"check-copy\" data-kid=\"1-1-5-3-2\">\n                    <p class=\"check-title\" data-kid=\"1-1-5-3-2-1\">\n                        ¿Lista para registrar?\n                    </p>\n                    <p class=\"check-note\" data-dynamic=\"true\" data-kid=\"1-1-5-3-2-2\" data-name=\"check note text\" data-reason=\"text updated by script upon interaction and submission\" id=\"check-note\">\n                        Completá el peso si querés guardar tu carga.\n                    </p>\n                </div>\n            </div>\n            <button class=\"primary-action\" data-dynamic=\"true\" data-kid=\"1-1-5-4\" data-name=\"register action button\" data-reason=\"text updated by script upon submission\" id=\"register-button\" type=\"submit\">\n                Registrar serie\n            </button>\n        </form>\n        <div class=\"secondary-actions\" data-kid=\"1-1-6\">\n            <button class=\"text-action\" data-kid=\"1-1-6-1\" id=\"add-set-button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-6-1-1\" style=\"font-size:13px;color:currentColor;margin-right:5px\">\n                </i>\n                Añadir serie\n            </button>\n            <button aria-label=\"Ver historial. Última vez: 50 kilogramos por 10 repeticiones\" class=\"history-link\" data-kid=\"1-1-6-2\" id=\"history-button\" type=\"button\">\n                Historial\n                <strong data-kid=\"1-1-6-2-1\">\n                    Última vez · 50 kg × 10\n                </strong>\n            </button>\n        </div>\n        <div aria-live=\"polite\" class=\"live-status\" data-dynamic=\"true\" data-kid=\"1-1-7\" data-name=\"live status container\" data-reason=\"text injected by script for screen reader accessibility\" id=\"live-status\" role=\"status\">\n        </div>\n    </article>\n</main>\n<script type=\"module\">\n    import { animate } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n\n  const card = document.querySelector('#coach-card');\n  const form = document.querySelector('#log-form');\n  const weightInput = document.querySelector('#weight-input');\n  const repsInput = document.querySelector('#reps-input');\n  const check = document.querySelector('#check-control');\n  const checkNote = document.querySelector('#check-note');\n  const logStatus = document.querySelector('#log-status');\n  const registerButton = document.querySelector('#register-button');\n  const weightHelper = document.querySelector('#weight-helper');\n  const liveStatus = document.querySelector('#live-status');\n  let completed = false;\n  let statusTimer;\n\n  animate(card, { opacity: [0, 1], y: [14, 0] }, { duration: 0.5, easing: 'ease-out' });\n\n  function announce(message) {\n    liveStatus.textContent = message;\n    liveStatus.classList.add('is-visible');\n    clearTimeout(statusTimer);\n    statusTimer = setTimeout(() => liveStatus.classList.remove('is-visible'), 2400);\n  }\n\n  function pulse(target) {\n    animate(target, { scale: [1, 0.96, 1] }, { duration: 0.26, easing: 'ease-out' });\n  }\n\n  function setCompleted(nextValue) {\n    completed = nextValue;\n    check.classList.toggle('is-checked', completed);\n    check.setAttribute('aria-pressed', String(completed));\n    checkNote.textContent = completed ? 'Serie lista para guardar.' : 'Completá el peso si querés guardar tu carga.';\n    logStatus.textContent = completed ? 'Lista' : 'Sin registrar';\n    announce(completed ? 'Serie marcada como completada.' : 'Serie desmarcada.');\n    pulse(check);\n  }\n\n  check.addEventListener('click', () => setCompleted(!completed));\n\n  form.addEventListener('submit', (event) => {\n    event.preventDefault();\n    const weight = weightInput.value.trim();\n    const reps = repsInput.value.trim() || '12';\n    if (!weight) {\n      weightHelper.textContent = 'Añadí el peso para registrar la carga';\n      weightHelper.classList.add('is-warning');\n      weightInput.focus();\n      announce('Falta el peso de esta serie.');\n      return;\n    }\n    weightHelper.textContent = 'Carga guardada';\n    weightHelper.classList.remove('is-warning');\n    setCompleted(true);\n    registerButton.textContent = 'Serie registrada';\n    logStatus.textContent = 'Registrada';\n    checkNote.textContent = `${weight} kg × ${reps} reps`;\n    announce(`Serie registrada: ${weight} kg por ${reps} repeticiones.`);\n    animate(registerButton, { scale: [1, 0.975, 1] }, { duration: 0.3, easing: 'ease-out' });\n  });\n\n  document.querySelector('#demo-button').addEventListener('click', () => announce('Demo lista: controlá la bajada y empujá con los pies firmes.'));\n  document.querySelector('#add-set-button').addEventListener('click', () => announce('Nueva serie añadida a la rutina.'));\n  document.querySelector('#history-button').addEventListener('click', () => announce('Última vez: 50 kg por 10 repeticiones.'));\n  document.querySelector('#back-button').addEventListener('click', () => announce('Volver a la rutina.'));\n</script>\n",
      "comments": [],
      "created": "2026-07-23T17:32:21.731176+00:00",
      "modified": "2026-07-23T17:32:57.133849+00:00",
      "id": "var_0e4b02c3a4ec"
    },
    "var_a33f3c92abce": {
      "type": "variant",
      "label": "Gym Log — Set Table",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5225,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .gym-log-canvas {\n    --bg: #111508;\n    --surface: #1e2113;\n    --surface-high: #282b1d;\n    --surface-low: #1a1d10;\n    --surface-highest: #333627;\n    --lime: #c3f400;\n    --lime-soft: rgba(195, 244, 0, 0.12);\n    --ink: #e2e4cf;\n    --muted: #8e9379;\n    --muted-strong: #c4c9ac;\n    --line: rgba(226, 228, 207, 0.12);\n    --line-strong: rgba(226, 228, 207, 0.2);\n    min-height: 100vh;\n    box-sizing: border-box;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 22px 14px;\n    background: var(--bg);\n    color: var(--ink);\n    font-family: 'Inter', sans-serif;\n  }\n\n  .gym-log-canvas *,\n  .gym-log-canvas *::before,\n  .gym-log-canvas *::after { box-sizing: border-box; }\n\n  .gym-log-panel {\n    width: min(100%, 347px);\n    overflow: hidden;\n    background: var(--surface);\n    border: 1px solid var(--line-strong);\n    border-radius: 18px;\n    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.34), 0 1px 0 rgba(255, 255, 255, 0.035) inset;\n  }\n\n  .gym-log-header {\n    display: grid;\n    grid-template-columns: 58px minmax(0, 1fr) 42px;\n    align-items: center;\n    gap: 12px;\n    padding: 14px 14px 12px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .exercise-thumb {\n    width: 58px;\n    height: 58px;\n    overflow: hidden;\n    border-radius: 12px;\n    background: #0c0f04;\n    border: 1px solid rgba(226, 228, 207, 0.15);\n  }\n\n  .exercise-thumb img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: 48% center;\n    filter: grayscale(1) contrast(1.08) brightness(0.78);\n  }\n\n  .exercise-meta { min-width: 0; }\n\n  .exercise-kicker {\n    margin: 0 0 4px;\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 1px;\n    line-height: 1.1;\n    text-transform: uppercase;\n  }\n\n  .exercise-title {\n    overflow: hidden;\n    margin: 0;\n    color: var(--ink);\n    font-size: 17px;\n    font-weight: 800;\n    letter-spacing: -0.55px;\n    line-height: 1.1;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .exercise-subtitle {\n    margin: 5px 0 0;\n    overflow: hidden;\n    color: var(--muted-strong);\n    font-size: 10px;\n    line-height: 1.2;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .icon-button,\n  .tech-button,\n  .complete-button,\n  .add-set-button,\n  .cell-button,\n  .done-toggle {\n    -webkit-tap-highlight-color: transparent;\n    cursor: pointer;\n  }\n\n  .icon-button {\n    width: 42px;\n    height: 42px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--muted-strong);\n    background: transparent;\n    border: 1px solid var(--line-strong);\n    border-radius: 12px;\n  }\n\n  .icon-button:hover,\n  .icon-button:focus-visible,\n  .tech-button:hover,\n  .tech-button:focus-visible,\n  .add-set-button:hover,\n  .add-set-button:focus-visible {\n    color: var(--lime);\n    border-color: rgba(195, 244, 0, 0.6);\n    background: var(--lime-soft);\n    outline: 3px solid rgba(195, 244, 0, 0.14);\n    outline-offset: 2px;\n  }\n\n  .icon-button i,\n  .tech-button i,\n  .complete-button i,\n  .add-set-button i,\n  .done-toggle i {\n    font-size: 18px;\n    line-height: 1;\n  }\n\n  .target-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    padding: 12px 14px;\n    color: var(--muted-strong);\n    font-size: 11px;\n    font-weight: 600;\n  }\n\n  .target-copy { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n  .rest-pill {\n    flex: 0 0 auto;\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    min-height: 30px;\n    padding: 0 9px;\n    color: var(--lime);\n    background: var(--lime-soft);\n    border: 1px solid rgba(195, 244, 0, 0.28);\n    border-radius: 999px;\n    font-size: 10px;\n    font-weight: 800;\n  }\n\n  .rest-pill i { font-size: 13px; }\n\n  .table-wrap {\n    padding: 0 10px 4px;\n    overflow-x: auto;\n    scrollbar-width: none;\n  }\n\n  .table-wrap::-webkit-scrollbar { display: none; }\n\n  .set-table {\n    width: 100%;\n    min-width: 310px;\n    border-collapse: separate;\n    border-spacing: 0 5px;\n    table-layout: fixed;\n  }\n\n  .set-table th {\n    padding: 0 4px 4px;\n    color: var(--muted);\n    font-size: 8px;\n    font-weight: 800;\n    letter-spacing: 0.8px;\n    line-height: 1;\n    text-align: left;\n    text-transform: uppercase;\n  }\n\n  .set-table th:nth-child(1) { width: 38px; }\n  .set-table th:nth-child(2) { width: 82px; }\n  .set-table th:nth-child(3) { width: 48px; }\n  .set-table th:nth-child(4) { width: 48px; }\n  .set-table th:nth-child(5) { width: 45px; text-align: center; }\n\n  .set-table td {\n    height: 46px;\n    padding: 3px 4px;\n    color: var(--ink);\n    background: var(--surface-low);\n    border-top: 1px solid var(--line);\n    border-bottom: 1px solid var(--line);\n    font-size: 11px;\n    font-weight: 700;\n    vertical-align: middle;\n  }\n\n  .set-table td:first-child {\n    border-left: 1px solid var(--line);\n    border-radius: 10px 0 0 10px;\n  }\n\n  .set-table td:last-child {\n    border-right: 1px solid var(--line);\n    border-radius: 0 10px 10px 0;\n    text-align: center;\n  }\n\n  .set-table tr.active-row td {\n    background: rgba(195, 244, 0, 0.055);\n    border-top-color: rgba(195, 244, 0, 0.56);\n    border-bottom-color: rgba(195, 244, 0, 0.56);\n  }\n\n  .set-table tr.active-row td:first-child { border-left-color: rgba(195, 244, 0, 0.56); }\n  .set-table tr.active-row td:last-child { border-right-color: rgba(195, 244, 0, 0.56); }\n\n  .set-number {\n    color: var(--muted-strong);\n    font-size: 11px;\n    font-weight: 800;\n  }\n\n  .set-table tr.active-row .set-number { color: var(--lime); }\n\n  .previous-value {\n    color: var(--muted-strong);\n    font-size: 10px;\n    font-weight: 600;\n    white-space: nowrap;\n  }\n\n  .previous-value span {\n    color: var(--muted);\n    font-size: 8px;\n    font-weight: 500;\n  }\n\n  .cell-input {\n    width: 100%;\n    min-width: 0;\n    min-height: 40px;\n    padding: 0 2px;\n    color: var(--lime);\n    background: transparent;\n    border: 0;\n    border-bottom: 1px solid rgba(195, 244, 0, 0.58);\n    outline: none;\n    font: inherit;\n    font-size: 11px;\n    font-weight: 800;\n    text-align: left;\n  }\n\n  .cell-input::placeholder { color: var(--lime); opacity: 0.85; }\n  .cell-input:focus-visible { border-bottom-color: var(--lime); box-shadow: 0 3px 0 rgba(195, 244, 0, 0.13); }\n\n  .cell-button {\n    width: 100%;\n    min-height: 40px;\n    padding: 0;\n    color: var(--muted-strong);\n    background: transparent;\n    border: 0;\n    font: inherit;\n    font-size: 11px;\n    font-weight: 700;\n    text-align: left;\n  }\n\n  .cell-button:hover,\n  .cell-button:focus-visible {\n    color: var(--lime);\n    outline: 3px solid rgba(195, 244, 0, 0.13);\n    outline-offset: -2px;\n    border-radius: 7px;\n  }\n\n  .done-toggle {\n    width: 36px;\n    height: 36px;\n    min-width: 36px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: transparent;\n    background: var(--surface-high);\n    border: 1px solid rgba(226, 228, 207, 0.23);\n    border-radius: 10px;\n  }\n\n  .done-toggle:hover,\n  .done-toggle:focus-visible {\n    color: var(--lime);\n    border-color: rgba(195, 244, 0, 0.6);\n    outline: 3px solid rgba(195, 244, 0, 0.14);\n    outline-offset: 2px;\n  }\n\n  .done-toggle[aria-checked='true'] {\n    color: var(--bg);\n    background: var(--lime);\n    border-color: var(--lime);\n  }\n\n  .add-set-button {\n    width: 100%;\n    min-height: 42px;\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    padding: 0 6px;\n    color: var(--muted-strong);\n    background: transparent;\n    border: 0;\n    font: inherit;\n    font-size: 11px;\n    font-weight: 700;\n    text-align: left;\n  }\n\n  .add-set-button i { color: var(--lime); font-size: 16px; }\n\n  .bottom-actions {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 44px;\n    gap: 9px;\n    padding: 12px 14px 14px;\n    border-top: 1px solid var(--line);\n    background: rgba(17, 21, 8, 0.22);\n  }\n\n  .complete-button {\n    min-height: 48px;\n    padding: 0 14px;\n    color: var(--bg);\n    background: var(--lime);\n    border: 0;\n    border-radius: 12px;\n    box-shadow: 0 8px 18px rgba(195, 244, 0, 0.13), 0 1px 0 rgba(255, 255, 255, 0.44) inset;\n    font: inherit;\n    font-size: 12px;\n    font-weight: 800;\n  }\n\n  .complete-button:hover,\n  .complete-button:focus-visible {\n    filter: brightness(1.06);\n    outline: 3px solid rgba(195, 244, 0, 0.22);\n    outline-offset: 3px;\n  }\n\n  .tech-button {\n    width: 44px;\n    min-height: 48px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--muted-strong);\n    background: transparent;\n    border: 1px solid var(--line-strong);\n    border-radius: 12px;\n  }\n\n  .live-status {\n    min-height: 19px;\n    padding: 0 14px 11px;\n    color: var(--muted);\n    font-size: 9px;\n    line-height: 1.3;\n  }\n\n  .sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  @media (max-width: 340px) {\n    .gym-log-canvas { padding-inline: 8px; }\n    .gym-log-panel { border-radius: 16px; }\n    .gym-log-header { grid-template-columns: 54px minmax(0, 1fr) 42px; gap: 9px; padding-inline: 11px; }\n    .exercise-thumb { width: 54px; height: 54px; }\n    .target-row, .bottom-actions { padding-inline: 11px; }\n  }\n</style>\n<main aria-label=\"Registro de ejercicio Press banca plana\" class=\"gym-log-canvas\" data-kid=\"1\" data-name=\"exercise tracking main container\">\n    <article class=\"gym-log-panel\" data-kid=\"1-1\" data-name=\"exercise logging panel\" id=\"gym-log-panel\">\n        <header class=\"gym-log-header\" data-kid=\"1-1-1\" data-name=\"exercise header\">\n            <div class=\"exercise-thumb\" data-kid=\"1-1-1-1\" data-name=\"exercise image container\">\n                <img alt=\"Atleta haciendo press banca — foto de Marius Aholou, Pexels\" data-kid=\"1-1-1-1-1\" data-name=\"exercise illustration\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11433060/pexels-photo-11433060.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n            </div>\n            <div class=\"exercise-meta\" data-kid=\"1-1-1-2\" data-name=\"exercise identification metadata\">\n                <p class=\"exercise-kicker\" data-kid=\"1-1-1-2-1\" data-name=\"exercise muscle group kicker\">\n                    Pecho\n                </p>\n                <h1 class=\"exercise-title\" data-kid=\"1-1-1-2-2\" data-name=\"exercise title\">\n                    Press banca plana\n                </h1>\n                <p class=\"exercise-subtitle\" data-kid=\"1-1-1-2-3\" data-name=\"exercise detail subtitle\">\n                    Pecho · barra libre\n                </p>\n            </div>\n            <button aria-label=\"Más opciones para Press banca plana\" class=\"icon-button\" data-kid=\"1-1-1-3\" data-name=\"more options button\" title=\"Más opciones\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-dots-vertical\" data-kid=\"1-1-1-3-1\" data-name=\"vertical dots icon\">\n                </i>\n            </button>\n        </header>\n        <div class=\"target-row\" data-kid=\"1-1-2\" data-name=\"exercise target summary row\">\n            <span class=\"target-copy\" data-kid=\"1-1-2-1\" data-name=\"target set and reps summary\">\n                4 series · 12 reps · 90 s descanso\n            </span>\n            <span aria-label=\"Descanso recomendado: 90 segundos\" class=\"rest-pill\" data-kid=\"1-1-2-2\" data-name=\"rest period pill\">\n                <i aria-hidden=\"true\" class=\"ti ti-clock\" data-kid=\"1-1-2-2-1\" data-name=\"clock icon\">\n                </i>\n                90 s\n            </span>\n        </div>\n        <div class=\"table-wrap\" data-kid=\"1-1-3\" data-name=\"sets data table wrapper\">\n            <table aria-label=\"Series de Press banca plana\" class=\"set-table\" data-kid=\"1-1-3-1\" data-name=\"sets tracking table\">\n                <thead data-kid=\"1-1-3-1-1\" data-name=\"table header\">\n                    <tr data-kid=\"1-1-3-1-1-1\" data-name=\"table header row\">\n                        <th data-kid=\"1-1-3-1-1-1-1\" data-name=\"set column header\" scope=\"col\">\n                            Set\n                        </th>\n                        <th data-kid=\"1-1-3-1-1-1-2\" data-name=\"previous performance column header\" scope=\"col\">\n                            Anterior\n                        </th>\n                        <th data-kid=\"1-1-3-1-1-1-3\" data-name=\"weight column header\" scope=\"col\">\n                            Kg\n                        </th>\n                        <th data-kid=\"1-1-3-1-1-1-4\" data-name=\"reps column header\" scope=\"col\">\n                            Reps\n                        </th>\n                        <th data-kid=\"1-1-3-1-1-1-5\" data-name=\"status column header\" scope=\"col\">\n                            Hecho\n                        </th>\n                    </tr>\n                </thead>\n                <tbody data-kid=\"1-1-3-1-2\" data-name=\"table body\">\n                    <tr class=\"active-row\" data-kid=\"1-1-3-1-2-1\" data-name=\"active exercise set row\" data-set-row=\"1\">\n                        <td data-kid=\"1-1-3-1-2-1-1\" data-name=\"set index cell\">\n                            <span class=\"set-number\" data-kid=\"1-1-3-1-2-1-1-1\" data-name=\"set number text\">\n                                1\n                            </span>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-1-2\" data-name=\"previous performance cell\">\n                            <span class=\"previous-value\" data-kid=\"1-1-3-1-2-1-2-1\" data-name=\"previous performance stats text\">\n                                50 × 10\n                            </span>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-1-3\" data-name=\"weight input cell\">\n                            <input aria-label=\"Peso del set 1 en kilogramos\" class=\"cell-input\" data-edit-input=\"weight\" data-kid=\"1-1-3-1-2-1-3-1\" data-name=\"weight input field\" inputmode=\"decimal\" min=\"0\" placeholder=\"—\" step=\"2.5\" type=\"number\"/>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-1-4\" data-name=\"reps input cell\">\n                            <input aria-label=\"Repeticiones del set 1\" class=\"cell-input\" data-edit-input=\"reps\" data-kid=\"1-1-3-1-2-1-4-1\" data-name=\"reps input field\" inputmode=\"numeric\" max=\"50\" min=\"1\" type=\"number\" value=\"12\"/>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-1-5\" data-name=\"completion status cell\">\n                            <button aria-checked=\"false\" aria-label=\"Marcar set 1 como hecho\" class=\"done-toggle\" data-kid=\"1-1-3-1-2-1-5-1\" data-name=\"done toggle checkbox button\" role=\"checkbox\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-1-3-1-2-1-5-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                            </button>\n                        </td>\n                    </tr>\n                    <tr data-kid=\"1-1-3-1-2-2\" data-name=\"exercise set row\" data-set-row=\"2\">\n                        <td data-kid=\"1-1-3-1-2-2-1\" data-name=\"set index cell\">\n                            <span class=\"set-number\" data-kid=\"1-1-3-1-2-2-1-1\" data-name=\"set number text\">\n                                2\n                            </span>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-2-2\" data-name=\"previous performance cell\">\n                            <span class=\"previous-value\" data-kid=\"1-1-3-1-2-2-2-1\" data-name=\"previous performance stats text\">\n                                50 × 10\n                            </span>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-2-3\" data-name=\"weight edit cell\">\n                            <button aria-label=\"Editar peso del set 2\" class=\"cell-button\" data-edit-cell=\"weight\" data-kid=\"1-1-3-1-2-2-3-1\" data-name=\"weight edit trigger button\" type=\"button\">\n                                —\n                            </button>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-2-4\" data-name=\"reps edit cell\">\n                            <button aria-label=\"Editar repeticiones del set 2\" class=\"cell-button\" data-edit-cell=\"reps\" data-kid=\"1-1-3-1-2-2-4-1\" data-name=\"reps edit trigger button\" type=\"button\">\n                                12\n                            </button>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-2-5\" data-name=\"completion status cell\">\n                            <button aria-checked=\"false\" aria-label=\"Marcar set 2 como hecho\" class=\"done-toggle\" data-kid=\"1-1-3-1-2-2-5-1\" data-name=\"done toggle checkbox button\" role=\"checkbox\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-1-3-1-2-2-5-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                            </button>\n                        </td>\n                    </tr>\n                    <tr data-kid=\"1-1-3-1-2-3\" data-name=\"exercise set row\" data-set-row=\"3\">\n                        <td data-kid=\"1-1-3-1-2-3-1\" data-name=\"set index cell\">\n                            <span class=\"set-number\" data-kid=\"1-1-3-1-2-3-1-1\" data-name=\"set number text\">\n                                3\n                            </span>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-3-2\" data-name=\"previous performance cell\">\n                            <span class=\"previous-value\" data-kid=\"1-1-3-1-2-3-2-1\" data-name=\"previous performance stats text\">\n                                47.5 × 12\n                            </span>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-3-3\" data-name=\"weight edit cell\">\n                            <button aria-label=\"Editar peso del set 3\" class=\"cell-button\" data-edit-cell=\"weight\" data-kid=\"1-1-3-1-2-3-3-1\" data-name=\"weight edit trigger button\" type=\"button\">\n                                —\n                            </button>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-3-4\" data-name=\"reps edit cell\">\n                            <button aria-label=\"Editar repeticiones del set 3\" class=\"cell-button\" data-edit-cell=\"reps\" data-kid=\"1-1-3-1-2-3-4-1\" data-name=\"reps edit trigger button\" type=\"button\">\n                                12\n                            </button>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-3-5\" data-name=\"completion status cell\">\n                            <button aria-checked=\"false\" aria-label=\"Marcar set 3 como hecho\" class=\"done-toggle\" data-kid=\"1-1-3-1-2-3-5-1\" data-name=\"done toggle checkbox button\" role=\"checkbox\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-1-3-1-2-3-5-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                            </button>\n                        </td>\n                    </tr>\n                    <tr data-kid=\"1-1-3-1-2-4\" data-name=\"exercise set row\" data-set-row=\"4\">\n                        <td data-kid=\"1-1-3-1-2-4-1\" data-name=\"set index cell\">\n                            <span class=\"set-number\" data-kid=\"1-1-3-1-2-4-1-1\" data-name=\"set number text\">\n                                4\n                            </span>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-4-2\" data-name=\"previous performance cell\">\n                            <span class=\"previous-value\" data-kid=\"1-1-3-1-2-4-2-1\" data-name=\"previous performance stats text\">\n                                45 × 12\n                            </span>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-4-3\" data-name=\"weight edit cell\">\n                            <button aria-label=\"Editar peso del set 4\" class=\"cell-button\" data-edit-cell=\"weight\" data-kid=\"1-1-3-1-2-4-3-1\" data-name=\"weight edit trigger button\" type=\"button\">\n                                —\n                            </button>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-4-4\" data-name=\"reps edit cell\">\n                            <button aria-label=\"Editar repeticiones del set 4\" class=\"cell-button\" data-edit-cell=\"reps\" data-kid=\"1-1-3-1-2-4-4-1\" data-name=\"reps edit trigger button\" type=\"button\">\n                                12\n                            </button>\n                        </td>\n                        <td data-kid=\"1-1-3-1-2-4-5\" data-name=\"completion status cell\">\n                            <button aria-checked=\"false\" aria-label=\"Marcar set 4 como hecho\" class=\"done-toggle\" data-kid=\"1-1-3-1-2-4-5-1\" data-name=\"done toggle checkbox button\" role=\"checkbox\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-1-3-1-2-4-5-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                            </button>\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n            <button class=\"add-set-button\" data-kid=\"1-1-3-2\" data-name=\"add set button\" id=\"add-set-button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-3-2-1\" data-name=\"plus icon\">\n                </i>\n                Agregar serie\n            </button>\n        </div>\n        <div class=\"bottom-actions\" data-kid=\"1-1-4\" data-name=\"bottom action container\">\n            <button class=\"complete-button\" data-dynamic=\"true\" data-kid=\"1-1-4-1\" data-name=\"complete set button\" data-reason=\"text content replaced on click by script\" id=\"complete-button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-1-4-1-1\" data-name=\"checkmark icon\">\n                </i>\n                Completar serie\n            </button>\n            <button aria-label=\"Ver técnica de Press banca plana\" class=\"tech-button\" data-kid=\"1-1-4-2\" data-name=\"exercise technique button\" id=\"tech-button\" title=\"Ver técnica\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-player-play\" data-kid=\"1-1-4-2-1\" data-name=\"play icon\">\n                </i>\n            </button>\n        </div>\n        <div aria-live=\"polite\" class=\"live-status\" data-dynamic=\"true\" data-kid=\"1-1-5\" data-name=\"live status announcer\" data-reason=\"text updated to announce changes by script\" id=\"live-status\" role=\"status\">\n            Set 1 listo para registrar.\n        </div>\n    </article>\n</main>\n<script type=\"module\">\n    import { animate } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n\n  const panel = document.querySelector('#gym-log-panel');\n  const status = document.querySelector('#live-status');\n  const completeButton = document.querySelector('#complete-button');\n  const techButton = document.querySelector('#tech-button');\n  const addSetButton = document.querySelector('#add-set-button');\n\n  animate(panel, { opacity: [0, 1], y: [14, 0] }, { duration: 0.48, easing: 'ease-out' });\n\n  const announce = (message) => {\n    status.textContent = message;\n  };\n\n  const pulse = (target) => {\n    animate(target, { scale: [1, 0.94, 1] }, { duration: 0.2, easing: 'ease-out' });\n  };\n\n  document.querySelectorAll('.done-toggle').forEach((toggle) => {\n    toggle.addEventListener('click', () => {\n      const nextState = toggle.getAttribute('aria-checked') !== 'true';\n      const row = toggle.closest('tr');\n      const setNumber = row.dataset.setRow;\n      toggle.setAttribute('aria-checked', String(nextState));\n      row.classList.toggle('active-row', !nextState);\n      pulse(toggle);\n      announce(nextState ? `Set ${setNumber} completado. Descansá 90 segundos.` : `Set ${setNumber} reabierto para editar.`);\n    });\n  });\n\n  document.querySelectorAll('[data-edit-input]').forEach((input) => {\n    input.addEventListener('input', () => {\n      pulse(input);\n      const field = input.dataset.editInput === 'weight' ? 'Peso' : 'Repeticiones';\n      announce(`${field} del set 1 actualizado.`);\n    });\n  });\n\n  document.querySelectorAll('[data-edit-cell]').forEach((cell) => {\n    cell.addEventListener('click', () => {\n      pulse(cell);\n      announce(`Editá ${cell.dataset.editCell === 'weight' ? 'el peso' : 'las repeticiones'} de este set.`);\n    });\n  });\n\n  addSetButton.addEventListener('click', () => {\n    pulse(addSetButton);\n    announce('Nueva serie lista para configurar.');\n  });\n\n  techButton.addEventListener('click', () => {\n    pulse(techButton);\n    announce('Técnica: escápulas atrás, pies firmes y barra al centro del pecho.');\n  });\n\n  completeButton.addEventListener('click', () => {\n    pulse(completeButton);\n    completeButton.innerHTML = '<i class=\"ti ti-check\" aria-hidden=\"true\"></i> Serie guardada';\n    announce('Serie guardada. El descanso de 90 segundos está listo.');\n  });\n</script>\n",
