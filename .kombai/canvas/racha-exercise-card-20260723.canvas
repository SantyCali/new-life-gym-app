      "created": "2026-07-23T16:48:57.853461+00:00",
      "modified": "2026-07-23T16:49:18.258231+00:00",
      "id": "var_5a66b5340c87"
    },
    "var_678a4d7a2040": {
      "type": "variant",
      "label": "Exercise Card — Quick Set",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 475,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n  .quick-set-canvas {\n    --canvas: #111508;\n    --surface: #1e2113;\n    --surface-high: #282b1d;\n    --surface-highest: #333627;\n    --lime: #c3f400;\n    --lime-ink: #192000;\n    --text: #e2e4cf;\n    --muted: #c4c9ac;\n    --quiet: #8e9379;\n    --line: rgba(226, 228, 207, 0.12);\n    --orange: #ff6b2b;\n    font-family: 'Inter', sans-serif;\n  }\n  .quick-set-canvas * { box-sizing: border-box; }\n  .quick-set-image { filter: saturate(0.82) contrast(1.06) brightness(0.64); }\n  .quick-set-sheen { background: linear-gradient(180deg, rgba(12,15,4,0.06) 0%, rgba(12,15,4,0.12) 34%, rgba(12,15,4,0.94) 100%); }\n  .quick-set-rail { background: linear-gradient(180deg, var(--lime) 0%, rgba(195,244,0,0.32) 70%, transparent 100%); }\n  .quick-set-grid { background-image: linear-gradient(to right, rgba(226,228,207,0.06) 1px, transparent 1px); background-size: 25% 100%; }\n</style>\n<div class=\"quick-set-canvas min-h-screen w-full bg-[var(--canvas)] px-4 py-8 text-[var(--text)] antialiased sm:px-6\" data-kid=\"1\" data-name=\"page layout container\">\n    <main aria-label=\"Vista previa de tarjeta de ejercicio\" class=\"mx-auto flex min-h-[560px] w-full max-w-[344px] items-center justify-center\" data-kid=\"1-1\" data-name=\"main content area\">\n        <article aria-labelledby=\"exercise-title\" class=\"relative w-full overflow-hidden rounded-[24px] border border-[var(--line)] bg-[var(--surface)] shadow-[0_24px_64px_rgba(0,0,0,0.42)]\" data-kid=\"1-1-1\" data-name=\"exercise card container\">\n            <div aria-hidden=\"true\" class=\"quick-set-rail absolute bottom-0 left-0 top-0 z-20 w-1\" data-kid=\"1-1-1-1\" data-name=\"exercise indicator rail\">\n            </div>\n            <section aria-label=\"Imagen del ejercicio\" class=\"relative h-[218px] overflow-hidden\" data-kid=\"1-1-1-2\" data-name=\"exercise image section\">\n                <img alt=\"Atleta haciendo press banca — foto de Marius Aholou, Pexels\" class=\"quick-set-image absolute inset-0 h-full w-full object-cover object-center\" data-kid=\"1-1-1-2-1\" data-name=\"exercise athlete photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11433060/pexels-photo-11433060.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n                <div aria-hidden=\"true\" class=\"quick-set-sheen absolute inset-0\" data-kid=\"1-1-1-2-2\" data-name=\"image gradient sheen\">\n                </div>\n                <div class=\"absolute inset-x-0 top-0 flex items-start justify-between px-5 pt-5\" data-kid=\"1-1-1-2-3\" data-name=\"header actions container\">\n                    <span class=\"inline-flex items-center gap-2 rounded-full border border-[rgba(195,244,0,0.42)] bg-[rgba(17,21,8,0.78)] px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-[0.18em] text-[var(--lime)] backdrop-blur-sm\" data-kid=\"1-1-1-2-3-1\" data-name=\"exercise muscle group tag\">\n                        <span aria-hidden=\"true\" class=\"h-1.5 w-1.5 rounded-full bg-[var(--lime)] shadow-[0_0_10px_rgba(195,244,0,0.75)]\" data-kid=\"1-1-1-2-3-1-1\" data-name=\"muscle group status dot\">\n                        </span>\n                        Pecho\n                    </span>\n                    <span class=\"rounded-full border border-white/10 bg-black/25 px-2.5 py-1.5 text-[10px] font-semibold tracking-[0.08em] text-white/70 backdrop-blur-sm\" data-kid=\"1-1-1-2-3-2\" data-name=\"set index label\">\n                        01 / 06\n                    </span>\n                </div>\n                <div class=\"absolute inset-x-0 bottom-0 px-5 pb-5\" data-kid=\"1-1-1-2-4\" data-name=\"exercise title section\">\n                    <p class=\"mb-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-[var(--muted)]\" data-kid=\"1-1-1-2-4-1\" data-name=\"exercise category text\">\n                        Fuerza · Tren superior\n                    </p>\n                    <h1 class=\"max-w-[255px] text-[26px] font-black leading-[1.05] tracking-[-0.045em] text-white\" data-kid=\"1-1-1-2-4-2\" data-name=\"exercise title heading\" id=\"exercise-title\">\n                        Press banca plana\n                    </h1>\n                </div>\n            </section>\n            <section aria-label=\"Configuración de la serie\" class=\"px-4 pb-4 pt-4\" data-kid=\"1-1-1-3\" data-name=\"exercise configuration section\">\n                <div class=\"mb-3 flex items-center justify-between px-1\" data-kid=\"1-1-1-3-1\" data-name=\"next set header\">\n                    <div data-kid=\"1-1-1-3-1-1\" data-name=\"prescribed load label container\">\n                        <p class=\"text-[9px] font-bold uppercase tracking-[0.18em] text-[var(--quiet)]\" data-kid=\"1-1-1-3-1-1-1\" data-name=\"label next set\">\n                            Próxima serie\n                        </p>\n                        <p class=\"mt-1 text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-1-1-3-1-1-2\" data-name=\"label prescribed load\">\n                            Carga prescrita\n                        </p>\n                    </div>\n                    <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[rgba(255,107,43,0.24)] bg-[rgba(255,107,43,0.10)] px-2.5 py-1 text-[10px] font-bold text-[#ff9a70]\" data-kid=\"1-1-1-3-1-2\" data-name=\"status ready tag\">\n                        <span aria-hidden=\"true\" class=\"text-[12px]\" data-kid=\"1-1-1-3-1-2-1\" data-name=\"status ready bullet icon\">\n                            •\n                        </span>\n                        Listo\n                    </span>\n                </div>\n                <div aria-label=\"Métricas de Press banca plana\" class=\"quick-set-grid grid grid-cols-[1.16fr_1.16fr_0.95fr_1fr] overflow-hidden rounded-[18px] border border-[var(--line)] bg-[rgba(12,15,4,0.23)]\" data-kid=\"1-1-1-3-2\" data-name=\"metrics grid container\" role=\"group\">\n                    <div class=\"border-r border-[var(--line)] px-3 py-3.5\" data-kid=\"1-1-1-3-2-1\" data-name=\"sets metric box\">\n                        <p class=\"text-[9px] font-bold uppercase tracking-[0.16em] text-[var(--quiet)]\" data-kid=\"1-1-1-3-2-1-1\" data-name=\"label sets\">\n                            Series\n                        </p>\n                        <p class=\"mt-1.5 text-[22px] font-black leading-none tracking-[-0.05em] text-[var(--text)]\" data-kid=\"1-1-1-3-2-1-2\" data-name=\"count sets\">\n                            4\n                        </p>\n                        <p class=\"mt-1 text-[10px] font-medium text-[var(--quiet)]\" data-kid=\"1-1-1-3-2-1-3\" data-name=\"label prescribed\">\n                            prescritas\n                        </p>\n                    </div>\n                    <div class=\"border-r border-[var(--line)] px-3 py-3.5\" data-kid=\"1-1-1-3-2-2\" data-name=\"reps metric box\">\n                        <p class=\"text-[9px] font-bold uppercase tracking-[0.16em] text-[var(--quiet)]\" data-kid=\"1-1-1-3-2-2-1\" data-name=\"label reps\">\n                            Reps\n                        </p>\n                        <p class=\"mt-1.5 text-[22px] font-black leading-none tracking-[-0.05em] text-[var(--text)]\" data-kid=\"1-1-1-3-2-2-2\" data-name=\"count reps\">\n                            12\n                        </p>\n                        <p class=\"mt-1 text-[10px] font-medium text-[var(--quiet)]\" data-kid=\"1-1-1-3-2-2-3\" data-name=\"label per serie\">\n                            por serie\n                        </p>\n                    </div>\n                    <div class=\"border-r border-[var(--line)] px-3 py-3.5\" data-kid=\"1-1-1-3-2-3\" data-name=\"rest time metric box\">\n                        <p class=\"text-[9px] font-bold uppercase tracking-[0.12em] text-[var(--quiet)]\" data-kid=\"1-1-1-3-2-3-1\" data-name=\"label rest\">\n                            Descanso\n                        </p>\n                        <span class=\"mt-2 inline-flex items-center gap-1.5 rounded-lg bg-[rgba(195,244,0,0.10)] px-2 py-1.5 text-[14px] font-extrabold leading-none text-[var(--lime)]\" data-kid=\"1-1-1-3-2-3-2\" data-name=\"rest duration display\">\n                            <span aria-hidden=\"true\" class=\"text-[12px]\" data-kid=\"1-1-1-3-2-3-2-1\" data-name=\"rest timer clock icon\">\n                                ◷\n                            </span>\n                            90\n                            <span class=\"text-[9px] font-bold text-[rgba(195,244,0,0.76)]\" data-kid=\"1-1-1-3-2-3-2-2\" data-name=\"rest unit label\">\n                                s\n                            </span>\n                        </span>\n                    </div>\n                    <div class=\"px-2.5 py-2.5\" data-kid=\"1-1-1-3-2-4\" data-name=\"weight input box\">\n                        <button aria-label=\"Editar peso, actualmente sin definir\" class=\"group flex min-h-[64px] w-full flex-col items-center justify-center rounded-[13px] border border-dashed border-[rgba(195,244,0,0.44)] bg-[rgba(195,244,0,0.045)] text-center outline-none transition hover:border-[var(--lime)] hover:bg-[rgba(195,244,0,0.11)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--lime)] active:scale-[0.97]\" data-action=\"weight\" data-kid=\"1-1-1-3-2-4-1\" data-name=\"weight selection button\" id=\"weight-button\" type=\"button\">\n                            <span class=\"text-[9px] font-bold uppercase tracking-[0.14em] text-[var(--quiet)]\" data-kid=\"1-1-1-3-2-4-1-1\" data-name=\"label weight\">\n                                Peso\n                            </span>\n                            <span class=\"mt-1 flex items-center gap-1 text-[17px] font-black leading-none text-[var(--muted)]\" data-kid=\"1-1-1-3-2-4-1-2\" data-name=\"weight value display\">\n                                —\n                                <span class=\"text-[10px] font-semibold text-[var(--quiet)]\" data-kid=\"1-1-1-3-2-4-1-2-1\" data-name=\"weight unit label\">\n                                    kg\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"mt-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-[rgba(195,244,0,0.16)] text-[var(--lime)]\" data-kid=\"1-1-1-3-2-4-1-3\" data-name=\"edit pencil icon\">\n                                ✎\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <div aria-live=\"polite\" class=\"mt-3 flex items-center gap-2 rounded-xl border border-[var(--line)] bg-[rgba(226,228,207,0.035)] px-3 py-2.5\" data-dynamic=\"true\" data-kid=\"1-1-1-3-3\" data-name=\"status message area\" data-reason=\"text content and status dot color/shadow replaced by status update script\" role=\"status\">\n                    <span aria-hidden=\"true\" class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--lime)] shadow-[0_0_8px_rgba(195,244,0,0.6)]\" data-dynamic=\"true\" data-kid=\"1-1-1-3-3-1\" data-name=\"status dot icon\" data-reason=\"color and shadow replaced by status update script\" id=\"status-dot\">\n                    </span>\n                    <p class=\"text-[10px] font-medium leading-4 text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-1-1-3-3-2\" data-name=\"status message text\" data-reason=\"text content replaced by status update script\" id=\"status-message\">\n                        Ajustá tu carga y empezá cuando estés listo.\n                    </p>\n                </div>\n            </section>\n            <footer class=\"flex items-center gap-2 border-t border-[var(--line)] bg-[rgba(12,15,4,0.24)] px-4 py-4\" data-kid=\"1-1-1-4\" data-name=\"card footer actions\">\n                <button aria-label=\"Empezar ahora la serie de Press banca plana\" class=\"flex min-h-[48px] flex-1 items-center justify-center gap-2 rounded-[14px] bg-[var(--lime)] px-4 text-[12px] font-black tracking-[0.01em] text-[var(--lime-ink)] outline-none transition hover:brightness-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--lime)] active:scale-[0.98]\" data-action=\"start\" data-kid=\"1-1-1-4-1\" data-name=\"start training button\" id=\"start-button\" type=\"button\">\n                    <span aria-hidden=\"true\" class=\"flex h-5 w-5 items-center justify-center rounded-full bg-[rgba(25,32,0,0.14)] text-[11px]\" data-kid=\"1-1-1-4-1-1\" data-name=\"start arrow icon\">\n                        ▶\n                    </span>\n                    Empezar ahora\n                </button>\n                <button aria-label=\"Ver técnica de Press banca plana\" class=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-[14px] border border-[rgba(195,244,0,0.5)] bg-transparent text-[var(--lime)] outline-none transition hover:bg-[rgba(195,244,0,0.10)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--lime)] active:scale-[0.96]\" data-action=\"technique\" data-kid=\"1-1-1-4-2\" data-name=\"technique info button\" id=\"technique-button\" title=\"Ver técnica\" type=\"button\">\n                    <span aria-hidden=\"true\" class=\"text-[18px]\" data-kid=\"1-1-1-4-2-1\" data-name=\"technique icon\">\n                        ⌁\n                    </span>\n                </button>\n            </footer>\n        </article>\n    </main>\n</div>\n<script>\n    (() => {\n    const message = document.getElementById('status-message');\n    const dot = document.getElementById('status-dot');\n    const setStatus = (text, tone) => {\n      message.textContent = text;\n      dot.style.backgroundColor = tone === 'orange' ? 'var(--orange)' : 'var(--lime)';\n      dot.style.boxShadow = tone === 'orange' ? '0 0 8px rgba(255,107,43,0.55)' : '0 0 8px rgba(195,244,0,0.6)';\n    };\n    document.querySelector('[data-action=\"start\"]').addEventListener('click', () => setStatus('Serie iniciada: 4 × 12. Descansá 90 s al terminar.', 'lime'));\n    document.querySelector('[data-action=\"technique\"]').addEventListener('click', () => setStatus('Técnica: pies firmes, barra al pecho y bajada controlada.', 'lime'));\n    document.querySelector('[data-action=\"weight\"]').addEventListener('click', () => setStatus('Peso sin definir: elegí tu carga antes de empezar.', 'orange'));\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-07-23T16:48:58.411529+00:00",
      "modified": "2026-07-23T16:49:19.111691+00:00",
      "id": "var_678a4d7a2040"
    },
    "var_1976195d6783": {
      "type": "variant",
      "label": "Exercise Card — Coach Action",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 950,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n  :root {\n    --bg: #111508;\n    --surface: #1e2113;\n    --surface-high: #282b1d;\n    --surface-highest: #333627;\n    --primary: #c3f400;\n    --primary-dim: #abd600;\n    --text: #e2e4cf;\n    --text-secondary: #c4c9ac;\n    --text-tertiary: #8e9379;\n    --border: rgba(142, 147, 121, 0.16);\n    --border-strong: rgba(195, 244, 0, 0.48);\n  }\n  .exercise-stage { font-family: 'Inter', sans-serif; }\n  .exercise-card { box-shadow: 0 20px 40px rgba(0,0,0,.28); }\n  .exercise-card button:focus-visible,\n  .exercise-card input:focus-visible { outline: 3px solid rgba(195,244,0,.45); outline-offset: 3px; }\n  .hero-photo { filter: saturate(.76) contrast(1.06) brightness(.72); }\n  .hero-shade { background: rgba(6, 8, 3, .45); }\n  .edge-marker { box-shadow: 0 0 18px rgba(195,244,0,.34); }\n  .weight-editor[hidden], .weight-readout[hidden] { display: none; }\n  .pressable { transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease; }\n  .pressable:hover { transform: translateY(-1px); }\n  .pressable:active { transform: translateY(1px) scale(.985); }\n  .cta-active { box-shadow: 0 0 0 5px rgba(195,244,0,.10), 0 12px 28px rgba(195,244,0,.12); }\n  .metric-value { font-variant-numeric: tabular-nums; }\n</style>\n<div class=\"exercise-stage min-h-screen w-full bg-[var(--bg)] px-4 py-8 text-[var(--text)] flex items-center justify-center\" data-kid=\"1\">\n    <article aria-label=\"Tarjeta de ejercicio Press banca plana\" class=\"exercise-card w-full max-w-[344px] overflow-hidden rounded-[24px] border border-[var(--border)] bg-[var(--surface)]\" data-kid=\"1-1\">\n        <div class=\"relative h-[136px] overflow-hidden bg-[var(--surface-high)]\" data-kid=\"1-1-1\">\n            <img alt=\"Atleta haciendo press banca — foto de Marius Aholou, Pexels\" class=\"hero-photo absolute inset-0 h-full w-full object-cover object-[50%_48%]\" data-kid=\"1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11433060/pexels-photo-11433060.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n            <div aria-hidden=\"true\" class=\"hero-shade absolute inset-0\" data-kid=\"1-1-1-2\">\n            </div>\n            <div aria-hidden=\"true\" class=\"edge-marker absolute left-0 top-0 h-full w-1 bg-[var(--primary)]\" data-kid=\"1-1-1-3\">\n            </div>\n            <div class=\"absolute inset-x-4 top-4 flex items-start justify-between\" data-kid=\"1-1-1-4\">\n                <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[var(--primary)]/50 bg-[#111508]/85 px-3 py-1.5 text-[10px] font-extrabold tracking-[.16em] text-[var(--primary)] shadow-sm\" data-kid=\"1-1-1-4-1\">\n                    <i aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"1-1-1-4-1-1\" data-lucide=\"activity\">\n                    </i>\n                    PECHO\n                </span>\n                <span class=\"rounded-full border border-white/15 bg-black/30 px-2.5 py-1 text-[9px] font-semibold tracking-[.12em] text-white/70\" data-kid=\"1-1-1-4-2\">\n                    01 / 06\n                </span>\n            </div>\n            <div class=\"absolute inset-x-4 bottom-4 flex items-end justify-between gap-3\" data-kid=\"1-1-1-5\">\n                <div data-kid=\"1-1-1-5-1\">\n                    <p class=\"mb-1 text-[10px] font-semibold uppercase tracking-[.18em] text-white/65\" data-kid=\"1-1-1-5-1-1\">\n                        Ejercicio de hoy\n                    </p>\n                    <h1 class=\"text-[23px] font-black leading-[1.05] tracking-[-.04em] text-white\" data-kid=\"1-1-1-5-1-2\">\n                        Press banca plana\n                    </h1>\n                </div>\n                <span aria-hidden=\"true\" class=\"mb-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-white/15 bg-black/35 text-white/85\" data-kid=\"1-1-1-5-2\">\n                    <i class=\"h-[18px] w-[18px]\" data-kid=\"1-1-1-5-2-1\" data-lucide=\"dumbbell\">\n                    </i>\n                </span>\n            </div>\n        </div>\n        <div class=\"space-y-4 p-4\" data-kid=\"1-1-2\">\n            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-1\">\n                <div data-kid=\"1-1-2-1-1\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[.18em] text-[var(--text-tertiary)]\" data-kid=\"1-1-2-1-1-1\">\n                        Prepará tu serie\n                    </p>\n                    <p aria-live=\"polite\" class=\"mt-1 text-[12px] font-medium text-[var(--text-secondary)]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2\" data-name=\"status label text\" data-reason=\"text replaced by script on click\" id=\"statusText\">\n                        Todo listo para empezar\n                    </p>\n                </div>\n                <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[var(--primary)]/25 bg-[var(--primary)]/10 px-2.5 py-1.5 text-[10px] font-bold text-[var(--primary)]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2\" data-name=\"ready status badge container\" data-reason=\"content replaced by script on click\" id=\"readyBadge\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--primary)]\" data-kid=\"1-1-2-1-2-1\">\n                    </span>\n                    LISTO\n                </span>\n            </div>\n            <div class=\"grid grid-cols-[1fr_112px] gap-2.5\" data-kid=\"1-1-2-2\">\n                <div class=\"rounded-2xl border border-[var(--border)] bg-[#171a0e] p-3.5\" data-kid=\"1-1-2-2-1\">\n                    <div class=\"grid grid-cols-2 gap-x-3 gap-y-4\" data-kid=\"1-1-2-2-1-1\">\n                        <div data-kid=\"1-1-2-2-1-1-1\">\n                            <p class=\"text-[9px] font-bold uppercase tracking-[.14em] text-[var(--text-tertiary)]\" data-kid=\"1-1-2-2-1-1-1-1\">\n                                Series\n                            </p>\n                            <p class=\"metric-value mt-1 text-[22px] font-black tracking-[-.04em] text-[var(--text)]\" data-kid=\"1-1-2-2-1-1-1-2\">\n                                4\n                            </p>\n                        </div>\n                        <div data-kid=\"1-1-2-2-1-1-2\">\n                            <p class=\"text-[9px] font-bold uppercase tracking-[.14em] text-[var(--text-tertiary)]\" data-kid=\"1-1-2-2-1-1-2-1\">\n                                Reps\n                            </p>\n                            <p class=\"metric-value mt-1 text-[22px] font-black tracking-[-.04em] text-[var(--text)]\" data-kid=\"1-1-2-2-1-1-2-2\">\n                                12\n                            </p>\n                        </div>\n                        <div class=\"col-span-2 flex items-end justify-between border-t border-[var(--border)] pt-3\" data-kid=\"1-1-2-2-1-1-3\">\n                            <div data-kid=\"1-1-2-2-1-1-3-1\">\n                                <p class=\"text-[9px] font-bold uppercase tracking-[.14em] text-[var(--text-tertiary)]\" data-kid=\"1-1-2-2-1-1-3-1-1\">\n                                    Descanso\n                                </p>\n                                <p class=\"metric-value mt-1 text-[17px] font-extrabold tracking-[-.03em] text-[var(--text-secondary)]\" data-kid=\"1-1-2-2-1-1-3-1-2\">\n                                    90\n                                    <span class=\"ml-0.5 text-[11px] font-bold text-[var(--text-tertiary)]\" data-kid=\"1-1-2-2-1-1-3-1-2-1\">\n                                        s\n                                    </span>\n                                </p>\n                            </div>\n                            <i aria-hidden=\"true\" class=\"mb-0.5 h-4 w-4 text-[var(--text-tertiary)]\" data-kid=\"1-1-2-2-1-1-3-2\" data-lucide=\"timer-reset\">\n                            </i>\n                        </div>\n                    </div>\n                </div>\n                <button aria-label=\"Editar peso, actualmente sin peso\" class=\"pressable group min-h-[112px] rounded-2xl border border-[var(--border-strong)] bg-[var(--primary)]/[.07] p-3 text-left\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2\" data-name=\"weight control container button\" data-reason=\"aria-label updated by script\" id=\"weightControl\" type=\"button\">\n                    <span class=\"flex items-center justify-between gap-2\" data-kid=\"1-1-2-2-2-1\">\n                        <span class=\"text-[9px] font-bold uppercase tracking-[.14em] text-[var(--text-secondary)]\" data-kid=\"1-1-2-2-2-1-1\">\n                            Peso\n                        </span>\n                        <i aria-hidden=\"true\" class=\"h-3.5 w-3.5 text-[var(--primary)]\" data-kid=\"1-1-2-2-2-1-2\" data-lucide=\"pencil\">\n                        </i>\n                    </span>\n                    <span class=\"weight-readout mt-5 block\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-2\" data-name=\"weight readout container\" data-reason=\"hidden attribute toggled by script\" id=\"weightReadout\">\n                        <span class=\"metric-value text-[20px] font-black tracking-[-.04em] text-[var(--text)]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"weight metric value\" data-reason=\"text replaced by input value script\">\n                            —\n                        </span>\n                        <span class=\"ml-1 text-[11px] font-bold text-[var(--text-tertiary)]\" data-kid=\"1-1-2-2-2-2-2\">\n                            kg\n                        </span>\n                    </span>\n                    <span class=\"mt-2 block text-[9px] font-semibold text-[var(--primary)]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-3\" data-name=\"weight saved instruction text\" data-reason=\"text replaced by script\" id=\"weightSaved\">\n                        Tocar para editar\n                    </span>\n                    <span class=\"weight-editor mt-3\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-4\" data-name=\"weight editor container\" data-reason=\"hidden attribute toggled by script\" hidden=\"\" id=\"weightEditor\">\n                        <span class=\"flex items-center gap-1.5\" data-kid=\"1-1-2-2-2-4-1\">\n                            <input aria-label=\"Peso en kilogramos\" class=\"h-8 min-w-0 flex-1 rounded-lg border border-[var(--primary)]/60 bg-[#111508] px-2 text-[13px] font-extrabold text-[var(--text)] placeholder:text-[var(--text-tertiary)]\" data-kid=\"1-1-2-2-2-4-1-1\" id=\"weightInput\" inputmode=\"decimal\" placeholder=\"—\" type=\"text\"/>\n                            <span class=\"text-[10px] font-bold text-[var(--text-tertiary)]\" data-kid=\"1-1-2-2-2-4-1-2\">\n                                kg\n                            </span>\n                        </span>\n                        <span class=\"mt-2 flex items-center gap-2\" data-kid=\"1-1-2-2-2-4-2\">\n                            <button class=\"rounded-md bg-[var(--primary)] px-2 py-1 text-[9px] font-extrabold uppercase tracking-[.08em] text-[#111508]\" data-kid=\"1-1-2-2-2-4-2-1\" id=\"saveWeight\" type=\"button\">\n                                Guardar\n                            </button>\n                            <button class=\"rounded-md px-1 py-1 text-[9px] font-bold text-[var(--text-tertiary)]\" data-kid=\"1-1-2-2-2-4-2-2\" id=\"cancelWeight\" type=\"button\">\n                                Cancelar\n                            </button>\n                        </span>\n                    </span>\n                </button>\n            </div>\n            <div class=\"space-y-2.5 border-t border-[var(--border)] pt-4\" data-kid=\"1-1-2-3\">\n                <button aria-label=\"Iniciar serie de Press banca plana\" class=\"pressable cta-active flex min-h-[50px] w-full items-center justify-center gap-2 rounded-2xl bg-[var(--primary)] px-4 text-[14px] font-black tracking-[-.01em] text-[#111508] shadow-sm\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1\" data-name=\"start activity button\" data-reason=\"aria-label and style classes toggled by script\" id=\"startButton\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"h-4 w-4 fill-current\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1-1\" data-lucide=\"play\" data-name=\"play or pause icon\" data-reason=\"data-lucide attribute updated by script\" id=\"startIcon\">\n                    </i>\n                    <span data-dynamic=\"true\" data-kid=\"1-1-2-3-1-2\" data-name=\"start button text\" data-reason=\"text replaced by script on click\" id=\"startLabel\">\n                        Iniciar serie\n                    </span>\n                </button>\n                <button aria-label=\"Ver técnica antes de empezar\" class=\"pressable mx-auto flex items-center justify-center gap-1.5 rounded-lg px-3 py-2 text-[11px] font-semibold text-[var(--text-secondary)] hover:text-[var(--primary)]\" data-kid=\"1-1-2-3-2\" id=\"tutorialButton\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"h-3.5 w-3.5\" data-kid=\"1-1-2-3-2-1\" data-lucide=\"scan-line\">\n                    </i>\n                    <span data-kid=\"1-1-2-3-2-2\">\n                        Ver técnica antes de empezar\n                    </span>\n                </button>\n                <p aria-live=\"polite\" class=\"min-h-3 text-center text-[9px] font-semibold text-[var(--primary)]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-3\" data-name=\"tutorial status message\" data-reason=\"text injected by script on click\" id=\"tutorialStatus\">\n                </p>\n            </div>\n        </div>\n    </article>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n\n  const startButton = document.getElementById('startButton');\n  const startLabel = document.getElementById('startLabel');\n  const startIcon = document.getElementById('startIcon');\n  const statusText = document.getElementById('statusText');\n  const readyBadge = document.getElementById('readyBadge');\n  const weightControl = document.getElementById('weightControl');\n  const weightReadout = document.getElementById('weightReadout');\n  const weightEditor = document.getElementById('weightEditor');\n  const weightSaved = document.getElementById('weightSaved');\n  const weightInput = document.getElementById('weightInput');\n  const saveWeight = document.getElementById('saveWeight');\n  const cancelWeight = document.getElementById('cancelWeight');\n  const tutorialButton = document.getElementById('tutorialButton');\n  const tutorialStatus = document.getElementById('tutorialStatus');\n  let active = false;\n\n  startButton.addEventListener('click', () => {\n    active = !active;\n    startLabel.textContent = active ? 'Serie activa' : 'Iniciar serie';\n    startIcon.setAttribute('data-lucide', active ? 'pause' : 'play');\n    statusText.textContent = active ? 'Registrando tu serie ahora' : 'Todo listo para empezar';\n    readyBadge.innerHTML = active ? '<span class=\"h-1.5 w-1.5 rounded-full bg-[#111508]\"></span> EN CURSO' : '<span class=\"h-1.5 w-1.5 rounded-full bg-[var(--primary)]\"></span> LISTO';\n    startButton.classList.toggle('bg-[var(--primary-dim)]', active);\n    startButton.classList.toggle('cta-active', active);\n    startButton.setAttribute('aria-label', active ? 'Serie activa, pausar registro' : 'Iniciar serie de Press banca plana');\n    lucide.createIcons();\n  });\n\n  function openWeightEditor() {\n    weightReadout.hidden = true;\n    weightSaved.hidden = true;\n    weightEditor.hidden = false;\n    weightControl.setAttribute('aria-label', 'Editar peso en kilogramos');\n    setTimeout(() => weightInput.focus(), 0);\n  }\n  function closeWeightEditor() {\n    weightReadout.hidden = false;\n    weightSaved.hidden = false;\n    weightEditor.hidden = true;\n    weightControl.setAttribute('aria-label', 'Editar peso, actualmente sin peso');\n  }\n  weightControl.addEventListener('click', (event) => {\n    if (event.target.closest('#saveWeight') || event.target.closest('#cancelWeight')) return;\n    if (weightEditor.hidden) openWeightEditor();\n  });\n  saveWeight.addEventListener('click', (event) => {\n    event.stopPropagation();\n    const value = weightInput.value.trim();\n    weightReadout.querySelector('.metric-value').textContent = value || '—';\n    weightSaved.textContent = value ? 'Guardado' : 'Tocar para editar';\n    closeWeightEditor();\n  });\n  cancelWeight.addEventListener('click', (event) => {\n    event.stopPropagation();\n    closeWeightEditor();\n  });\n  tutorialButton.addEventListener('click', () => {\n    tutorialStatus.textContent = 'Técnica: escápulas atrás y pies firmes.';\n  });\n</script>\n",
      "comments": [],
      "created": "2026-07-23T16:48:58.852736+00:00",
      "modified": "2026-07-23T16:49:27.586320+00:00",
      "id": "var_1976195d6783"
    },
    "var_dd721ae4be69": {
      "type": "variant",
      "label": "Redesign — Set Console",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1425,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  .set-console-canvas,\n  .set-console-canvas * { box-sizing: border-box; }\n\n  .set-console-canvas {\n    --onyx: #111111;\n    --ink: #0c0f04;\n    --olive: #1e2113;\n    --olive-deep: #171a0f;\n    --panel: #24281a;\n    --line: rgba(226, 228, 207, .13);\n    --warm: #e2e4cf;\n    --muted: #8e9379;\n    --lime: #c3f400;\n    --lime-soft: rgba(195, 244, 0, .12);\n    --orange: #ff8b4a;\n    min-height: 812px;\n    padding: 20px 16px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background:\n      radial-gradient(circle at 85% 18%, rgba(195, 244, 0, .06), transparent 30%),\n      linear-gradient(145deg, #0c0f04 0%, #111508 62%, #090b04 100%);\n    color: var(--warm);\n    font-family: 'Inter', sans-serif;\n  }\n\n  .console-shell {\n    position: relative;\n    width: min(100%, 343px);\n    min-height: 708px;\n    padding: 22px 20px 18px;\n    overflow: hidden;\n    border: 1px solid rgba(226, 228, 207, .14);\n    border-radius: 32px 18px 28px 18px;\n    background:\n      linear-gradient(135deg, rgba(255,255,255,.025), transparent 38%),\n      linear-gradient(180deg, rgba(30, 33, 19, .98), rgba(12, 15, 4, .98));\n    box-shadow:\n      0 30px 70px rgba(0,0,0,.62),\n      0 12px 28px rgba(0,0,0,.35),\n      inset 0 1px 0 rgba(255,255,255,.05),\n      inset 12px 0 0 rgba(195,244,0,.025);\n  }\n\n  .console-shell::before {\n    content: '';\n    position: absolute;\n    inset: 0 auto 0 0;\n    width: 3px;\n    background: linear-gradient(180deg, var(--lime) 0 21%, transparent 53% 100%);\n    box-shadow: 0 0 18px rgba(195,244,0,.42);\n  }\n\n  .console-shell::after {\n    content: '';\n    position: absolute;\n    right: -46px;\n    top: 310px;\n    width: 170px;\n    height: 170px;\n    border: 1px solid rgba(195,244,0,.09);\n    border-radius: 50%;\n    pointer-events: none;\n  }\n\n  .console-topline {\n    position: relative;\n    z-index: 2;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 28px;\n  }\n\n  .eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    color: var(--lime);\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .eyebrow-mark {\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: var(--lime);\n    box-shadow: 0 0 11px rgba(195,244,0,.8);\n  }\n\n  .exercise-index {\n    color: var(--muted);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .12em;\n  }\n\n  .technique-orb {\n    position: absolute;\n    z-index: 3;\n    top: 52px;\n    right: 22px;\n    width: 42px;\n    height: 42px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid rgba(195,244,0,.4);\n    border-radius: 50%;\n    color: var(--lime);\n    background: rgba(12,15,4,.72);\n    box-shadow: 0 10px 24px rgba(0,0,0,.35), inset 0 0 0 5px rgba(195,244,0,.04);\n    cursor: pointer;\n    font-size: 18px;\n  }\n\n  .technique-orb:focus-visible,\n  .step-control:focus-visible,\n  .segment:focus-visible,\n  .weight-action:focus-visible,\n  .save-button:focus-visible,\n  .technique-button:focus-visible {\n    outline: 2px solid var(--lime);\n    outline-offset: 3px;\n  }\n\n  .hero-photo {\n    position: absolute;\n    z-index: 1;\n    top: 35px;\n    right: 6px;\n    width: 132px;\n    height: 132px;\n    overflow: hidden;\n    border: 1px solid rgba(226,228,207,.26);\n    border-radius: 52% 48% 58% 42%;\n    transform: rotate(7deg);\n    box-shadow: 0 22px 35px rgba(0,0,0,.52), 0 0 0 8px rgba(195,244,0,.035);\n    background: var(--onyx);\n  }\n\n  .hero-photo img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: center;\n    filter: grayscale(.88) contrast(1.15) brightness(.72);\n    transform: rotate(-7deg) scale(1.15);\n  }\n\n  .hero-photo::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(145deg, rgba(195,244,0,.1), transparent 45%, rgba(12,15,4,.46));\n    pointer-events: none;\n  }\n\n  .hero-copy {\n    position: relative;\n    z-index: 2;\n    width: 73%;\n    min-height: 155px;\n    padding-top: 24px;\n  }\n\n  .hero-kicker {\n    margin: 0 0 11px;\n    color: var(--muted);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .13em;\n    text-transform: uppercase;\n  }\n\n  .exercise-title {\n    max-width: 245px;\n    margin: 0;\n    color: var(--warm);\n    font-family: 'Outfit', sans-serif;\n    font-size: 38px;\n    font-weight: 800;\n    letter-spacing: -.065em;\n    line-height: .94;\n    text-wrap: balance;\n    text-shadow: 0 9px 20px rgba(0,0,0,.55);\n  }\n\n  .exercise-subtitle {\n    margin: 15px 0 0;\n    color: var(--muted);\n    font-size: 12px;\n    font-weight: 500;\n  }\n\n  .exercise-subtitle strong { color: var(--warm); font-weight: 700; }\n\n  .prescription {\n    position: relative;\n    z-index: 2;\n    margin: 3px -2px 0;\n    padding: 17px 0 16px;\n    border-top: 1px solid var(--line);\n    border-bottom: 1px solid var(--line);\n  }\n\n  .prescription-label {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 12px;\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .prescription-label span:last-child { color: var(--warm); letter-spacing: .06em; }\n\n  .timeline {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 4px;\n    height: 17px;\n    align-items: end;\n  }\n\n  .segment {\n    position: relative;\n    height: 8px;\n    border: 0;\n    border-radius: 2px 8px 2px 2px;\n    background: rgba(226,228,207,.12);\n    cursor: pointer;\n  }\n\n  .segment.is-active { background: var(--lime); box-shadow: 0 0 13px rgba(195,244,0,.42); }\n  .segment.is-complete { background: rgba(195,244,0,.34); }\n  .segment::after {\n    content: attr(data-step);\n    position: absolute;\n    top: 15px;\n    left: 0;\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 700;\n  }\n  .segment.is-active::after { color: var(--lime); }\n\n  .prescription-stats {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 0;\n    margin-top: 25px;\n  }\n\n  .prescription-stat { border-right: 1px solid var(--line); padding-right: 12px; }\n  .prescription-stat + .prescription-stat { padding-left: 12px; }\n  .prescription-stat:last-child { border-right: 0; }\n  .stat-value { display: block; color: var(--warm); font-family: 'Outfit', sans-serif; font-size: 22px; font-weight: 700; letter-spacing: -.045em; }\n  .stat-label { display: block; margin-top: 2px; color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: .12em; }\n\n  .console-panel {\n    position: relative;\n    z-index: 2;\n    margin-top: 18px;\n    padding: 14px;\n    border: 1px solid rgba(226,228,207,.11);\n    border-radius: 22px 10px 18px 10px;\n    background: linear-gradient(150deg, rgba(36,40,26,.78), rgba(23,26,15,.62));\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.04), inset 0 9px 18px rgba(0,0,0,.15);\n  }\n\n  .panel-heading {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin: 0 0 11px;\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .panel-heading span:last-child { color: var(--lime); letter-spacing: .06em; }\n\n  .reps-console {\n    display: grid;\n    grid-template-columns: 48px 1fr 48px;\n    align-items: center;\n    gap: 8px;\n    min-height: 91px;\n    padding: 7px;\n    border: 1px solid rgba(195,244,0,.2);\n    border-radius: 16px 8px 14px 8px;\n    background: rgba(12,15,4,.55);\n  }\n\n  .step-control {\n    width: 48px;\n    height: 48px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid rgba(226,228,207,.13);\n    border-radius: 12px 6px 10px 6px;\n    color: var(--warm);\n    background: rgba(226,228,207,.055);\n    cursor: pointer;\n    font-size: 18px;\n  }\n  .step-control:hover { color: var(--lime); background: var(--lime-soft); }\n\n  .rep-value-wrap { text-align: center; }\n  .rep-value {\n    display: block;\n    color: var(--lime);\n    font-family: 'Outfit', sans-serif;\n    font-size: 49px;\n    font-weight: 700;\n    letter-spacing: -.08em;\n    line-height: .82;\n  }\n  .rep-caption { display: block; margin-top: 8px; color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: .13em; }\n\n  .weight-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    min-height: 56px;\n    margin-top: 8px;\n    padding: 0 5px 0 10px;\n    border-top: 1px solid var(--line);\n  }\n  .weight-copy { display: flex; align-items: baseline; gap: 9px; }\n  .weight-label { color: var(--muted); font-size: 9px; font-weight: 800; letter-spacing: .16em; }\n  .weight-value { color: var(--warm); font-family: 'Outfit', sans-serif; font-size: 22px; font-weight: 700; letter-spacing: -.04em; }\n  .weight-value.is-empty { color: var(--orange); }\n  .weight-action {\n    min-height: 42px;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    padding: 0 12px;\n    border: 1px solid rgba(195,244,0,.34);\n    border-radius: 11px 6px 9px 6px;\n    color: var(--lime);\n    background: rgba(195,244,0,.06);\n    cursor: pointer;\n    font-family: 'Inter', sans-serif;\n    font-size: 10px;\n    font-weight: 800;\n  }\n  .weight-action:hover { background: var(--lime-soft); }\n\n  .weight-editor {\n    display: none;\n    grid-template-columns: 1fr auto;\n    gap: 8px;\n    align-items: center;\n    margin-top: 8px;\n  }\n  .weight-editor.is-open { display: grid; }\n  .weight-input {\n    width: 100%;\n    height: 42px;\n    padding: 0 11px;\n    border: 1px solid rgba(195,244,0,.44);\n    border-radius: 10px 6px 8px 6px;\n    color: var(--warm);\n    background: rgba(12,15,4,.76);\n    font: 700 15px 'Inter', sans-serif;\n  }\n  .weight-input:focus { outline: 2px solid var(--lime); outline-offset: 2px; }\n  .weight-save { height: 42px; padding: 0 12px; border: 0; border-radius: 10px 5px 8px 5px; color: var(--ink); background: var(--lime); font: 800 10px 'Inter', sans-serif; cursor: pointer; }\n\n  .action-rail {\n    position: relative;\n    z-index: 2;\n    display: grid;\n    grid-template-columns: 1fr 49px;\n    gap: 9px;\n    margin-top: 17px;\n  }\n\n  .save-button,\n  .technique-button {\n    min-height: 51px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    font-family: 'Inter', sans-serif;\n    font-weight: 800;\n  }\n  .save-button {\n    gap: 9px;\n    border: 1px solid var(--lime);\n    border-radius: 15px 7px 12px 7px;\n    color: var(--ink);\n    background: var(--lime);\n    box-shadow: 0 12px 22px rgba(195,244,0,.16), inset 0 1px 0 rgba(255,255,255,.35);\n    font-size: 12px;\n  }\n  .technique-button {\n    border: 1px solid rgba(226,228,207,.2);\n    border-radius: 12px 7px 12px 7px;\n    color: var(--warm);\n    background: rgba(226,228,207,.045);\n    font-size: 17px;\n  }\n  .technique-button:hover { color: var(--lime); border-color: rgba(195,244,0,.5); }\n\n  .status-line {\n    min-height: 15px;\n    margin-top: 10px;\n    color: var(--muted);\n    font-size: 10px;\n    line-height: 1.4;\n    text-align: center;\n  }\n\n  .console-footer {\n    position: absolute;\n    right: 20px;\n    bottom: 12px;\n    color: rgba(142,147,121,.54);\n    font-size: 8px;\n    font-weight: 700;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n  }\n</style>\n<div class=\"set-console-canvas\" data-kid=\"1\">\n    <article aria-label=\"Registro de ejercicio Press banca plana\" class=\"console-shell\" data-kid=\"1-1\">\n        <div class=\"console-topline\" data-kid=\"1-1-1\">\n            <div class=\"eyebrow\" data-kid=\"1-1-1-1\">\n                <span aria-hidden=\"true\" class=\"eyebrow-mark\" data-kid=\"1-1-1-1-1\">\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"section category text\">\n                    PECHO / TREN SUPERIOR\n                </span>\n            </div>\n            <span aria-label=\"Ejercicio 1 de 6\" class=\"exercise-index\" data-kid=\"1-1-1-2\" data-name=\"exercise index label\">\n                01 / 06\n            </span>\n        </div>\n        <button aria-label=\"Abrir guía de técnica\" class=\"technique-orb\" data-action=\"technique\" data-kid=\"1-1-2\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"ti ti-player-play-filled\" data-kid=\"1-1-2-1\">\n            </i>\n        </button>\n        <figure class=\"hero-photo\" data-kid=\"1-1-3\">\n            <img alt=\"Atleta realizando press banca — foto de Tima Miroshnichenko, Pexels\" data-kid=\"1-1-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/5327556/pexels-photo-5327556.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n        </figure>\n        <div class=\"hero-copy\" data-kid=\"1-1-4\">\n            <p class=\"hero-kicker\" data-kid=\"1-1-4-1\" data-name=\"exercise type kicker text\">\n                Fuerza · tren superior\n            </p>\n            <h1 class=\"exercise-title\" data-kid=\"1-1-4-2\" data-name=\"exercise title\">\n                Press banca plana\n            </h1>\n            <p class=\"exercise-subtitle\" data-kid=\"1-1-4-3\" data-name=\"exercise intensity description\">\n                <strong data-kid=\"1-1-4-3-1\" data-name=\"exercise method highlight text\">\n                    Barra libre\n                </strong>\n                · controlado\n            </p>\n        </div>\n        <section aria-label=\"Prescripción del ejercicio\" class=\"prescription\" data-kid=\"1-1-5\">\n            <div class=\"prescription-label\" data-kid=\"1-1-5-1\">\n                <span data-kid=\"1-1-5-1-1\" data-name=\"prescription label\">\n                    Prescripción\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"1-1-5-1-2\" data-name=\"active set indicator text\" data-reason=\"text updated via JS when series is selected\">\n                    Serie activa 01\n                </span>\n            </div>\n            <div aria-label=\"Seleccionar serie\" class=\"timeline\" data-kid=\"1-1-5-2\" role=\"tablist\">\n                <button aria-label=\"Seleccionar serie 1\" aria-selected=\"true\" class=\"segment is-active\" data-kid=\"1-1-5-2-1\" data-step=\"01\" type=\"button\">\n                </button>\n                <button aria-label=\"Seleccionar serie 2\" aria-selected=\"false\" class=\"segment\" data-kid=\"1-1-5-2-2\" data-step=\"02\" type=\"button\">\n                </button>\n                <button aria-label=\"Seleccionar serie 3\" aria-selected=\"false\" class=\"segment\" data-kid=\"1-1-5-2-3\" data-step=\"03\" type=\"button\">\n                </button>\n                <button aria-label=\"Seleccionar serie 4\" aria-selected=\"false\" class=\"segment\" data-kid=\"1-1-5-2-4\" data-step=\"04\" type=\"button\">\n                </button>\n            </div>\n            <div class=\"prescription-stats\" data-kid=\"1-1-5-3\">\n                <div class=\"prescription-stat\" data-kid=\"1-1-5-3-1\">\n                    <span class=\"stat-value\" data-kid=\"1-1-5-3-1-1\" data-name=\"series count value\">\n                        4\n                    </span>\n                    <span class=\"stat-label\" data-kid=\"1-1-5-3-1-2\">\n                        Series\n                    </span>\n                </div>\n                <div class=\"prescription-stat\" data-kid=\"1-1-5-3-2\">\n                    <span class=\"stat-value\" data-kid=\"1-1-5-3-2-1\" data-name=\"repetitions goal value\">\n                        12\n                    </span>\n                    <span class=\"stat-label\" data-kid=\"1-1-5-3-2-2\">\n                        Reps\n                    </span>\n                </div>\n                <div class=\"prescription-stat\" data-kid=\"1-1-5-3-3\">\n                    <span class=\"stat-value\" data-kid=\"1-1-5-3-3-1\" data-name=\"rest duration value\">\n                        90 s\n                    </span>\n                    <span class=\"stat-label\" data-kid=\"1-1-5-3-3-2\">\n                        Rest\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Controles de la serie activa\" class=\"console-panel\" data-kid=\"1-1-6\">\n            <div class=\"panel-heading\" data-kid=\"1-1-6-1\">\n                <span data-kid=\"1-1-6-1-1\">\n                    Registro en vivo\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"1-1-6-1-2\" data-name=\"set state feedback text\" data-reason=\"text updated via JS based on user interaction\" id=\"set-state\">\n                    Listo para empezar\n                </span>\n            </div>\n            <div class=\"reps-console\" data-kid=\"1-1-6-2\">\n                <button aria-label=\"Reducir repeticiones\" class=\"step-control\" data-kid=\"1-1-6-2-1\" data-stepper=\"minus\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-minus\" data-kid=\"1-1-6-2-1-1\">\n                    </i>\n                </button>\n                <div aria-live=\"polite\" class=\"rep-value-wrap\" data-kid=\"1-1-6-2-2\">\n                    <span class=\"rep-value\" data-dynamic=\"true\" data-kid=\"1-1-6-2-2-1\" data-name=\"current repetition value\" data-reason=\"text updated via stepper controls\" id=\"rep-value\">\n                        12\n                    </span>\n                    <span class=\"rep-caption\" data-kid=\"1-1-6-2-2-2\">\n                        REPETICIONES\n                    </span>\n                </div>\n                <button aria-label=\"Aumentar repeticiones\" class=\"step-control\" data-kid=\"1-1-6-2-3\" data-stepper=\"plus\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-6-2-3-1\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"weight-row\" data-kid=\"1-1-6-3\">\n                <div class=\"weight-copy\" data-kid=\"1-1-6-3-1\">\n                    <span class=\"weight-label\" data-kid=\"1-1-6-3-1-1\">\n                        PESO\n                    </span>\n                    <span class=\"weight-value is-empty\" data-dynamic=\"true\" data-kid=\"1-1-6-3-1-2\" data-name=\"weight value display\" data-reason=\"text replaced with entered weight value\" id=\"weight-value\">\n                        — kg\n                    </span>\n                </div>\n                <button aria-label=\"Añadir peso\" class=\"weight-action\" data-action=\"weight\" data-kid=\"1-1-6-3-2\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-edit\" data-kid=\"1-1-6-3-2-1\">\n                    </i>\n                    <span data-kid=\"1-1-6-3-2-2\" data-name=\"add weight button text\">\n                        Añadir peso\n                    </span>\n                </button>\n            </div>\n            <div class=\"weight-editor\" data-kid=\"1-1-6-4\" id=\"weight-editor\">\n                <input aria-label=\"Peso en kilogramos\" class=\"weight-input\" data-kid=\"1-1-6-4-1\" id=\"weight-input\" inputmode=\"decimal\" min=\"0\" placeholder=\"Ej. 60\" step=\"0.5\" type=\"number\"/>\n                <button class=\"weight-save\" data-action=\"save-weight\" data-kid=\"1-1-6-4-2\" type=\"button\">\n                    Guardar\n                </button>\n            </div>\n        </section>\n        <div class=\"action-rail\" data-kid=\"1-1-7\">\n            <button class=\"save-button\" data-action=\"save-set\" data-kid=\"1-1-7-1\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-1-7-1-1\">\n                </i>\n                <span data-dynamic=\"true\" data-kid=\"1-1-7-1-2\" data-name=\"save set button text\" data-reason=\"text updated via JS after set is saved\">\n                    Guardar serie\n                </span>\n            </button>\n            <button aria-label=\"Ver técnica\" class=\"technique-button\" data-action=\"technique\" data-kid=\"1-1-7-2\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-player-play\" data-kid=\"1-1-7-2-1\">\n                </i>\n            </button>\n        </div>\n        <p aria-live=\"polite\" class=\"status-line\" data-dynamic=\"true\" data-kid=\"1-1-8\" data-name=\"status update message\" data-reason=\"text updated via JS to reflect current action state\" id=\"status-line\">\n            Ajustá tu carga antes de guardar la serie.\n        </p>\n        <span class=\"console-footer\" data-kid=\"1-1-9\" data-name=\"footer copyright text\">\n            set console / 01\n        </span>\n    </article>\n</div>\n<script type=\"module\">\n    import { animate } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n\n  const shell = document.querySelector('.console-shell');\n  const repValue = document.querySelector('#rep-value');\n  const weightValue = document.querySelector('#weight-value');\n  const weightEditor = document.querySelector('#weight-editor');\n  const weightInput = document.querySelector('#weight-input');\n  const statusLine = document.querySelector('#status-line');\n  const setState = document.querySelector('#set-state');\n  let reps = 12;\n\n  animate(shell, { opacity: [0, 1], transform: ['translateY(16px) scale(.985)', 'translateY(0) scale(1)'] }, { duration: .65, easing: [0.22, 1, 0.36, 1] });\n  animate('.hero-photo', { opacity: [0, 1], transform: ['rotate(1deg) scale(.9)', 'rotate(7deg) scale(1)'] }, { duration: .8, delay: .12, easing: [0.22, 1, 0.36, 1] });\n  animate('.console-shell::before', { opacity: [0, 1] }, { duration: .55 });\n\n  function setStatus(message, color) {\n    statusLine.textContent = message;\n    statusLine.style.color = color || 'var(--muted)';\n  }\n\n  function pulse(element) {\n    animate(element, { transform: ['scale(1)', 'scale(.92)', 'scale(1)'] }, { duration: .24, easing: 'ease-out' });\n  }\n\n  document.querySelectorAll('[data-stepper]').forEach((button) => {\n    button.addEventListener('click', () => {\n      reps = button.dataset.stepper === 'plus' ? Math.min(40, reps + 1) : Math.max(1, reps - 1);\n      animate(repValue, { opacity: [0, 1], transform: ['translateY(5px)', 'translateY(0)'] }, { duration: .22, easing: 'ease-out' });\n      repValue.textContent = reps;\n      setState.textContent = 'Cambio sin guardar';\n      setStatus(`${reps} repeticiones preparadas para esta serie.`);\n      pulse(button);\n    });\n  });\n\n  document.querySelectorAll('.segment').forEach((segment) => {\n    segment.addEventListener('click', () => {\n      document.querySelectorAll('.segment').forEach((item) => {\n        item.classList.remove('is-active');\n        item.setAttribute('aria-selected', 'false');\n      });\n      segment.classList.add('is-active');\n      segment.setAttribute('aria-selected', 'true');\n      setState.textContent = `Serie ${segment.dataset.step} seleccionada`;\n      setStatus(`Registro listo para la serie ${segment.dataset.step}.`);\n      pulse(segment);\n    });\n  });\n\n  document.querySelectorAll('[data-action=\"weight\"]').forEach((button) => {\n    button.addEventListener('click', () => {\n      weightEditor.classList.toggle('is-open');\n      if (weightEditor.classList.contains('is-open')) {\n        weightInput.focus();\n        setStatus('Ingresá tu carga en kilogramos.');\n      }\n      pulse(button);\n    });\n  });\n\n  document.querySelector('[data-action=\"save-weight\"]').addEventListener('click', () => {\n    const value = Number(weightInput.value);\n    if (!value || value < 0) {\n      setStatus('Ingresá un peso válido para continuar.', 'var(--orange)');\n      weightInput.focus();\n      return;\n    }\n    weightValue.textContent = `${value} kg`;\n    weightValue.classList.remove('is-empty');\n    weightEditor.classList.remove('is-open');\n    setState.textContent = 'Carga actualizada';\n    setStatus(`Peso guardado: ${value} kg.`);\n  });\n\n  document.querySelectorAll('[data-action=\"technique\"]').forEach((button) => {\n    button.addEventListener('click', () => {\n      setStatus('Guía de técnica lista: escápulas atrás, pies firmes.', 'var(--lime)');\n      pulse(button);\n    });\n  });\n\n  document.querySelector('[data-action=\"save-set\"]').addEventListener('click', (event) => {\n    if (weightValue.classList.contains('is-empty')) {\n      setStatus('Añadí un peso antes de guardar la serie.', 'var(--orange)');\n      animate(event.currentTarget, { x: [0, -4, 4, 0] }, { duration: .28, easing: 'ease-out' });\n      return;\n    }\n    setState.textContent = 'Serie guardada';\n    event.currentTarget.querySelector('span').textContent = 'Serie guardada';\n    setStatus('Buen trabajo. Serie registrada correctamente.', 'var(--lime)');\n    animate(event.currentTarget, { scale: [1, .97, 1] }, { duration: .3, easing: 'ease-out' });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-07-23T17:01:52.466454+00:00",
      "modified": "2026-07-23T17:02:27.326623+00:00",
      "id": "var_dd721ae4be69"
    },
    "var_27a24b54c67b": {
      "type": "variant",
      "label": "Redesign — Immersive Athlete",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1900,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700;800&family=Work+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .athlete-stage {\n    --bg: #111508;\n    --onyx: #111111;\n    --olive: #1e2113;\n    --olive-soft: #282b1d;\n    --olive-low: #1a1d10;\n    --line: rgba(226, 228, 207, .14);\n    --line-strong: rgba(195, 244, 0, .38);\n    --text: #e2e4cf;\n    --muted: #8e9379;\n    --primary: #c3f400;\n    --primary-ink: #111508;\n    min-height: 812px;\n    background: radial-gradient(circle at 50% 8%, rgba(195,244,0,.06), transparent 34%), var(--bg);\n    color: var(--text);\n    font-family: 'Work Sans', sans-serif;\n    display: flex;\n    align-items: flex-start;\n    justify-content: center;\n    padding: 32px 16px;\n    box-sizing: border-box;\n  }\n\n  .athlete-card {\n    position: relative;\n    width: min(100%, 343px);\n    min-height: 684px;\n    overflow: hidden;\n    border: 1px solid rgba(226, 228, 207, .15);\n    border-radius: 30px;\n    background: var(--olive);\n    box-shadow: 0 30px 80px rgba(0,0,0,.58), 0 8px 22px rgba(0,0,0,.42), inset 0 1px 0 rgba(255,255,255,.06);\n    isolation: isolate;\n  }\n\n  .athlete-image {\n    position: absolute;\n    inset: 0 0 auto 0;\n    width: 100%;\n    height: 405px;\n    object-fit: cover;\n    object-position: 52% 34%;\n    filter: grayscale(1) contrast(1.08) brightness(.72);\n    z-index: -3;\n  }\n\n  .athlete-wash {\n    position: absolute;\n    inset: 0 0 auto 0;\n    height: 438px;\n    background: linear-gradient(180deg, rgba(17,17,17,.08) 8%, rgba(17,17,17,.16) 34%, rgba(17,21,8,.52) 66%, #1e2113 100%);\n    z-index: -2;\n  }\n\n  .athlete-grain {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    opacity: .13;\n    background-image: radial-gradient(rgba(255,255,255,.22) .55px, transparent .7px);\n    background-size: 5px 5px;\n    mix-blend-mode: soft-light;\n    z-index: -1;\n  }\n\n  .athlete-content {\n    position: relative;\n    z-index: 1;\n    min-height: 684px;\n    display: flex;\n    flex-direction: column;\n    padding: 18px 18px 16px;\n    box-sizing: border-box;\n  }\n\n  .athlete-topline {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n\n  .athlete-chip {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    min-height: 30px;\n    padding: 0 11px 0 9px;\n    border: 1px solid rgba(195,244,0,.48);\n    border-radius: 999px;\n    background: rgba(17,21,8,.68);\n    color: var(--primary);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    backdrop-filter: blur(12px);\n  }\n\n  .athlete-chip i { font-size: 14px; }\n\n  .athlete-play {\n    width: 42px;\n    height: 42px;\n    border: 1px solid rgba(226,228,207,.32);\n    border-radius: 999px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--text);\n    background: rgba(17,17,17,.55);\n    backdrop-filter: blur(12px);\n    cursor: pointer;\n  }\n\n  .athlete-play i { font-size: 17px; margin-left: 2px; }\n\n  .athlete-identity {\n    margin-top: auto;\n    padding-top: 156px;\n  }\n\n  .athlete-kicker {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    color: rgba(226,228,207,.72);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .17em;\n    text-transform: uppercase;\n  }\n\n  .athlete-kicker::before {\n    content: '';\n    width: 26px;\n    height: 2px;\n    border-radius: 99px;\n    background: var(--primary);\n  }\n\n  .athlete-title {\n    max-width: 294px;\n    margin: 7px 0 0;\n    color: var(--text);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 42px;\n    font-weight: 700;\n    letter-spacing: .015em;\n    line-height: .91;\n    text-wrap: balance;\n    text-shadow: 0 3px 24px rgba(0,0,0,.58);\n  }\n\n  .athlete-subtitle {\n    margin: 10px 0 0;\n    color: rgba(226,228,207,.7);\n    font-size: 12px;\n    font-weight: 500;\n    letter-spacing: .01em;\n  }\n\n  .athlete-ribbon {\n    display: grid;\n    grid-template-columns: 1fr auto 1fr auto 1fr;\n    align-items: center;\n    gap: 10px;\n    margin-top: 20px;\n    padding: 13px 0 16px;\n    border-top: 1px solid rgba(226,228,207,.16);\n    border-bottom: 1px solid rgba(226,228,207,.16);\n  }\n\n  .athlete-stat { min-width: 0; }\n\n  .athlete-stat-label {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .13em;\n    line-height: 1.1;\n  }\n\n  .athlete-stat-label i { color: rgba(226,228,207,.56); font-size: 13px; }\n\n  .athlete-stat-value {\n    margin-top: 5px;\n    color: var(--text);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 23px;\n    font-weight: 600;\n    letter-spacing: .06em;\n    line-height: .9;\n  }\n\n  .athlete-stat-value span {\n    color: var(--muted);\n    font-family: 'Work Sans', sans-serif;\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .athlete-rule { width: 1px; height: 30px; background: var(--line); }\n\n  .athlete-log {\n    margin-top: 18px;\n    padding: 16px;\n    border: 1px solid rgba(226,228,207,.12);\n    border-radius: 20px;\n    background: linear-gradient(145deg, rgba(40,43,29,.84), rgba(17,21,8,.72));\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.06), inset 0 -10px 24px rgba(0,0,0,.14);\n  }\n\n  .athlete-log-heading {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    color: var(--muted);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  .athlete-series-count { color: var(--text); letter-spacing: .08em; }\n  .athlete-series-count strong { color: var(--primary); font-weight: 700; }\n\n  .athlete-progress {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 5px;\n    margin-top: 11px;\n  }\n\n  .athlete-progress span { height: 3px; border-radius: 99px; background: rgba(226,228,207,.14); }\n  .athlete-progress span:first-child { background: var(--primary); box-shadow: 0 0 10px rgba(195,244,0,.44); }\n\n  .athlete-controls {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 12px;\n    margin-top: 18px;\n  }\n\n  .athlete-control {\n    min-width: 0;\n    padding: 12px 11px 11px;\n    border: 1px solid rgba(226,228,207,.13);\n    border-radius: 15px;\n    background: rgba(17,17,17,.26);\n  }\n\n  .athlete-control[data-kind='weight'] { border-color: var(--line-strong); background: rgba(195,244,0,.055); }\n\n  .athlete-control-label {\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n  }\n\n  .athlete-stepper {\n    display: grid;\n    grid-template-columns: 44px 1fr 44px;\n    align-items: center;\n    gap: 4px;\n    margin-top: 10px;\n  }\n\n  .athlete-stepper button {\n    width: 44px;\n    height: 44px;\n    border: 1px solid rgba(226,228,207,.16);\n    border-radius: 12px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--text);\n    background: rgba(51,54,39,.75);\n    cursor: pointer;\n  }\n\n  .athlete-stepper button i { font-size: 17px; }\n  .athlete-stepper button:hover { border-color: rgba(195,244,0,.68); color: var(--primary); }\n  .athlete-stepper button:active { background: rgba(195,244,0,.18); }\n\n  .athlete-number {\n    display: block;\n    width: 100%;\n    color: var(--text);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 29px;\n    font-weight: 600;\n    letter-spacing: .05em;\n    line-height: 1;\n    text-align: center;\n  }\n\n  [data-kind='weight'] .athlete-number { color: var(--primary); }\n  .athlete-unit { color: var(--muted); font-family: 'Work Sans', sans-serif; font-size: 9px; font-weight: 700; letter-spacing: .08em; }\n\n  .athlete-helper {\n    min-height: 13px;\n    margin-top: 9px;\n    color: rgba(226,228,207,.58);\n    font-size: 10px;\n    font-weight: 500;\n    line-height: 1.25;\n  }\n\n  .athlete-save {\n    width: 100%;\n    min-height: 48px;\n    margin-top: 14px;\n    border: 0;\n    border-radius: 14px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    color: var(--primary-ink);\n    background: var(--primary);\n    box-shadow: 0 10px 24px rgba(195,244,0,.16), inset 0 1px 0 rgba(255,255,255,.38);\n    font-family: 'Work Sans', sans-serif;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: .02em;\n    cursor: pointer;\n  }\n\n  .athlete-save i { font-size: 16px; }\n  .athlete-save:hover { filter: brightness(1.08); }\n  .athlete-save:active { box-shadow: inset 0 3px 8px rgba(17,21,8,.28); }\n\n  .athlete-status {\n    min-height: 18px;\n    margin: 10px 2px 0;\n    color: rgba(226,228,207,.64);\n    font-size: 10px;\n    font-weight: 500;\n    line-height: 1.35;\n    text-align: center;\n  }\n\n  button:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }\n</style>\n<div class=\"athlete-stage\" data-kid=\"1\" data-name=\"exercise tracking stage container\">\n    <article aria-label=\"Press banca plana, ejercicio de pecho\" class=\"athlete-card\" data-kid=\"1-1\" data-name=\"athlete exercise card\">\n        <img alt=\"Press banca en primer plano — foto de Daniel Gregoire, Unsplash\" class=\"athlete-image\" data-kid=\"1-1-1\" data-name=\"exercise reference image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1565475243813-f5f7d741177e?auto=format&w=900&q=80&fit=crop\"/>\n        <div aria-hidden=\"true\" class=\"athlete-wash\" data-kid=\"1-1-2\" data-name=\"card background visual wash\">\n        </div>\n        <div aria-hidden=\"true\" class=\"athlete-grain\" data-kid=\"1-1-3\" data-name=\"card background grain texture\">\n        </div>\n        <div class=\"athlete-content\" data-kid=\"1-1-4\" data-name=\"athlete exercise content container\">\n            <div class=\"athlete-topline\" data-kid=\"1-1-4-1\" data-name=\"card header row\">\n                <span class=\"athlete-chip\" data-kid=\"1-1-4-1-1\" data-name=\"exercise category chip\">\n                    <i aria-hidden=\"true\" class=\"ti ti-activity-heartbeat\" data-kid=\"1-1-4-1-1-1\" data-name=\"activity heartbeat icon\">\n                    </i>\n                    Pecho\n                </span>\n                <button aria-label=\"Ver técnica de Press banca plana\" class=\"athlete-play\" data-action=\"technique\" data-kid=\"1-1-4-1-2\" data-name=\"technique video play button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-player-play-filled\" data-kid=\"1-1-4-1-2-1\" data-name=\"play button icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"athlete-identity\" data-kid=\"1-1-4-2\" data-name=\"athlete identity block\">\n                <div class=\"athlete-kicker\" data-kid=\"1-1-4-2-1\" data-name=\"exercise category kicker text\">\n                    Fuerza · Tren superior\n                </div>\n                <h1 class=\"athlete-title\" data-kid=\"1-1-4-2-2\" data-name=\"exercise title heading\">\n                    Press banca plana\n                </h1>\n                <p class=\"athlete-subtitle\" data-kid=\"1-1-4-2-3\" data-name=\"exercise instruction subtitle\">\n                    Controlá la bajada · empujá con potencia\n                </p>\n                <div aria-label=\"Resumen del ejercicio\" class=\"athlete-ribbon\" data-kid=\"1-1-4-2-4\" data-name=\"exercise statistics summary row\">\n                    <div class=\"athlete-stat\" data-kid=\"1-1-4-2-4-1\" data-name=\"series stat block\">\n                        <div class=\"athlete-stat-label\" data-kid=\"1-1-4-2-4-1-1\" data-name=\"series stat label\">\n                            <i aria-hidden=\"true\" class=\"ti ti-stack-2\" data-kid=\"1-1-4-2-4-1-1-1\" data-name=\"series icon\">\n                            </i>\n                            Series\n                        </div>\n                        <div class=\"athlete-stat-value\" data-kid=\"1-1-4-2-4-1-2\" data-name=\"series count value\">\n                            4\n                            <span data-kid=\"1-1-4-2-4-1-2-1\" data-name=\"series total unit text\">\n                                totales\n                            </span>\n                        </div>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"athlete-rule\" data-kid=\"1-1-4-2-4-2\" data-name=\"separator rule\">\n                    </div>\n                    <div class=\"athlete-stat\" data-kid=\"1-1-4-2-4-3\" data-name=\"reps stat block\">\n                        <div class=\"athlete-stat-label\" data-kid=\"1-1-4-2-4-3-1\" data-name=\"reps stat label\">\n                            <i aria-hidden=\"true\" class=\"ti ti-repeat\" data-kid=\"1-1-4-2-4-3-1-1\" data-name=\"reps icon\">\n                            </i>\n                            Reps\n                        </div>\n                        <div class=\"athlete-stat-value\" data-kid=\"1-1-4-2-4-3-2\" data-name=\"reps count value\">\n                            12\n                            <span data-kid=\"1-1-4-2-4-3-2-1\" data-name=\"reps unit text\">\n                                por serie\n                            </span>\n                        </div>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"athlete-rule\" data-kid=\"1-1-4-2-4-4\" data-name=\"separator rule\">\n                    </div>\n                    <div class=\"athlete-stat\" data-kid=\"1-1-4-2-4-5\" data-name=\"rest stat block\">\n                        <div class=\"athlete-stat-label\" data-kid=\"1-1-4-2-4-5-1\" data-name=\"rest stat label\">\n                            <i aria-hidden=\"true\" class=\"ti ti-stopwatch\" data-kid=\"1-1-4-2-4-5-1-1\" data-name=\"stopwatch icon\">\n                            </i>\n                            Descanso\n                        </div>\n                        <div class=\"athlete-stat-value\" data-kid=\"1-1-4-2-4-5-2\" data-name=\"rest duration value\">\n                            90\n                            <span data-kid=\"1-1-4-2-4-5-2-1\" data-name=\"rest time unit text\">\n                                seg\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <section aria-labelledby=\"log-title\" class=\"athlete-log\" data-kid=\"1-1-4-3\" data-name=\"exercise log section\">\n                <div class=\"athlete-log-heading\" data-kid=\"1-1-4-3-1\" data-name=\"log section heading container\">\n                    <span data-kid=\"1-1-4-3-1-1\" data-name=\"log section title\" id=\"log-title\">\n                        Registrar serie\n                    </span>\n                    <span class=\"athlete-series-count\" data-kid=\"1-1-4-3-1-2\" data-name=\"series progress count text\">\n                        <strong data-dynamic=\"true\" data-kid=\"1-1-4-3-1-2-1\" data-name=\"current series number text\" data-reason=\"text updated by script upon interaction\">\n                            1\n                        </strong>\n                        / 4\n                    </span>\n                </div>\n                <div aria-label=\"Progreso de series\" aria-valuemax=\"4\" aria-valuemin=\"1\" aria-valuenow=\"1\" class=\"athlete-progress\" data-kid=\"1-1-4-3-2\" data-name=\"series completion progress bar\" role=\"progressbar\">\n                    <span data-kid=\"1-1-4-3-2-1\" data-name=\"series progress dot\">\n                    </span>\n                    <span data-kid=\"1-1-4-3-2-2\" data-name=\"series progress dot\">\n                    </span>\n                    <span data-kid=\"1-1-4-3-2-3\" data-name=\"series progress dot\">\n                    </span>\n                    <span data-kid=\"1-1-4-3-2-4\" data-name=\"series progress dot\">\n                    </span>\n                </div>\n                <div class=\"athlete-controls\" data-kid=\"1-1-4-3-3\" data-name=\"exercise control inputs container\">\n                    <div class=\"athlete-control\" data-kid=\"1-1-4-3-3-1\" data-kind=\"weight\" data-name=\"weight control block\">\n                        <div class=\"athlete-control-label\" data-kid=\"1-1-4-3-3-1-1\" data-name=\"weight control label\">\n                            Peso\n                        </div>\n                        <div class=\"athlete-stepper\" data-kid=\"1-1-4-3-3-1-2\" data-name=\"weight incrementer stepper\">\n                            <button aria-label=\"Disminuir peso\" data-action=\"weight-minus\" data-kid=\"1-1-4-3-3-1-2-1\" data-name=\"decrease weight button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-minus\" data-kid=\"1-1-4-3-3-1-2-1-1\" data-name=\"minus icon\">\n                                </i>\n                            </button>\n                            <output aria-live=\"polite\" class=\"athlete-number\" data-dynamic=\"true\" data-kid=\"1-1-4-3-3-1-2-2\" data-name=\"current weight output\" data-output=\"weight\" data-reason=\"text updated to display current weight by script\">\n                                —\n                                <span class=\"athlete-unit\" data-kid=\"1-1-4-3-3-1-2-2-1\" data-name=\"kilogram unit text\">\n                                    kg\n                                </span>\n                            </output>\n                            <button aria-label=\"Aumentar peso\" data-action=\"weight-plus\" data-kid=\"1-1-4-3-3-1-2-3\" data-name=\"increase weight button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-4-3-3-1-2-3-1\" data-name=\"plus icon\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"athlete-helper\" data-dynamic=\"true\" data-helper=\"weight\" data-kid=\"1-1-4-3-3-1-3\" data-name=\"weight control helper text\" data-reason=\"text updated by script to indicate state\">\n                            Elegí tu carga\n                        </div>\n                    </div>\n                    <div class=\"athlete-control\" data-kid=\"1-1-4-3-3-2\" data-kind=\"reps\" data-name=\"reps control block\">\n                        <div class=\"athlete-control-label\" data-kid=\"1-1-4-3-3-2-1\" data-name=\"reps control label\">\n                            Repeticiones\n                        </div>\n                        <div class=\"athlete-stepper\" data-kid=\"1-1-4-3-3-2-2\" data-name=\"reps incrementer stepper\">\n                            <button aria-label=\"Disminuir repeticiones\" data-action=\"reps-minus\" data-kid=\"1-1-4-3-3-2-2-1\" data-name=\"decrease reps button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-minus\" data-kid=\"1-1-4-3-3-2-2-1-1\" data-name=\"minus icon\">\n                                </i>\n                            </button>\n                            <output aria-live=\"polite\" class=\"athlete-number\" data-dynamic=\"true\" data-kid=\"1-1-4-3-3-2-2-2\" data-name=\"current reps output\" data-output=\"reps\" data-reason=\"text updated to display current reps by script\">\n                                12\n                                <span class=\"athlete-unit\" data-kid=\"1-1-4-3-3-2-2-2-1\" data-name=\"reps unit text\">\n                                    reps\n                                </span>\n                            </output>\n                            <button aria-label=\"Aumentar repeticiones\" data-action=\"reps-plus\" data-kid=\"1-1-4-3-3-2-2-3\" data-name=\"increase reps button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-4-3-3-2-2-3-1\" data-name=\"plus icon\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"athlete-helper\" data-kid=\"1-1-4-3-3-2-3\" data-name=\"reps control helper text\">\n                            Objetivo por serie\n                        </div>\n                    </div>\n                </div>\n                <button class=\"athlete-save\" data-action=\"save\" data-kid=\"1-1-4-3-4\" data-name=\"save series button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-1-4-3-4-1\" data-name=\"check icon\">\n                    </i>\n                    <span data-kid=\"1-1-4-3-4-2\" data-name=\"save button text\">\n                        Guardar serie\n                    </span>\n                </button>\n                <div aria-live=\"polite\" class=\"athlete-status\" data-dynamic=\"true\" data-kid=\"1-1-4-3-5\" data-name=\"exercise status announcement\" data-reason=\"text updated to reflect current status by script\" data-status=\"\" role=\"status\">\n                    Listo para registrar tu primera serie.\n                </div>\n            </section>\n        </div>\n    </article>\n</div>\n<script type=\"module\">\n    import { animate } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n\n  const card = document.querySelector('.athlete-card');\n  const status = document.querySelector('[data-status]');\n  const weightOutput = document.querySelector('[data-output=\"weight\"]');\n  const repsOutput = document.querySelector('[data-output=\"reps\"]');\n  const weightHelper = document.querySelector('[data-helper=\"weight\"]');\n  let weight = null;\n  let reps = 12;\n\n  animate(card, { opacity: [0, 1], transform: ['translateY(22px) scale(.975)', 'translateY(0) scale(1)'] }, { duration: .65, easing: 'ease-out' });\n\n  const tick = (node) => animate(node, { transform: ['scale(1)', 'scale(1.13)', 'scale(1)'] }, { duration: .22, easing: 'ease-out' });\n  const setStatus = (message) => { status.textContent = message; };\n  const renderWeight = () => { weightOutput.innerHTML = weight === null ? '— <span class=\"athlete-unit\">kg</span>' : `${weight.toFixed(1)} <span class=\"athlete-unit\">kg</span>`; weightHelper.textContent = weight === null ? 'Elegí tu carga' : 'Carga lista para guardar'; };\n  const renderReps = () => { repsOutput.innerHTML = `${reps} <span class=\"athlete-unit\">reps</span>`; };\n\n  document.querySelector('[data-action=\"weight-minus\"]').addEventListener('click', () => {\n    weight = weight === null ? null : Math.max(0, weight - 2.5);\n    renderWeight(); tick(weightOutput); setStatus(weight === null ? 'Definí el peso con el botón más.' : `Peso ajustado a ${weight.toFixed(1)} kilos.`);\n  });\n  document.querySelector('[data-action=\"weight-plus\"]').addEventListener('click', () => {\n    weight = weight === null ? 20 : weight + 2.5;\n    renderWeight(); tick(weightOutput); setStatus(`Peso ajustado a ${weight.toFixed(1)} kilos.`);\n  });\n  document.querySelector('[data-action=\"reps-minus\"]').addEventListener('click', () => {\n    reps = Math.max(1, reps - 1); renderReps(); tick(repsOutput); setStatus(`Repeticiones ajustadas a ${reps}.`);\n  });\n  document.querySelector('[data-action=\"reps-plus\"]').addEventListener('click', () => {\n    reps += 1; renderReps(); tick(repsOutput); setStatus(`Repeticiones ajustadas a ${reps}.`);\n  });\n  document.querySelector('[data-action=\"technique\"]').addEventListener('click', () => {\n    tick(document.querySelector('.athlete-play')); setStatus('Técnica: escápulas atrás, pies firmes y barra controlada.');\n  });\n  document.querySelector('[data-action=\"save\"]').addEventListener('click', () => {\n    animate(document.querySelector('[data-action=\"save\"]'), { transform: ['scale(1)', 'scale(.97)', 'scale(1)'] }, { duration: .24, easing: 'ease-out' });\n    setStatus(weight === null ? 'Serie guardada. Agregá peso cuando estés listo.' : `Serie guardada con ${weight.toFixed(1)} kg y ${reps} reps.`);\n  });\n</script>\n",
      "comments": [],
      "created": "2026-07-23T17:01:54.632884+00:00",
      "modified": "2026-07-23T17:02:23.487755+00:00",
      "id": "var_27a24b54c67b"
    },
    "var_939b21962d15": {
      "type": "variant",
      "label": "Redesign — Editorial Split",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2375,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700;800&family=Work+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .editorial-canvas {\n    --base: #111508;\n    --onyx: #111111;\n    --surface: #1a1d10;\n    --surface-high: #25291a;\n    --ink: #e2e4cf;\n    --muted: #8e9379;\n    --muted-strong: #b7baa0;\n    --lime: #c3f400;\n    --warm-border: rgba(226, 228, 207, 0.18);\n    --quiet-border: rgba(142, 147, 121, 0.28);\n    min-height: 100vh;\n    background: #0b0e06;\n    color: var(--ink);\n    font-family: 'Work Sans', sans-serif;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 24px 14px;\n  }\n\n  .editorial-card {\n    position: relative;\n    width: min(100%, 348px);\n    min-height: 696px;\n    overflow: hidden;\n    display: grid;\n    grid-template-columns: 36% 64%;\n    background: var(--base);\n    border: 1px solid var(--warm-border);\n    border-radius: 30px;\n    box-shadow: 0 26px 60px rgba(0, 0, 0, 0.58), 0 2px 0 rgba(255,255,255,0.04) inset;\n    isolation: isolate;\n  }\n\n  .editorial-card::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    border: 1px solid rgba(195, 244, 0, 0.1);\n    border-radius: inherit;\n    mix-blend-mode: screen;\n  }\n\n  .photo-panel {\n    position: relative;\n    min-height: 696px;\n    overflow: hidden;\n    background: var(--onyx);\n    border-right: 1px solid rgba(226, 228, 207, 0.2);\n  }\n\n  .photo-panel img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: 62% center;\n    filter: grayscale(1) contrast(1.14) brightness(0.72);\n  }\n\n  .photo-panel::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    background: linear-gradient(180deg, rgba(17,21,8,0.18), rgba(17,21,8,0.44) 46%, rgba(17,21,8,0.92) 100%);\n  }\n\n  .photo-panel::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    z-index: 2;\n    background: linear-gradient(90deg, transparent 70%, rgba(195,244,0,0.12));\n    mix-blend-mode: screen;\n    pointer-events: none;\n  }\n\n  .vertical-wordmark {\n    position: absolute;\n    z-index: 3;\n    left: 14px;\n    bottom: 22px;\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    color: rgba(226, 228, 207, 0.68);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 3px;\n    text-transform: uppercase;\n  }\n\n  .photo-index {\n    position: absolute;\n    z-index: 3;\n    top: 20px;\n    left: 14px;\n    color: var(--lime);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 1px;\n    writing-mode: vertical-rl;\n  }\n\n  .seam-rail {\n    position: absolute;\n    z-index: 6;\n    top: 84px;\n    left: calc(36% - 1px);\n    bottom: 70px;\n    width: 2px;\n    background: linear-gradient(180deg, transparent, var(--lime) 18%, var(--lime) 78%, transparent);\n    box-shadow: 0 0 18px rgba(195,244,0,0.25);\n    pointer-events: none;\n  }\n\n  .seam-rail span {\n    position: absolute;\n    top: -16px;\n    left: 8px;\n    width: 54px;\n    color: var(--lime);\n    font-family: 'Work Sans', sans-serif;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 1px;\n    white-space: nowrap;\n  }\n\n  .content-panel {\n    position: relative;\n    z-index: 4;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    background: linear-gradient(145deg, rgba(37,41,26,0.62), rgba(17,21,8,0.96) 34%, rgba(17,21,8,1));\n  }\n\n  .identity {\n    padding: 24px 18px 20px 22px;\n    min-height: 220px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    border-bottom: 1px solid var(--quiet-border);\n  }\n\n  .identity-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n  }\n\n  .eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    color: var(--lime);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n  }\n\n  .eyebrow::before {\n    content: '';\n    width: 18px;\n    height: 2px;\n    background: var(--lime);\n    box-shadow: 0 0 10px rgba(195,244,0,0.42);\n  }\n\n  .tech-orb,\n  .tech-orb-top {\n    width: 40px;\n    height: 40px;\n    flex: 0 0 40px;\n    border: 1px solid rgba(195,244,0,0.42);\n    border-radius: 999px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ink);\n    background: rgba(17,17,17,0.38);\n    cursor: pointer;\n    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;\n  }\n\n  .tech-orb-top {\n    position: absolute;\n    top: 20px;\n    right: 16px;\n    z-index: 5;\n    border-color: rgba(226,228,207,0.28);\n    background: rgba(17,17,17,0.48);\n  }\n\n  .tech-orb:hover,\n  .tech-orb-top:hover,\n  .tech-orb:focus-visible,\n  .tech-orb-top:focus-visible {\n    transform: scale(1.07);\n    background: rgba(195,244,0,0.16);\n    border-color: var(--lime);\n    outline: 3px solid rgba(195,244,0,0.2);\n    outline-offset: 2px;\n  }\n\n  .title {\n    max-width: 190px;\n    margin: 28px 0 0;\n    color: var(--ink);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: clamp(42px, 13vw, 54px);\n    font-weight: 700;\n    letter-spacing: -1px;\n    line-height: 0.87;\n    text-wrap: balance;\n    text-shadow: 0 8px 24px rgba(0,0,0,0.42);\n  }\n\n  .identity-note {\n    margin-top: 14px;\n    color: var(--muted-strong);\n    font-size: 11px;\n    line-height: 1.4;\n  }\n\n  .prescription {\n    padding: 18px 18px 18px 22px;\n    border-bottom: 1px solid var(--quiet-border);\n  }\n\n  .section-kicker {\n    margin-bottom: 13px;\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n  }\n\n  .prescription-line {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1.12fr;\n    align-items: end;\n    gap: 0;\n  }\n\n  .prescription-item {\n    min-width: 0;\n    padding-right: 10px;\n    border-right: 1px solid rgba(142,147,121,0.28);\n  }\n\n  .prescription-item + .prescription-item {\n    padding-left: 10px;\n  }\n\n  .prescription-item:last-child {\n    border-right: 0;\n    padding-right: 0;\n  }\n\n  .prescription-value {\n    color: var(--ink);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 29px;\n    font-weight: 600;\n    letter-spacing: 0.3px;\n    line-height: 0.95;\n  }\n\n  .prescription-value em {\n    color: var(--lime);\n    font-family: 'Work Sans', sans-serif;\n    font-size: 10px;\n    font-style: normal;\n    font-weight: 700;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n  }\n\n  .prescription-label {\n    margin-top: 6px;\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: 0.6px;\n    text-transform: uppercase;\n  }\n\n  .edit-zone {\n    flex: 1;\n    padding: 18px 18px 16px 22px;\n    background: rgba(26,29,16,0.62);\n    box-shadow: 0 2px 16px rgba(0,0,0,0.18) inset;\n  }\n\n  .edit-heading-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n    margin-bottom: 14px;\n  }\n\n  .edit-heading {\n    color: var(--ink);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 21px;\n    font-weight: 600;\n    letter-spacing: 0.8px;\n    line-height: 1;\n  }\n\n  .edit-hint {\n    color: var(--muted);\n    font-size: 9px;\n    text-align: right;\n  }\n\n  .control-stack {\n    display: grid;\n    gap: 10px;\n  }\n\n  .control-row {\n    min-height: 84px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n    padding: 12px 10px 12px 12px;\n    background: rgba(17,17,17,0.46);\n    border: 1px solid rgba(226,228,207,0.14);\n    border-radius: 17px;\n    box-shadow: 0 10px 22px rgba(0,0,0,0.16) inset;\n  }\n\n  .control-row.is-active {\n    border-color: rgba(195,244,0,0.9);\n    box-shadow: 0 0 0 3px rgba(195,244,0,0.1), 0 10px 22px rgba(0,0,0,0.18) inset;\n  }\n\n  .control-copy {\n    min-width: 54px;\n  }\n\n  .control-label {\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 1.4px;\n    text-transform: uppercase;\n  }\n\n  .control-helper {\n    margin-top: 6px;\n    color: var(--muted);\n    font-size: 9px;\n    line-height: 1.15;\n  }\n\n  .stepper {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n  }\n\n  .stepper-value {\n    min-width: 36px;\n    color: var(--ink);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 32px;\n    font-weight: 600;\n    letter-spacing: 0.4px;\n    line-height: 1;\n    text-align: center;\n  }\n\n  .stepper-value.weight-empty {\n    color: var(--lime);\n    font-size: 28px;\n  }\n\n  .step-button {\n    width: 34px;\n    height: 34px;\n    min-width: 34px;\n    border: 1px solid rgba(226,228,207,0.18);\n    border-radius: 10px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--muted-strong);\n    background: rgba(37,41,26,0.78);\n    cursor: pointer;\n    transition: transform 150ms ease, background 150ms ease, color 150ms ease, border-color 150ms ease;\n  }\n\n  .step-button:hover,\n  .step-button:focus-visible {\n    color: var(--lime);\n    background: rgba(195,244,0,0.14);\n    border-color: rgba(195,244,0,0.66);\n    outline: 3px solid rgba(195,244,0,0.16);\n    outline-offset: 2px;\n  }\n\n  .step-button:active {\n    transform: scale(0.92);\n  }\n\n  .action-dock {\n    margin-top: auto;\n    padding: 14px 18px 18px 22px;\n    display: grid;\n    grid-template-columns: 1fr 48px;\n    gap: 9px;\n    border-top: 1px solid rgba(226,228,207,0.12);\n    background: rgba(17,17,17,0.28);\n  }\n\n  .save-button {\n    min-height: 50px;\n    border: 0;\n    border-radius: 15px;\n    color: #111508;\n    background: var(--lime);\n    box-shadow: 0 8px 22px rgba(195,244,0,0.16), 0 1px 0 rgba(255,255,255,0.5) inset;\n    font-family: 'Work Sans', sans-serif;\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 0.3px;\n    cursor: pointer;\n    transition: transform 150ms ease, box-shadow 150ms ease, filter 150ms ease;\n  }\n\n  .save-button:hover,\n  .save-button:focus-visible {\n    filter: brightness(1.07);\n    box-shadow: 0 10px 28px rgba(195,244,0,0.28), 0 1px 0 rgba(255,255,255,0.56) inset;\n    outline: 3px solid rgba(195,244,0,0.22);\n    outline-offset: 3px;\n  }\n\n  .save-button:active {\n    transform: translateY(1px) scale(0.98);\n  }\n\n  .tech-dock {\n    min-height: 50px;\n    border: 1px solid rgba(226,228,207,0.3);\n    border-radius: 15px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ink);\n    background: transparent;\n    cursor: pointer;\n    transition: transform 150ms ease, color 150ms ease, border-color 150ms ease, background 150ms ease;\n  }\n\n  .tech-dock:hover,\n  .tech-dock:focus-visible {\n    color: var(--lime);\n    border-color: var(--lime);\n    background: rgba(195,244,0,0.08);\n    outline: 3px solid rgba(195,244,0,0.16);\n    outline-offset: 2px;\n  }\n\n  .live-status {\n    position: absolute;\n    z-index: 8;\n    left: 22px;\n    right: 18px;\n    bottom: 77px;\n    min-height: 25px;\n    padding: 6px 9px;\n    border: 1px solid rgba(195,244,0,0.2);\n    border-radius: 9px;\n    color: var(--muted-strong);\n    background: rgba(17,17,17,0.9);\n    font-size: 9px;\n    line-height: 1.15;\n    opacity: 0;\n    pointer-events: none;\n    transform: translateY(8px);\n  }\n\n  .live-status.is-visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0,0,0,0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  @media (max-width: 340px) {\n    .editorial-canvas { padding-inline: 8px; }\n    .editorial-card { grid-template-columns: 33% 67%; }\n    .identity { padding-left: 17px; }\n    .edit-zone, .prescription, .action-dock { padding-left: 17px; }\n    .title { font-size: 38px; }\n    .step-button { width: 30px; min-width: 30px; height: 30px; }\n  }\n</style>\n<main aria-label=\"Vista previa de tarjeta de ejercicio\" class=\"editorial-canvas\" data-kid=\"1\" data-name=\"main preview layout container\">\n    <article class=\"editorial-card\" data-kid=\"1-1\" data-name=\"exercise details card\" id=\"exercise-card\">\n        <aside aria-label=\"Imagen del ejercicio Press banca plana\" class=\"photo-panel\" data-kid=\"1-1-1\" data-name=\"exercise image panel\">\n            <img alt=\"Atleta entrenando en luz dramática — foto de Cindy Koops, Unsplash\" data-kid=\"1-1-1-1\" data-name=\"exercise visual content\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1544021601-3e5723f9d333?auto=format&w=700&q=80&fit=crop\"/>\n            <span class=\"photo-index\" data-kid=\"1-1-1-2\" data-name=\"photo sequence index text\">\n                01 / 04\n            </span>\n            <span class=\"vertical-wordmark\" data-kid=\"1-1-1-3\" data-name=\"vertical category wordmark\">\n                fuerza · tren superior\n            </span>\n        </aside>\n        <div aria-hidden=\"true\" class=\"seam-rail\" data-kid=\"1-1-2\" data-name=\"seam decorative rail\">\n            <span data-kid=\"1-1-2-1\" data-name=\"seam sequence label\">\n                01 — 04\n            </span>\n        </div>\n        <section aria-label=\"Detalles y edición del ejercicio\" class=\"content-panel\" data-kid=\"1-1-3\" data-name=\"exercise edit panel\">\n            <button aria-label=\"Ver técnica de Press banca plana\" class=\"tech-orb-top\" data-action=\"tech\" data-kid=\"1-1-3-1\" data-name=\"top technique play button\" title=\"Ver técnica\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-player-play-filled\" data-kid=\"1-1-3-1-1\" data-name=\"play icon\">\n                </i>\n            </button>\n            <header class=\"identity\" data-kid=\"1-1-3-2\" data-name=\"exercise identification header\">\n                <div class=\"identity-top\" data-kid=\"1-1-3-2-1\" data-name=\"exercise type eyebrow container\">\n                    <span class=\"eyebrow\" data-kid=\"1-1-3-2-1-1\" data-name=\"exercise muscle group label\">\n                        Pecho\n                    </span>\n                    <span class=\"sr-only\" data-kid=\"1-1-3-2-1-2\" data-name=\"screen reader only exercise category description\">\n                        Ejercicio de fuerza\n                    </span>\n                </div>\n                <div data-kid=\"1-1-3-2-2\" data-name=\"title and description container\">\n                    <h1 class=\"title\" data-kid=\"1-1-3-2-2-1\" data-name=\"exercise title heading\">\n                        Press\n                        <br data-kid=\"1-1-3-2-2-1-1\" data-name=\"title line break\"/>\n                        banca plana\n                    </h1>\n                    <p class=\"identity-note\" data-kid=\"1-1-3-2-2-2\" data-name=\"exercise technique instruction note\">\n                        Controlá el descenso. Empujá con intención.\n                    </p>\n                </div>\n            </header>\n            <section aria-label=\"Prescripción del ejercicio\" class=\"prescription\" data-kid=\"1-1-3-3\" data-name=\"prescription section\">\n                <p class=\"section-kicker\" data-kid=\"1-1-3-3-1\" data-name=\"prescription section kicker\">\n                    Prescripción\n                </p>\n                <div class=\"prescription-line\" data-kid=\"1-1-3-3-2\" data-name=\"prescription details grid\">\n                    <div class=\"prescription-item\" data-kid=\"1-1-3-3-2-1\" data-name=\"volume prescription item\">\n                        <div class=\"prescription-value\" data-dynamic=\"true\" data-kid=\"1-1-3-3-2-1-1\" data-name=\"volume value text\" data-reason=\"text value updated by script\">\n                            4\n                            <em data-kid=\"1-1-3-3-2-1-1-1\" data-name=\"volume unit label\">\n                                series\n                            </em>\n                        </div>\n                        <div class=\"prescription-label\" data-kid=\"1-1-3-3-2-1-2\" data-name=\"volume label\">\n                            volumen\n                        </div>\n                    </div>\n                    <div class=\"prescription-item\" data-kid=\"1-1-3-3-2-2\" data-name=\"target prescription item\">\n                        <div class=\"prescription-value\" data-dynamic=\"true\" data-kid=\"1-1-3-3-2-2-1\" data-name=\"target reps value text\" data-reason=\"text value updated by script\">\n                            12\n                            <em data-kid=\"1-1-3-3-2-2-1-1\" data-name=\"target reps unit label\">\n                                reps\n                            </em>\n                        </div>\n                        <div class=\"prescription-label\" data-kid=\"1-1-3-3-2-2-2\" data-name=\"target label\">\n                            objetivo\n                        </div>\n                    </div>\n                    <div class=\"prescription-item\" data-kid=\"1-1-3-3-2-3\" data-name=\"recovery prescription item\">\n                        <div class=\"prescription-value\" data-dynamic=\"true\" data-kid=\"1-1-3-3-2-3-1\" data-name=\"recovery value text\" data-reason=\"text value updated by script\">\n                            90\n                            <em data-kid=\"1-1-3-3-2-3-1-1\" data-name=\"recovery unit label\">\n                                s rest\n                            </em>\n                        </div>\n                        <div class=\"prescription-label\" data-kid=\"1-1-3-3-2-3-2\" data-name=\"recovery label\">\n                            recuperación\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"edit-heading\" class=\"edit-zone\" data-kid=\"1-1-3-4\" data-name=\"session editing zone\">\n                <div class=\"edit-heading-row\" data-kid=\"1-1-3-4-1\" data-name=\"edit header row\">\n                    <h2 class=\"edit-heading\" data-kid=\"1-1-3-4-1-1\" data-name=\"edit heading\" id=\"edit-heading\">\n                        Editar sesión\n                    </h2>\n                    <span class=\"edit-hint\" data-kid=\"1-1-3-4-1-2\" data-name=\"edit instruction hint\">\n                        Tocá un valor\n                        <br data-kid=\"1-1-3-4-1-2-1\" data-name=\"hint line break\"/>\n                        para ajustar\n                    </span>\n                </div>\n                <div class=\"control-stack\" data-kid=\"1-1-3-4-2\" data-name=\"control stack\">\n                    <div class=\"control-row\" data-control=\"reps\" data-kid=\"1-1-3-4-2-1\" data-name=\"reps control row\">\n                        <div class=\"control-copy\" data-kid=\"1-1-3-4-2-1-1\" data-name=\"reps control label container\">\n                            <div class=\"control-label\" data-kid=\"1-1-3-4-2-1-1-1\" data-name=\"reps control label\">\n                                Reps\n                            </div>\n                            <div class=\"control-helper\" data-kid=\"1-1-3-4-2-1-1-2\" data-name=\"reps control helper text\">\n                                por serie\n                            </div>\n                        </div>\n                        <div aria-label=\"Ajustar repeticiones\" class=\"stepper\" data-kid=\"1-1-3-4-2-1-2\" data-name=\"reps adjustment stepper\">\n                            <button aria-label=\"Reducir repeticiones\" class=\"step-button\" data-direction=\"down\" data-kid=\"1-1-3-4-2-1-2-1\" data-name=\"decrease reps button\" data-step=\"reps\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-minus\" data-kid=\"1-1-3-4-2-1-2-1-1\" data-name=\"minus icon\">\n                                </i>\n                            </button>\n                            <output aria-live=\"polite\" class=\"stepper-value\" data-dynamic=\"true\" data-kid=\"1-1-3-4-2-1-2-2\" data-name=\"reps count output\" data-reason=\"text value updated by script\" id=\"reps-value\">\n                                12\n                            </output>\n                            <button aria-label=\"Aumentar repeticiones\" class=\"step-button\" data-direction=\"up\" data-kid=\"1-1-3-4-2-1-2-3\" data-name=\"increase reps button\" data-step=\"reps\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-3-4-2-1-2-3-1\" data-name=\"plus icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"control-row\" data-control=\"weight\" data-kid=\"1-1-3-4-2-2\" data-name=\"weight control row\">\n                        <div class=\"control-copy\" data-kid=\"1-1-3-4-2-2-1\" data-name=\"weight control label container\">\n                            <div class=\"control-label\" data-kid=\"1-1-3-4-2-2-1-1\" data-name=\"weight control label\">\n                                Peso\n                            </div>\n                            <div class=\"control-helper\" data-dynamic=\"true\" data-kid=\"1-1-3-4-2-2-1-2\" data-name=\"weight control helper text\" data-reason=\"text content updated by script\" id=\"weight-helper\">\n                                Añadir kg\n                            </div>\n                        </div>\n                        <div aria-label=\"Ajustar peso\" class=\"stepper\" data-kid=\"1-1-3-4-2-2-2\" data-name=\"weight adjustment stepper\">\n                            <button aria-label=\"Reducir peso\" class=\"step-button\" data-direction=\"down\" data-kid=\"1-1-3-4-2-2-2-1\" data-name=\"decrease weight button\" data-step=\"weight\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-minus\" data-kid=\"1-1-3-4-2-2-2-1-1\" data-name=\"minus icon\">\n                                </i>\n                            </button>\n                            <output aria-live=\"polite\" class=\"stepper-value weight-empty\" data-dynamic=\"true\" data-kid=\"1-1-3-4-2-2-2-2\" data-name=\"weight value output\" data-reason=\"text value updated by script\" id=\"weight-value\">\n                                — kg\n                            </output>\n                            <button aria-label=\"Aumentar peso\" class=\"step-button\" data-direction=\"up\" data-kid=\"1-1-3-4-2-2-2-3\" data-name=\"increase weight button\" data-step=\"weight\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-3-4-2-2-2-3-1\" data-name=\"plus icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <div class=\"action-dock\" data-kid=\"1-1-3-5\" data-name=\"action dock container\">\n                <button aria-label=\"Guardar serie de Press banca plana\" class=\"save-button\" data-dynamic=\"true\" data-kid=\"1-1-3-5-1\" data-name=\"save series button\" data-reason=\"text content and innerHTML replaced by script on click\" id=\"save-button\" type=\"button\">\n                    Guardar serie\n                    <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-1-3-5-1-1\" data-name=\"save button icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Ver técnica de Press banca plana\" class=\"tech-dock\" data-action=\"tech\" data-kid=\"1-1-3-5-2\" data-name=\"bottom technique play button\" title=\"Ver técnica\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-player-play\" data-kid=\"1-1-3-5-2-1\" data-name=\"play icon\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <div aria-live=\"polite\" class=\"live-status\" data-dynamic=\"true\" data-kid=\"1-1-4\" data-name=\"live status message alert\" data-reason=\"text content and visibility updated by script\" id=\"live-status\" role=\"status\">\n        </div>\n    </article>\n</main>\n<script type=\"module\">\n    import { animate } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n\n  const card = document.querySelector('#exercise-card');\n  const status = document.querySelector('#live-status');\n  const repsValue = document.querySelector('#reps-value');\n  const weightValue = document.querySelector('#weight-value');\n  const weightHelper = document.querySelector('#weight-helper');\n  const repsRow = document.querySelector('[data-control=\"reps\"]');\n  const weightRow = document.querySelector('[data-control=\"weight\"]');\n  const saveButton = document.querySelector('#save-button');\n  let reps = 12;\n  let weight = null;\n  let statusTimer;\n\n  animate(card, { opacity: [0, 1], y: [22, 0], scale: [0.985, 1] }, { duration: 0.72, easing: [0.22, 1, 0.36, 1] });\n\n  function announce(message) {\n    status.textContent = message;\n    status.classList.add('is-visible');\n    clearTimeout(statusTimer);\n    statusTimer = setTimeout(() => status.classList.remove('is-visible'), 2200);\n  }\n\n  function pulse(target) {\n    animate(target, { scale: [1, 0.92, 1], y: [0, -3, 0] }, { duration: 0.25, easing: 'ease-out' });\n  }\n\n  function setActive(row) {\n    [repsRow, weightRow].forEach(item => item.classList.remove('is-active'));\n    row.classList.add('is-active');\n    setTimeout(() => row.classList.remove('is-active'), 900);\n  }\n\n  document.querySelectorAll('[data-step]').forEach(button => {\n    button.addEventListener('click', () => {\n      const type = button.dataset.step;\n      const direction = button.dataset.direction === 'up' ? 1 : -1;\n      const row = button.closest('.control-row');\n      setActive(row);\n      pulse(type === 'reps' ? repsValue : weightValue);\n\n      if (type === 'reps') {\n        reps = Math.max(1, Math.min(30, reps + direction));\n        repsValue.textContent = reps;\n        announce(`Repeticiones ajustadas a ${reps}`);\n      } else {\n        weight = Math.max(0, (weight ?? 0) + direction * 2.5);\n        weightValue.textContent = `${weight.toFixed(1)} kg`;\n        weightValue.classList.remove('weight-empty');\n        weightHelper.textContent = 'carga por serie';\n        announce(`Peso ajustado a ${weight.toFixed(1)} kilos`);\n      }\n    });\n  });\n\n  document.querySelectorAll('[data-action=\"tech\"]').forEach(button => {\n    button.addEventListener('click', () => announce('Técnica: escápulas atrás, pies firmes y barra al centro del pecho.'));\n  });\n\n  saveButton.addEventListener('click', () => {\n    saveButton.innerHTML = 'Serie guardada <i class=\"ti ti-check\" aria-hidden=\"true\"></i>';\n    announce(weight === null ? `Serie guardada con ${reps} repeticiones. Añadí peso cuando quieras.` : `Serie guardada: ${reps} repeticiones con ${weight.toFixed(1)} kilos.`);\n    animate(saveButton, { scale: [1, 0.97, 1] }, { duration: 0.3, easing: 'ease-out' });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-07-23T17:01:55.352556+00:00",
      "modified": "2026-07-23T17:03:13.424462+00:00",
      "id": "var_939b21962d15"
    },
    "var_a83fbf483fa5": {
      "type": "variant",
      "label": "Editorial Split — Layered Focus",
      "parentId": "var_939b21962d15",
      "themeId": null,
      "rect": {
        "x": 2850,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700;800&family=Work+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .layered-focus-canvas {\n    min-height: 100vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 22px 14px;\n    color: #e2e4cf;\n    font-family: 'Work Sans', sans-serif;\n    background:\n      radial-gradient(circle at 18% 10%, rgba(195,244,0,0.07), transparent 34%),\n      radial-gradient(circle at 95% 82%, rgba(91,108,47,0.12), transparent 38%),\n      #0a0d06;\n  }\n\n  .layered-focus-card {\n    position: relative;\n    width: min(100%, 348px);\n    min-height: 694px;\n    overflow: hidden;\n    isolation: isolate;\n    border: 1px solid rgba(226,228,207,0.2);\n    border-radius: 30px 30px 24px 30px;\n    background:\n      radial-gradient(circle at 25% 36%, rgba(195,244,0,0.055) 0 1px, transparent 1.3px),\n      radial-gradient(circle at 74% 66%, rgba(226,228,207,0.035) 0 1px, transparent 1.5px),\n      linear-gradient(145deg, #24291a 0%, #15190d 30%, #111508 100%);\n    background-size: auto, 19px 19px, auto;\n    box-shadow: 0 30px 70px rgba(0,0,0,0.62), 0 1px 0 rgba(255,255,255,0.06) inset;\n  }\n\n  .layered-focus-card::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    z-index: -1;\n    pointer-events: none;\n    background: linear-gradient(112deg, transparent 0 46%, rgba(195,244,0,0.06) 46.2%, transparent 46.8%);\n    opacity: 0.7;\n  }\n\n  .layered-focus-card::after {\n    content: '';\n    position: absolute;\n    inset: 10px 9px 9px;\n    z-index: 5;\n    pointer-events: none;\n    border: 1px solid rgba(195,244,0,0.07);\n    border-radius: 24px 24px 18px 24px;\n  }\n\n  .focus-header {\n    position: relative;\n    z-index: 3;\n    padding: 23px 21px 0;\n  }\n\n  .focus-progress {\n    display: grid;\n    grid-template-columns: 1fr auto;\n    align-items: center;\n    gap: 11px;\n  }\n\n  .focus-progress-track {\n    position: relative;\n    height: 3px;\n    overflow: visible;\n    border-radius: 999px;\n    background: rgba(142,147,121,0.22);\n  }\n\n  .focus-progress-track::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: -2px;\n    width: 25%;\n    height: 7px;\n    border-radius: 999px;\n    background: #c3f400;\n    box-shadow: 0 0 17px rgba(195,244,0,0.38);\n  }\n\n  .focus-progress-label {\n    color: #c3f400;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 1.7px;\n    white-space: nowrap;\n  }\n\n  .focus-hero {\n    position: relative;\n    min-height: 246px;\n    padding: 25px 21px 17px;\n  }\n\n  .focus-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    color: #c3f400;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n  }\n\n  .focus-eyebrow::before {\n    content: '';\n    width: 17px;\n    height: 2px;\n    background: #c3f400;\n    box-shadow: 0 0 10px rgba(195,244,0,0.45);\n  }\n\n  .focus-title {\n    max-width: 200px;\n    margin: 17px 0 0;\n    color: #e2e4cf;\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: clamp(45px, 14vw, 58px);\n    font-weight: 700;\n    letter-spacing: -1.3px;\n    line-height: 0.86;\n    text-wrap: balance;\n    text-shadow: 0 14px 28px rgba(0,0,0,0.46);\n  }\n\n  .focus-cue {\n    max-width: 210px;\n    margin: 15px 0 0;\n    color: #b7baa0;\n    font-size: 11px;\n    line-height: 1.38;\n  }\n\n  .focus-photo-frame {\n    position: absolute;\n    z-index: 2;\n    top: 18px;\n    right: 18px;\n    width: 132px;\n    height: 161px;\n    overflow: hidden;\n    border: 1px solid rgba(226,228,207,0.32);\n    border-radius: 24px 10px 28px 10px;\n    background: #111111;\n    box-shadow: 13px 16px 0 rgba(195,244,0,0.09), 0 20px 30px rgba(0,0,0,0.42);\n    transform: rotate(4deg);\n  }\n\n  .focus-photo-frame::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, rgba(17,21,8,0.02), rgba(17,21,8,0.72));\n    pointer-events: none;\n  }\n\n  .focus-photo-frame img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: 57% center;\n    filter: grayscale(1) contrast(1.12) brightness(0.84);\n  }\n\n  .focus-photo-tag {\n    position: absolute;\n    z-index: 2;\n    right: 8px;\n    bottom: 8px;\n    color: #e2e4cf;\n    font-size: 8px;\n    font-weight: 700;\n    letter-spacing: 1.1px;\n    text-transform: uppercase;\n  }\n\n  .focus-tech-top {\n    position: absolute;\n    z-index: 4;\n    top: 181px;\n    right: 22px;\n    width: 42px;\n    height: 42px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid rgba(195,244,0,0.54);\n    border-radius: 999px;\n    color: #c3f400;\n    background: rgba(17,17,17,0.72);\n    box-shadow: 0 8px 16px rgba(0,0,0,0.3);\n    cursor: pointer;\n    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;\n  }\n\n  .focus-tech-top:hover,\n  .focus-tech-top:focus-visible,\n  .focus-tech-bottom:hover,\n  .focus-tech-bottom:focus-visible {\n    border-color: #c3f400;\n    background: rgba(195,244,0,0.16);\n    outline: 3px solid rgba(195,244,0,0.18);\n    outline-offset: 3px;\n    transform: scale(1.06);\n  }\n\n  .focus-prescription {\n    position: relative;\n    z-index: 3;\n    display: flex;\n    align-items: center;\n    gap: 0;\n    margin: 0 21px;\n    padding: 14px 0 16px;\n    border-top: 1px solid rgba(226,228,207,0.16);\n    border-bottom: 1px solid rgba(226,228,207,0.16);\n    color: #b7baa0;\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 19px;\n    letter-spacing: 1px;\n    line-height: 1;\n    white-space: nowrap;\n  }\n\n  .focus-prescription span {\n    color: #e2e4cf;\n  }\n\n  .focus-prescription b {\n    margin: 0 7px;\n    color: #c3f400;\n    font-family: 'Work Sans', sans-serif;\n    font-size: 9px;\n    font-weight: 700;\n  }\n\n  .focus-edit-surface {\n    position: relative;\n    z-index: 3;\n    margin: 18px 16px 0;\n    padding: 17px 15px 15px;\n    border: 1px solid rgba(226,228,207,0.15);\n    border-radius: 25px 12px 21px 12px;\n    background: rgba(26,29,16,0.84);\n    box-shadow: 0 15px 26px rgba(0,0,0,0.24) inset, 0 15px 30px rgba(0,0,0,0.18);\n  }\n\n  .focus-edit-head {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 8px;\n    margin-bottom: 15px;\n  }\n\n  .focus-edit-heading {\n    color: #e2e4cf;\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 23px;\n    font-weight: 600;\n    letter-spacing: 1px;\n    line-height: 1;\n  }\n\n  .focus-edit-sub {\n    color: #8e9379;\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: 0.6px;\n    text-transform: uppercase;\n  }\n\n  .focus-controls {\n    display: grid;\n    grid-template-columns: 1.14fr 0.86fr;\n    gap: 9px;\n  }\n\n  .focus-control {\n    min-height: 132px;\n    padding: 13px 10px 11px;\n    border: 1px solid rgba(226,228,207,0.16);\n    border-radius: 17px 10px 14px 10px;\n    background: rgba(17,17,17,0.45);\n    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;\n  }\n\n  .focus-control.is-weight {\n    border-color: rgba(195,244,0,0.72);\n    background: linear-gradient(145deg, rgba(195,244,0,0.1), rgba(17,17,17,0.56) 58%);\n    box-shadow: 0 0 0 3px rgba(195,244,0,0.07), 0 12px 22px rgba(0,0,0,0.17) inset;\n  }\n\n  .focus-control.is-active {\n    box-shadow: 0 0 0 3px rgba(195,244,0,0.14), 0 12px 22px rgba(0,0,0,0.17) inset;\n  }\n\n  .focus-control-label {\n    color: #8e9379;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 1.6px;\n    text-transform: uppercase;\n  }\n\n  .focus-control-hint {\n    margin-top: 4px;\n    color: #8e9379;\n    font-size: 9px;\n  }\n\n  .focus-control-value-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 5px;\n    margin-top: 18px;\n  }\n\n  .focus-step-btn {\n    width: 44px;\n    height: 44px;\n    min-width: 44px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid rgba(226,228,207,0.22);\n    border-radius: 12px;\n    color: #b7baa0;\n    background: rgba(37,41,26,0.88);\n    cursor: pointer;\n    transition: transform 140ms ease, background 140ms ease, border-color 140ms ease, color 140ms ease;\n  }\n\n  .focus-step-btn:hover,\n  .focus-step-btn:focus-visible {\n    color: #c3f400;\n    border-color: rgba(195,244,0,0.72);\n    background: rgba(195,244,0,0.14);\n    outline: 3px solid rgba(195,244,0,0.15);\n    outline-offset: 2px;\n  }\n\n  .focus-step-btn:active {\n    transform: scale(0.9);\n  }\n\n  .focus-value {\n    min-width: 40px;\n    color: #e2e4cf;\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 35px;\n    font-weight: 600;\n    letter-spacing: 0.5px;\n    line-height: 0.85;\n    text-align: center;\n  }\n\n  .focus-control.is-weight .focus-value {\n    color: #c3f400;\n    font-size: 32px;\n  }\n\n  .focus-unit {\n    display: block;\n    margin-top: 8px;\n    color: #8e9379;\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: 1px;\n    text-align: center;\n    text-transform: uppercase;\n  }\n\n  .focus-actions {\n    position: relative;\n    z-index: 3;\n    display: grid;\n    grid-template-columns: 1fr 52px;\n    gap: 9px;\n    margin: 17px 16px 19px;\n  }\n\n  .focus-save,\n  .focus-tech-bottom {\n    min-height: 52px;\n    border-radius: 16px 10px 15px 10px;\n    cursor: pointer;\n    transition: transform 150ms ease, filter 150ms ease, box-shadow 150ms ease, border-color 150ms ease;\n  }\n\n  .focus-save {\n    border: 0;\n    color: #111508;\n    background: #c3f400;\n    box-shadow: 0 10px 23px rgba(195,244,0,0.22), 0 1px 0 rgba(255,255,255,0.54) inset;\n    font-family: 'Work Sans', sans-serif;\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 0.25px;\n  }\n\n  .focus-save:hover,\n  .focus-save:focus-visible {\n    filter: brightness(1.07);\n    box-shadow: 0 13px 28px rgba(195,244,0,0.32), 0 1px 0 rgba(255,255,255,0.58) inset;\n    outline: 3px solid rgba(195,244,0,0.21);\n    outline-offset: 3px;\n  }\n\n  .focus-save:active {\n    transform: translateY(1px) scale(0.98);\n  }\n\n  .focus-tech-bottom {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid rgba(226,228,207,0.3);\n    color: #e2e4cf;\n    background: rgba(17,17,17,0.42);\n  }\n\n  .focus-status {\n    position: absolute;\n    z-index: 7;\n    right: 24px;\n    bottom: 82px;\n    left: 24px;\n    min-height: 25px;\n    padding: 6px 9px;\n    border: 1px solid rgba(195,244,0,0.23);\n    border-radius: 9px;\n    color: #b7baa0;\n    background: rgba(17,17,17,0.94);\n    font-size: 9px;\n    line-height: 1.15;\n    opacity: 0;\n    pointer-events: none;\n    transform: translateY(7px);\n  }\n\n  .focus-status.is-visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  @media (max-width: 340px) {\n    .layered-focus-canvas { padding-inline: 8px; }\n    .layered-focus-card { min-height: 680px; }\n    .focus-photo-frame { width: 120px; height: 148px; }\n    .focus-title { font-size: 43px; }\n    .focus-prescription { font-size: 17px; }\n    .focus-step-btn { width: 40px; min-width: 40px; }\n  }\n</style>\n<main aria-label=\"Vista previa de tarjeta de ejercicio\" class=\"layered-focus-canvas\" data-kid=\"1\">\n    <article aria-label=\"Ejercicio Press banca plana\" class=\"layered-focus-card\" data-kid=\"1-1\" id=\"layered-focus-card\">\n        <header class=\"focus-header\" data-kid=\"1-1-1\">\n            <div aria-label=\"Progreso de la sesión: serie 1 de 4\" class=\"focus-progress\" data-kid=\"1-1-1-1\" data-name=\"progress tracking container\">\n                <div aria-hidden=\"true\" class=\"focus-progress-track\" data-kid=\"1-1-1-1-1\">\n                </div>\n                <span class=\"focus-progress-label\" data-dynamic=\"true\" data-kid=\"1-1-1-1-2\" data-name=\"progress counter text\" data-reason=\"text value updated by internal session state\">\n                    01 / 04\n                </span>\n            </div>\n        </header>\n        <section aria-labelledby=\"layered-title\" class=\"focus-hero\" data-kid=\"1-1-2\">\n            <span class=\"focus-eyebrow\" data-kid=\"1-1-2-1\">\n                Pecho\n            </span>\n            <h1 class=\"focus-title\" data-kid=\"1-1-2-2\" id=\"layered-title\">\n                Press\n                <br data-kid=\"1-1-2-2-1\"/>\n                banca plana\n            </h1>\n            <p class=\"focus-cue\" data-kid=\"1-1-2-3\">\n                Controlá el descenso · empujá con intención\n            </p>\n            <figure class=\"focus-photo-frame\" data-kid=\"1-1-2-4\">\n                <img alt=\"Atleta entrenando en luz dramática — foto de Cindy Koops, Unsplash\" data-kid=\"1-1-2-4-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1544021601-3e5723f9d333?auto=format&w=700&q=80&fit=crop\"/>\n                <figcaption class=\"focus-photo-tag\" data-kid=\"1-1-2-4-2\">\n                    Fuerza / 01\n                </figcaption>\n            </figure>\n            <button aria-label=\"Ver técnica de Press banca plana\" class=\"focus-tech-top\" data-action=\"tech\" data-kid=\"1-1-2-5\" title=\"Ver técnica\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-player-play-filled\" data-kid=\"1-1-2-5-1\">\n                </i>\n            </button>\n        </section>\n        <div aria-label=\"Prescripción: 4 series, 12 repeticiones, 90 segundos de descanso\" class=\"focus-prescription\" data-kid=\"1-1-3\">\n            <span data-kid=\"1-1-3-1\">\n                4 series\n            </span>\n            <b data-kid=\"1-1-3-2\">\n                ·\n            </b>\n            <span data-kid=\"1-1-3-3\">\n                12 reps\n            </span>\n            <b data-kid=\"1-1-3-4\">\n                ·\n            </b>\n            <span data-kid=\"1-1-3-5\">\n                90s rest\n            </span>\n        </div>\n        <section aria-labelledby=\"focus-edit-heading\" class=\"focus-edit-surface\" data-kid=\"1-1-4\">\n            <div class=\"focus-edit-head\" data-kid=\"1-1-4-1\">\n                <h2 class=\"focus-edit-heading\" data-kid=\"1-1-4-1-1\" id=\"focus-edit-heading\">\n                    Registrar serie\n                </h2>\n                <span class=\"focus-edit-sub\" data-kid=\"1-1-4-1-2\">\n                    tocá para ajustar\n                </span>\n            </div>\n            <div class=\"focus-controls\" data-kid=\"1-1-4-2\">\n                <div class=\"focus-control is-weight\" data-control=\"weight\" data-kid=\"1-1-4-2-1\">\n                    <div class=\"focus-control-label\" data-kid=\"1-1-4-2-1-1\">\n                        Peso\n                    </div>\n                    <div class=\"focus-control-hint\" data-dynamic=\"true\" data-kid=\"1-1-4-2-1-2\" data-name=\"weight hint text\" data-reason=\"text replaced after user begins weight input\" id=\"weight-hint\">\n                        añadir kg\n                    </div>\n                    <div class=\"focus-control-value-row\" data-kid=\"1-1-4-2-1-3\">\n                        <button aria-label=\"Reducir peso\" class=\"focus-step-btn\" data-direction=\"down\" data-kid=\"1-1-4-2-1-3-1\" data-step=\"weight\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-minus\" data-kid=\"1-1-4-2-1-3-1-1\">\n                            </i>\n                        </button>\n                        <output aria-live=\"polite\" class=\"focus-value\" data-dynamic=\"true\" data-kid=\"1-1-4-2-1-3-2\" data-name=\"weight value display\" data-reason=\"number text updated by adjustment buttons\" id=\"weight-value\">\n                            —\n                        </output>\n                        <button aria-label=\"Aumentar peso\" class=\"focus-step-btn\" data-direction=\"up\" data-kid=\"1-1-4-2-1-3-3\" data-step=\"weight\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-4-2-1-3-3-1\">\n                            </i>\n                        </button>\n                    </div>\n                    <span class=\"focus-unit\" data-kid=\"1-1-4-2-1-4\" id=\"weight-unit\">\n                        kg · editable\n                    </span>\n                </div>\n                <div class=\"focus-control\" data-control=\"reps\" data-kid=\"1-1-4-2-2\">\n                    <div class=\"focus-control-label\" data-kid=\"1-1-4-2-2-1\">\n                        Reps\n                    </div>\n                    <div class=\"focus-control-hint\" data-kid=\"1-1-4-2-2-2\">\n                        por serie\n                    </div>\n                    <div class=\"focus-control-value-row\" data-kid=\"1-1-4-2-2-3\">\n                        <button aria-label=\"Reducir repeticiones\" class=\"focus-step-btn\" data-direction=\"down\" data-kid=\"1-1-4-2-2-3-1\" data-step=\"reps\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-minus\" data-kid=\"1-1-4-2-2-3-1-1\">\n                            </i>\n                        </button>\n                        <output aria-live=\"polite\" class=\"focus-value\" data-dynamic=\"true\" data-kid=\"1-1-4-2-2-3-2\" data-name=\"reps value display\" data-reason=\"number text updated by adjustment buttons\" id=\"reps-value\">\n                            12\n                        </output>\n                        <button aria-label=\"Aumentar repeticiones\" class=\"focus-step-btn\" data-direction=\"up\" data-kid=\"1-1-4-2-2-3-3\" data-step=\"reps\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-4-2-2-3-3-1\">\n                            </i>\n                        </button>\n                    </div>\n                    <span class=\"focus-unit\" data-kid=\"1-1-4-2-2-4\">\n                        reps · objetivo\n                    </span>\n                </div>\n            </div>\n        </section>\n        <div class=\"focus-actions\" data-kid=\"1-1-5\">\n            <button aria-label=\"Guardar serie de Press banca plana\" class=\"focus-save\" data-dynamic=\"true\" data-kid=\"1-1-5-1\" data-name=\"save series action button\" data-reason=\"text and content replaced on click\" id=\"focus-save\" type=\"button\">\n                Guardar serie\n                <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-1-5-1-1\">\n                </i>\n            </button>\n            <button aria-label=\"Ver técnica de Press banca plana\" class=\"focus-tech-bottom\" data-action=\"tech\" data-kid=\"1-1-5-2\" title=\"Ver técnica\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-player-play\" data-kid=\"1-1-5-2-1\">\n                </i>\n            </button>\n        </div>\n        <div aria-live=\"polite\" class=\"focus-status\" data-dynamic=\"true\" data-kid=\"1-1-6\" data-name=\"status notification area\" data-reason=\"text content and visibility replaced by status script\" id=\"focus-status\" role=\"status\">\n        </div>\n    </article>\n</main>\n<script type=\"module\">\n    import { animate } from 'https://cdn.jsdelivr.net/npm/motion@12/+esm';\n\n  const card = document.querySelector('#layered-focus-card');\n  const status = document.querySelector('#focus-status');\n  const repsValue = document.querySelector('#reps-value');\n  const weightValue = document.querySelector('#weight-value');\n  const weightHint = document.querySelector('#weight-hint');\n  const weightUnit = document.querySelector('#weight-unit');\n  const save = document.querySelector('#focus-save');\n  let reps = 12;\n  let weight = null;\n  let timer;\n\n  animate(card, { opacity: [0, 1], y: [18, 0], scale: [0.985, 1] }, { duration: 0.72, easing: [0.22, 1, 0.36, 1] });\n\n  function announce(message) {\n    status.textContent = message;\n    status.classList.add('is-visible');\n    clearTimeout(timer);\n    timer = setTimeout(() => status.classList.remove('is-visible'), 2200);\n  }\n\n  function pulse(element) {\n    animate(element, { scale: [1, 0.88, 1], y: [0, -3, 0] }, { duration: 0.24, easing: 'ease-out' });\n  }\n\n  document.querySelectorAll('[data-step]').forEach((button) => {\n    button.addEventListener('click', () => {\n      const type = button.dataset.step;\n      const direction = button.dataset.direction === 'up' ? 1 : -1;\n      const control = button.closest('[data-control]');\n      control.classList.add('is-active');\n      setTimeout(() => control.classList.remove('is-active'), 700);\n\n      if (type === 'reps') {\n        reps = Math.max(1, Math.min(30, reps + direction));\n        repsValue.textContent = reps;\n        pulse(repsValue);\n        announce(`Repeticiones ajustadas a ${reps}`);\n      } else {\n        weight = Math.max(0, (weight ?? 0) + direction * 2.5);\n        weightValue.textContent = weight.toFixed(1);\n        weightHint.textContent = 'carga por serie';\n        weightUnit.textContent = 'kg · editable';\n        pulse(weightValue);\n        announce(`Peso ajustado a ${weight.toFixed(1)} kilos`);\n      }\n    });\n  });\n\n  document.querySelectorAll('[data-action=\"tech\"]').forEach((button) => {\n    button.addEventListener('click', () => announce('Técnica: escápulas atrás, pies firmes y barra al centro del pecho.'));\n  });\n\n  save.addEventListener('click', () => {\n    save.innerHTML = 'Serie guardada <i class=\"ti ti-check\" aria-hidden=\"true\"></i>';\n    announce(weight === null ? `Serie guardada con ${reps} repeticiones.` : `Serie guardada: ${reps} repeticiones con ${weight.toFixed(1)} kilos.`);\n    animate(save, { scale: [1, 0.97, 1] }, { duration: 0.3, easing: 'ease-out' });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-07-23T17:18:52.030814+00:00",
      "modified": "2026-07-23T17:19:21.543660+00:00",
      "id": "var_a83fbf483fa5"
    },
    "var_423927fcb2b5": {
      "type": "variant",
      "label": "Editorial Split — Reverse Seam",
      "parentId": "var_939b21962d15",
      "themeId": null,
      "rect": {
        "x": 3325,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700;800&family=Work+Sans:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .reverse-canvas {\n    --base: #111508;\n    --onyx: #111111;\n    --surface: #1a1d10;\n    --surface-high: #282b1d;\n    --ink: #e2e4cf;\n    --muted: #8e9379;\n    --muted-strong: #bcc1a4;\n    --lime: #c3f400;\n    --line: rgba(226,228,207,.18);\n    --quiet-line: rgba(142,147,121,.25);\n    min-height: 100vh;\n    padding: 22px 14px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ink);\n    background: #090c05;\n    font-family: 'Work Sans', sans-serif;\n  }\n\n  .reverse-card {\n    position: relative;\n    width: min(100%, 348px);\n    min-height: 704px;\n    display: grid;\n    grid-template-columns: 64% 36%;\n    overflow: hidden;\n    isolation: isolate;\n    border: 1px solid var(--line);\n    border-radius: 31px 18px 28px 12px;\n    background: var(--base);\n    box-shadow: 0 30px 64px rgba(0,0,0,.62), 0 1px 0 rgba(255,255,255,.06) inset;\n  }\n\n  .reverse-card::before {\n    content: '';\n    position: absolute;\n    z-index: 7;\n    inset: 0;\n    pointer-events: none;\n    border: 1px solid rgba(195,244,0,.1);\n    border-radius: inherit;\n  }\n\n  .content-panel {\n    position: relative;\n    z-index: 3;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    background: linear-gradient(155deg, #262a19 0%, #171b0e 28%, #111508 64%, #0e1207 100%);\n  }\n\n  .content-panel::after {\n    content: '';\n    position: absolute;\n    z-index: 0;\n    top: 0;\n    right: -34px;\n    width: 78px;\n    height: 100%;\n    pointer-events: none;\n    background: linear-gradient(90deg, rgba(17,21,8,0), rgba(195,244,0,.08));\n    mix-blend-mode: screen;\n  }\n\n  .photo-panel {\n    position: relative;\n    z-index: 2;\n    min-height: 704px;\n    overflow: hidden;\n    border-left: 1px solid rgba(226,228,207,.22);\n    background: var(--onyx);\n  }\n\n  .photo-panel img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: 51% center;\n    filter: grayscale(1) contrast(1.12) brightness(.66);\n  }\n\n  .photo-panel::before {\n    content: '';\n    position: absolute;\n    z-index: 1;\n    inset: 0;\n    background: linear-gradient(180deg, rgba(17,21,8,.18), rgba(17,21,8,.42) 38%, rgba(17,21,8,.95) 100%);\n  }\n\n  .photo-panel::after {\n    content: '';\n    position: absolute;\n    z-index: 2;\n    inset: 0;\n    background: linear-gradient(90deg, rgba(17,21,8,.72), transparent 56%);\n    pointer-events: none;\n  }\n\n  .photo-index {\n    position: absolute;\n    z-index: 4;\n    top: 22px;\n    right: 10px;\n    color: var(--lime);\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: 1.6px;\n    writing-mode: vertical-rl;\n  }\n\n  .vertical-mark {\n    position: absolute;\n    z-index: 4;\n    right: 12px;\n    bottom: 24px;\n    color: rgba(226,228,207,.66);\n    font-size: 8px;\n    font-weight: 700;\n    letter-spacing: 2.5px;\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    text-transform: uppercase;\n  }\n\n  .tech-button {\n    position: absolute;\n    z-index: 5;\n    top: 52px;\n    right: 10px;\n    width: 42px;\n    height: 42px;\n    min-width: 42px;\n    border: 1px solid rgba(195,244,0,.55);\n    border-radius: 999px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ink);\n    background: rgba(17,17,17,.54);\n    cursor: pointer;\n  }\n\n  .tech-button:hover,\n  .tech-button:focus-visible {\n    color: var(--lime);\n    border-color: var(--lime);\n    background: rgba(195,244,0,.14);\n    outline: 3px solid rgba(195,244,0,.19);\n    outline-offset: 2px;\n  }\n\n  .seam-rail {\n    position: absolute;\n    z-index: 8;\n    top: 68px;\n    bottom: 92px;\n    left: calc(64% - 1px);\n    width: 2px;\n    background: linear-gradient(180deg, transparent, var(--lime) 14%, var(--lime) 82%, transparent);\n    box-shadow: 0 0 18px rgba(195,244,0,.28);\n    pointer-events: none;\n  }\n\n  .seam-rail span {\n    position: absolute;\n    top: -16px;\n    left: 8px;\n    width: 52px;\n    color: var(--lime);\n    font-size: 8px;\n    font-weight: 800;\n    letter-spacing: 1px;\n    white-space: nowrap;\n  }\n\n  .identity {\n    position: relative;\n    z-index: 1;\n    min-height: 246px;\n    padding: 24px 16px 20px 22px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    border-bottom: 1px solid var(--quiet-line);\n  }\n\n  .identity-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n  }\n\n  .eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    color: var(--lime);\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n  }\n\n  .eyebrow::before {\n    content: '';\n    width: 16px;\n    height: 2px;\n    background: var(--lime);\n    box-shadow: 0 0 10px rgba(195,244,0,.45);\n  }\n\n  .session-count {\n    color: var(--muted-strong);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 1px;\n  }\n\n  .title {\n    max-width: 264px;\n    margin: 38px 0 0;\n    color: var(--ink);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: clamp(40px, 12vw, 52px);\n    font-weight: 700;\n    letter-spacing: -.7px;\n    line-height: .85;\n    text-shadow: 0 10px 26px rgba(0,0,0,.48);\n  }\n\n  .subtitle {\n    max-width: 210px;\n    margin-top: 12px;\n    color: var(--muted-strong);\n    font-size: 10px;\n    line-height: 1.35;\n  }\n\n  .baseline {\n    position: relative;\n    z-index: 1;\n    padding: 16px 16px 17px 22px;\n    border-bottom: 1px solid var(--quiet-line);\n  }\n\n  .kicker {\n    margin-bottom: 11px;\n    color: var(--muted);\n    font-size: 8px;\n    font-weight: 800;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n  }\n\n  .baseline-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1.1fr;\n    align-items: end;\n  }\n\n  .baseline-item {\n    padding-right: 9px;\n    border-right: 1px solid rgba(142,147,121,.3);\n  }\n\n  .baseline-item + .baseline-item { padding-left: 9px; }\n  .baseline-item:last-child { padding-right: 0; border-right: 0; }\n\n  .baseline-value {\n    color: var(--ink);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 30px;\n    font-weight: 600;\n    line-height: .9;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .baseline-value small {\n    color: var(--lime);\n    font-family: 'Work Sans', sans-serif;\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: .8px;\n    text-transform: uppercase;\n  }\n\n  .baseline-label {\n    margin-top: 6px;\n    color: var(--muted);\n    font-size: 8px;\n    font-weight: 700;\n    letter-spacing: .7px;\n    text-transform: uppercase;\n  }\n\n  .control-zone {\n    position: relative;\n    z-index: 1;\n    flex: 1;\n    margin: 16px 14px 0 16px;\n    padding: 14px 10px 12px;\n    border: 1px solid rgba(226,228,207,.14);\n    border-radius: 19px 10px 17px 8px;\n    background: rgba(17,17,17,.4);\n    box-shadow: 0 2px 18px rgba(0,0,0,.22) inset, 0 16px 28px rgba(0,0,0,.12);\n  }\n\n  .control-heading {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 8px;\n    margin: 0 2px 9px;\n  }\n\n  .control-heading h2 {\n    margin: 0;\n    color: var(--ink);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 21px;\n    font-weight: 600;\n    letter-spacing: .6px;\n    line-height: 1;\n  }\n\n  .control-heading span {\n    color: var(--muted);\n    font-size: 8px;\n    text-transform: uppercase;\n  }\n\n  .control-row {\n    min-height: 75px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n    padding: 10px 4px 10px 8px;\n    border-top: 1px solid rgba(142,147,121,.2);\n  }\n\n  .control-row.is-active {\n    border-top-color: rgba(195,244,0,.7);\n  }\n\n  .control-copy { min-width: 48px; }\n\n  .control-label {\n    color: var(--muted);\n    font-size: 8px;\n    font-weight: 800;\n    letter-spacing: 1.35px;\n    text-transform: uppercase;\n  }\n\n  .control-help {\n    margin-top: 5px;\n    color: var(--muted);\n    font-size: 8px;\n    line-height: 1.15;\n  }\n\n  .stepper {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .step-button {\n    width: 40px;\n    height: 40px;\n    min-width: 40px;\n    border: 1px solid rgba(226,228,207,.2);\n    border-radius: 11px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--muted-strong);\n    background: rgba(40,43,29,.76);\n    cursor: pointer;\n  }\n\n  .step-button:hover,\n  .step-button:focus-visible {\n    color: var(--lime);\n    border-color: rgba(195,244,0,.7);\n    background: rgba(195,244,0,.12);\n    outline: 3px solid rgba(195,244,0,.15);\n    outline-offset: 2px;\n  }\n\n  .stepper-value {\n    min-width: 42px;\n    color: var(--ink);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 33px;\n    font-weight: 600;\n    line-height: 1;\n    text-align: center;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .stepper-value.empty { color: var(--lime); font-size: 25px; }\n\n  .action-zone {\n    position: relative;\n    z-index: 1;\n    padding: 14px 16px 18px 16px;\n  }\n\n  .save-button {\n    width: 100%;\n    min-height: 50px;\n    border: 0;\n    border-radius: 14px 8px 14px 8px;\n    color: #111508;\n    background: var(--lime);\n    box-shadow: 0 10px 24px rgba(195,244,0,.17), 0 1px 0 rgba(255,255,255,.56) inset;\n    font-family: 'Work Sans', sans-serif;\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: .2px;\n    cursor: pointer;\n  }\n\n  .save-button:hover,\n  .save-button:focus-visible {\n    filter: brightness(1.06);\n    outline: 3px solid rgba(195,244,0,.23);\n    outline-offset: 3px;\n  }\n\n  .live-status {\n    position: absolute;\n    z-index: 10;\n    left: 22px;\n    right: 16px;\n    bottom: 78px;\n    padding: 7px 9px;\n    border: 1px solid rgba(195,244,0,.24);\n    border-radius: 9px;\n    color: var(--muted-strong);\n    background: rgba(17,17,17,.93);\n    font-size: 9px;\n    line-height: 1.2;\n    opacity: 0;\n    pointer-events: none;\n    transform: translateY(8px);\n  }\n\n  .live-status.visible { opacity: 1; transform: translateY(0); }\n\n  .sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0,0,0,0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  @media (max-width: 340px) {\n    .reverse-canvas { padding-inline: 8px; }\n    .reverse-card { grid-template-columns: 62% 38%; }\n    .identity, .baseline { padding-left: 17px; }\n    .title { font-size: 38px; }\n    .step-button { width: 36px; min-width: 36px; height: 36px; }\n  }\n</style>\n<main aria-label=\"Vista previa de tarjeta de ejercicio\" class=\"reverse-canvas\" data-kid=\"1\">\n    <article aria-label=\"Press banca plana\" class=\"reverse-card\" data-kid=\"1-1\" id=\"reverse-card\">\n        <section aria-label=\"Detalles y registro del ejercicio\" class=\"content-panel\" data-kid=\"1-1-1\">\n            <header class=\"identity\" data-kid=\"1-1-1-1\">\n                <div class=\"identity-top\" data-kid=\"1-1-1-1-1\">\n                    <span class=\"eyebrow\" data-kid=\"1-1-1-1-1-1\">\n                        Pecho\n                    </span>\n                    <span class=\"session-count\" data-kid=\"1-1-1-1-1-2\">\n                        01 / 04\n                    </span>\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <h1 class=\"title\" data-kid=\"1-1-1-1-2-1\">\n                        Press\n                        <br data-kid=\"1-1-1-1-2-1-1\"/>\n                        banca plana\n                    </h1>\n                    <p class=\"subtitle\" data-kid=\"1-1-1-1-2-2\">\n                        Fuerza · tren superior · controlá el descenso.\n                    </p>\n                </div>\n            </header>\n            <section aria-label=\"Prescripción del ejercicio\" class=\"baseline\" data-kid=\"1-1-1-2\">\n                <div class=\"kicker\" data-kid=\"1-1-1-2-1\">\n                    Prescripción\n                </div>\n                <div class=\"baseline-grid\" data-kid=\"1-1-1-2-2\">\n                    <div class=\"baseline-item\" data-kid=\"1-1-1-2-2-1\">\n                        <div class=\"baseline-value\" data-kid=\"1-1-1-2-2-1-1\">\n                            4\n                            <small data-kid=\"1-1-1-2-2-1-1-1\">\n                                series\n                            </small>\n                        </div>\n                        <div class=\"baseline-label\" data-kid=\"1-1-1-2-2-1-2\">\n                            volumen\n                        </div>\n                    </div>\n                    <div class=\"baseline-item\" data-kid=\"1-1-1-2-2-2\">\n                        <div class=\"baseline-value\" data-kid=\"1-1-1-2-2-2-1\">\n                            12\n                            <small data-kid=\"1-1-1-2-2-2-1-1\">\n                                reps\n                            </small>\n                        </div>\n                        <div class=\"baseline-label\" data-kid=\"1-1-1-2-2-2-2\">\n                            objetivo\n                        </div>\n                    </div>\n                    <div class=\"baseline-item\" data-kid=\"1-1-1-2-2-3\">\n                        <div class=\"baseline-value\" data-kid=\"1-1-1-2-2-3-1\">\n                            90\n                            <small data-kid=\"1-1-1-2-2-3-1-1\">\n                                s rest\n                            </small>\n                        </div>\n                        <div class=\"baseline-label\" data-kid=\"1-1-1-2-2-3-2\">\n                            recuperación\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"control-heading\" class=\"control-zone\" data-kid=\"1-1-1-3\">\n                <div class=\"control-heading\" data-kid=\"1-1-1-3-1\">\n                    <h2 data-kid=\"1-1-1-3-1-1\" id=\"control-heading\">\n                        Registrar serie\n                    </h2>\n                    <span data-kid=\"1-1-1-3-1-2\">\n                        ajuste rápido\n                    </span>\n                </div>\n                <div class=\"control-row\" data-control=\"reps\" data-kid=\"1-1-1-3-2\">\n                    <div class=\"control-copy\" data-kid=\"1-1-1-3-2-1\">\n                        <div class=\"control-label\" data-kid=\"1-1-1-3-2-1-1\">\n                            Reps\n                        </div>\n                        <div class=\"control-help\" data-kid=\"1-1-1-3-2-1-2\">\n                            por serie\n                        </div>\n                    </div>\n                    <div aria-label=\"Ajustar repeticiones\" class=\"stepper\" data-kid=\"1-1-1-3-2-2\">\n                        <button aria-label=\"Reducir repeticiones\" class=\"step-button\" data-direction=\"down\" data-kid=\"1-1-1-3-2-2-1\" data-step=\"reps\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-minus\" data-kid=\"1-1-1-3-2-2-1-1\">\n                            </i>\n                        </button>\n                        <output aria-live=\"polite\" class=\"stepper-value\" data-kid=\"1-1-1-3-2-2-2\" id=\"reps-value\">\n                            12\n                        </output>\n                        <button aria-label=\"Aumentar repeticiones\" class=\"step-button\" data-direction=\"up\" data-kid=\"1-1-1-3-2-2-3\" data-step=\"reps\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-1-3-2-2-3-1\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"control-row\" data-control=\"weight\" data-kid=\"1-1-1-3-3\">\n                    <div class=\"control-copy\" data-kid=\"1-1-1-3-3-1\">\n                        <div class=\"control-label\" data-kid=\"1-1-1-3-3-1-1\">\n                            Peso\n                        </div>\n                        <div class=\"control-help\" data-kid=\"1-1-1-3-3-1-2\" id=\"weight-help\">\n                            Añadir carga\n                        </div>\n                    </div>\n                    <div aria-label=\"Ajustar peso\" class=\"stepper\" data-kid=\"1-1-1-3-3-2\">\n                        <button aria-label=\"Reducir peso\" class=\"step-button\" data-direction=\"down\" data-kid=\"1-1-1-3-3-2-1\" data-step=\"weight\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-minus\" data-kid=\"1-1-1-3-3-2-1-1\">\n                            </i>\n                        </button>\n                        <output aria-live=\"polite\" class=\"stepper-value empty\" data-kid=\"1-1-1-3-3-2-2\" id=\"weight-value\">\n                            — kg\n                        </output>\n                        <button aria-label=\"Aumentar peso\" class=\"step-button\" data-direction=\"up\" data-kid=\"1-1-1-3-3-2-3\" data-step=\"weight\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-1-3-3-2-3-1\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </section>\n            <div class=\"action-zone\" data-kid=\"1-1-1-4\">\n                <button aria-label=\"Guardar serie de Press banca plana\" class=\"save-button\" data-dynamic=\"true\" data-kid=\"1-1-1-4-1\" data-name=\"save button\" data-reason=\"content replaced upon click event\" id=\"save-button\" type=\"button\">\n                    Guardar serie\n                    <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-1-1-4-1-1\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <aside aria-label=\"Imagen de Press banca plana\" class=\"photo-panel\" data-kid=\"1-1-2\">\n            <img alt=\"Atleta entrenando en luz dramática — foto de Cindy Koops, Unsplash\" data-kid=\"1-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1544021601-3e5723f9d333?auto=format&w=700&q=80&fit=crop\"/>\n            <span class=\"photo-index\" data-kid=\"1-1-2-2\">\n                PECHO\n            </span>\n            <span class=\"vertical-mark\" data-kid=\"1-1-2-3\">\n                fuerza · tren superior\n            </span>\n            <button aria-label=\"Ver técnica de Press banca plana\" class=\"tech-button\" data-kid=\"1-1-2-4\" id=\"tech-button\" title=\"Ver técnica\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-player-play-filled\" data-kid=\"1-1-2-4-1\">\n                </i>\n            </button>\n        </aside>\n        <div aria-hidden=\"true\" class=\"seam-rail\" data-kid=\"1-1-3\">\n            <span data-kid=\"1-1-3-1\">\n                01 — 04\n            </span>\n        </div>\n        <div aria-live=\"polite\" class=\"live-status\" data-dynamic=\"true\" data-kid=\"1-1-4\" data-name=\"live status message container\" data-reason=\"text replaced when messages are broadcast by script\" id=\"live-status\" role=\"status\">\n        </div>\n    </article>\n</main>\n<script type=\"module\">\n    import { animate } from 'https://cdn.jsdelivr.net/npm/motion@12/+esm';\n\n  const card = document.querySelector('#reverse-card');\n  const status = document.querySelector('#live-status');\n  const repsOutput = document.querySelector('#reps-value');\n  const weightOutput = document.querySelector('#weight-value');\n  const weightHelp = document.querySelector('#weight-help');\n  const saveButton = document.querySelector('#save-button');\n  const rows = [...document.querySelectorAll('[data-control]')];\n  let reps = 12;\n  let weight = null;\n  let statusTimer;\n\n  animate(card, { opacity: [0, 1], y: [22, 0], scale: [.985, 1] }, { duration: .72, easing: [0.22, 1, 0.36, 1] });\n\n  function announce(message) {\n    status.textContent = message;\n    status.classList.add('visible');\n    clearTimeout(statusTimer);\n    statusTimer = setTimeout(() => status.classList.remove('visible'), 2200);\n  }\n\n  function bump(element) {\n    animate(element, { scale: [1, .88, 1], y: [0, -3, 0] }, { duration: .24, easing: 'ease-out' });\n  }\n\n  document.querySelectorAll('[data-step]').forEach(button => {\n    button.addEventListener('click', () => {\n      const type = button.dataset.step;\n      const direction = button.dataset.direction === 'up' ? 1 : -1;\n      const row = button.closest('[data-control]');\n      rows.forEach(item => item.classList.remove('is-active'));\n      row.classList.add('is-active');\n      setTimeout(() => row.classList.remove('is-active'), 700);\n\n      if (type === 'reps') {\n        reps = Math.max(1, Math.min(30, reps + direction));\n        repsOutput.textContent = reps;\n        bump(repsOutput);\n        announce(`Repeticiones ajustadas a ${reps}`);\n      } else {\n        weight = Math.max(0, (weight ?? 0) + direction * 2.5);\n        weightOutput.textContent = `${weight.toFixed(1)} kg`;\n        weightOutput.classList.remove('empty');\n        weightHelp.textContent = 'carga por serie';\n        bump(weightOutput);\n        announce(`Peso ajustado a ${weight.toFixed(1)} kilos`);\n      }\n    });\n  });\n\n  document.querySelector('#tech-button').addEventListener('click', () => {\n    announce('Técnica: escápulas atrás, pies firmes y barra al centro del pecho.');\n  });\n\n  saveButton.addEventListener('click', () => {\n    saveButton.innerHTML = 'Serie guardada <i class=\"ti ti-check\" aria-hidden=\"true\"></i>';\n    announce(weight === null ? `Serie guardada con ${reps} repeticiones.` : `Serie guardada: ${reps} repeticiones con ${weight.toFixed(1)} kilos.`);\n    animate(saveButton, { scale: [1, .97, 1] }, { duration: .3, easing: 'ease-out' });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-07-23T17:18:56.679491+00:00",
      "modified": "2026-07-23T17:19:44.705877+00:00",
      "id": "var_423927fcb2b5"
    },
    "var_e4fe417f69c4": {
      "type": "variant",
      "label": "Editorial Split — Bottom Dock",
      "parentId": "var_939b21962d15",
      "themeId": null,
      "rect": {
        "x": 3800,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700;800&family=Work+Sans:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .bottom-dock-canvas {\n    --base: #111508;\n    --base-deep: #0b0e06;\n    --onyx: #111111;\n    --surface: #1a1d10;\n    --surface-high: #282b1d;\n    --ink: #e2e4cf;\n    --muted: #8e9379;\n    --muted-strong: #bdc1a7;\n    --lime: #c3f400;\n    --line: rgba(226, 228, 207, 0.17);\n    --quiet-line: rgba(142, 147, 121, 0.28);\n    min-height: 100vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 22px 14px;\n    color: var(--ink);\n    background: var(--base-deep);\n    font-family: 'Work Sans', sans-serif;\n  }\n\n  .bottom-dock-card {\n    position: relative;\n    width: min(100%, 348px);\n    min-height: 696px;\n    overflow: hidden;\n    isolation: isolate;\n    border: 1px solid rgba(226, 228, 207, 0.18);\n    border-radius: 30px;\n    background: var(--base);\n    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.62), 0 1px 0 rgba(255,255,255,0.06) inset;\n  }\n\n  .bottom-dock-card::before {\n    content: '';\n    position: absolute;\n    z-index: 5;\n    inset: 0 auto 0 0;\n    width: 3px;\n    background: linear-gradient(180deg, var(--lime), rgba(195,244,0,0.18) 62%, transparent);\n    box-shadow: 0 0 18px rgba(195,244,0,0.26);\n    pointer-events: none;\n  }\n\n  .performance-surface {\n    position: relative;\n    z-index: 2;\n    min-height: 534px;\n    padding: 24px 20px 18px 28px;\n    background: radial-gradient(circle at 92% 8%, rgba(195,244,0,0.07), transparent 28%), linear-gradient(145deg, rgba(40,43,29,0.7), rgba(17,21,8,0.98) 45%);\n  }\n\n  .editorial-meta {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n  }\n\n  .editorial-meta .category {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    color: var(--lime);\n  }\n\n  .editorial-meta .category::before {\n    content: '';\n    width: 16px;\n    height: 2px;\n    background: var(--lime);\n    box-shadow: 0 0 10px rgba(195,244,0,0.38);\n  }\n\n  .editorial-meta .index {\n    color: var(--muted-strong);\n    letter-spacing: 1.2px;\n  }\n\n  .identity {\n    position: relative;\n    min-height: 170px;\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-end;\n    padding: 30px 0 24px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .identity h1 {\n    max-width: 295px;\n    margin: 0;\n    color: var(--ink);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: clamp(50px, 16vw, 64px);\n    font-weight: 700;\n    letter-spacing: -1.2px;\n    line-height: 0.82;\n    text-wrap: balance;\n    text-shadow: 0 10px 26px rgba(0,0,0,0.48);\n  }\n\n  .identity p {\n    max-width: 240px;\n    margin: 15px 0 0;\n    color: var(--muted-strong);\n    font-size: 11px;\n    line-height: 1.45;\n  }\n\n  .tech-button {\n    position: absolute;\n    right: 0;\n    bottom: 25px;\n    width: 46px;\n    height: 46px;\n    min-width: 46px;\n    border: 1px solid rgba(195,244,0,0.45);\n    border-radius: 999px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ink);\n    background: rgba(17,17,17,0.46);\n    cursor: pointer;\n  }\n\n  .tech-button:hover,\n  .tech-button:focus-visible {\n    color: var(--lime);\n    border-color: var(--lime);\n    background: rgba(195,244,0,0.12);\n    outline: 3px solid rgba(195,244,0,0.16);\n    outline-offset: 3px;\n  }\n\n  .prescription {\n    padding: 18px 0 20px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .section-kicker {\n    margin: 0 0 14px;\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n  }\n\n  .prescription-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1.12fr;\n    align-items: end;\n  }\n\n  .prescription-item {\n    min-width: 0;\n    padding-right: 12px;\n    border-right: 1px solid var(--quiet-line);\n  }\n\n  .prescription-item + .prescription-item { padding-left: 12px; }\n  .prescription-item:last-child { padding-right: 0; border-right: 0; }\n\n  .prescription-value {\n    color: var(--ink);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 35px;\n    font-weight: 600;\n    letter-spacing: 0.2px;\n    line-height: 0.85;\n  }\n\n  .prescription-value em {\n    color: var(--lime);\n    font-family: 'Work Sans', sans-serif;\n    font-size: 9px;\n    font-style: normal;\n    font-weight: 800;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n  }\n\n  .prescription-label {\n    margin-top: 8px;\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: 0.7px;\n    text-transform: uppercase;\n  }\n\n  .adjust-section {\n    padding-top: 18px;\n  }\n\n  .adjust-header {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 8px;\n    margin-bottom: 13px;\n  }\n\n  .adjust-header h2 {\n    margin: 0;\n    color: var(--ink);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 25px;\n    font-weight: 600;\n    letter-spacing: 0.8px;\n    line-height: 1;\n  }\n\n  .adjust-header span {\n    color: var(--muted);\n    font-size: 9px;\n    text-align: right;\n  }\n\n  .control-console {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 10px;\n  }\n\n  .control-field {\n    min-height: 132px;\n    padding: 13px 11px 12px;\n    border: 1px solid rgba(226,228,207,0.16);\n    border-radius: 19px;\n    background: rgba(17,17,17,0.48);\n    box-shadow: 0 10px 22px rgba(0,0,0,0.15) inset;\n  }\n\n  .control-field.is-active {\n    border-color: rgba(195,244,0,0.82);\n    box-shadow: 0 0 0 3px rgba(195,244,0,0.09), 0 10px 22px rgba(0,0,0,0.18) inset;\n  }\n\n  .control-label {\n    display: block;\n    color: var(--muted);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n  }\n\n  .control-helper {\n    display: block;\n    min-height: 13px;\n    margin-top: 5px;\n    color: var(--muted);\n    font-size: 9px;\n    line-height: 1.2;\n  }\n\n  .value-line {\n    min-height: 58px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 6px;\n    margin-top: 7px;\n  }\n\n  .value-line output {\n    min-width: 50px;\n    color: var(--ink);\n    font-family: 'Big Shoulders Display', sans-serif;\n    font-size: 39px;\n    font-weight: 600;\n    letter-spacing: 0.2px;\n    line-height: 0.85;\n    text-align: center;\n  }\n\n  .value-line output.empty { color: var(--lime); font-size: 31px; }\n\n  .step-button {\n    width: 44px;\n    height: 44px;\n    min-width: 44px;\n    border: 1px solid rgba(226,228,207,0.2);\n    border-radius: 12px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--muted-strong);\n    background: rgba(40,43,29,0.78);\n    cursor: pointer;\n  }\n\n  .step-button:hover,\n  .step-button:focus-visible {\n    color: var(--lime);\n    border-color: var(--lime);\n    background: rgba(195,244,0,0.12);\n    outline: 3px solid rgba(195,244,0,0.16);\n    outline-offset: 2px;\n  }\n\n  .weight-link {\n    width: 100%;\n    min-height: 26px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: flex-start;\n    gap: 6px;\n    padding: 0;\n    border: 0;\n    color: var(--lime);\n    background: transparent;\n    font-family: 'Work Sans', sans-serif;\n    font-size: 9px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .weight-link:hover,\n  .weight-link:focus-visible {\n    color: var(--ink);\n    outline: 2px solid rgba(195,244,0,0.22);\n    outline-offset: 3px;\n  }\n\n  .photo-footer {\n    position: absolute;\n    z-index: 1;\n    right: 0;\n    bottom: 0;\n    left: 0;\n    height: 205px;\n    overflow: hidden;\n    background: var(--onyx);\n  }\n\n  .photo-footer img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: center 56%;\n    filter: grayscale(1) contrast(1.15) brightness(0.58);\n  }\n\n  .photo-footer::before {\n    content: '';\n    position: absolute;\n    z-index: 1;\n    inset: 0;\n    background: linear-gradient(180deg, rgba(17,21,8,0.98) 0%, rgba(17,21,8,0.44) 48%, rgba(8,9,5,0.32) 100%);\n  }\n\n  .photo-footer::after {\n    content: 'FUERZA · TREN SUPERIOR';\n    position: absolute;\n    z-index: 2;\n    right: 18px;\n    bottom: 19px;\n    color: rgba(226,228,207,0.72);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 2px;\n  }\n\n  .bottom-dock {\n    position: absolute;\n    z-index: 7;\n    right: 18px;\n    bottom: 84px;\n    left: 28px;\n    min-height: 68px;\n    display: grid;\n    grid-template-columns: 1fr 52px;\n    gap: 9px;\n    padding: 9px;\n    border: 1px solid rgba(226,228,207,0.18);\n    border-radius: 20px;\n    background: rgba(26,29,16,0.92);\n    box-shadow: 0 18px 36px rgba(0,0,0,0.48), 0 1px 0 rgba(255,255,255,0.08) inset;\n    backdrop-filter: blur(14px);\n  }\n\n  .save-button,\n  .dock-tech {\n    min-height: 48px;\n    border-radius: 14px;\n    cursor: pointer;\n  }\n\n  .save-button {\n    border: 0;\n    color: #111508;\n    background: var(--lime);\n    box-shadow: 0 10px 24px rgba(195,244,0,0.18), 0 1px 0 rgba(255,255,255,0.52) inset;\n    font-family: 'Work Sans', sans-serif;\n    font-size: 12px;\n    font-weight: 800;\n  }\n\n  .save-button:hover,\n  .save-button:focus-visible {\n    filter: brightness(1.08);\n    outline: 3px solid rgba(195,244,0,0.22);\n    outline-offset: 3px;\n  }\n\n  .dock-tech {\n    border: 1px solid rgba(226,228,207,0.34);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ink);\n    background: rgba(17,17,17,0.55);\n  }\n\n  .dock-tech:hover,\n  .dock-tech:focus-visible {\n    color: var(--lime);\n    border-color: var(--lime);\n    background: rgba(195,244,0,0.1);\n    outline: 3px solid rgba(195,244,0,0.16);\n    outline-offset: 2px;\n  }\n\n  .live-status {\n    position: absolute;\n    z-index: 9;\n    right: 24px;\n    bottom: 157px;\n    left: 34px;\n    min-height: 24px;\n    padding: 6px 9px;\n    border: 1px solid rgba(195,244,0,0.24);\n    border-radius: 9px;\n    color: var(--muted-strong);\n    background: rgba(17,17,17,0.92);\n    font-size: 9px;\n    line-height: 1.2;\n    opacity: 0;\n    pointer-events: none;\n    transform: translateY(8px);\n  }\n\n  .live-status.visible { opacity: 1; transform: translateY(0); }\n\n  .sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0,0,0,0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  @media (max-width: 340px) {\n    .bottom-dock-canvas { padding-inline: 8px; }\n    .performance-surface { padding-left: 22px; }\n    .bottom-dock { left: 22px; }\n    .identity h1 { font-size: 47px; }\n    .step-button { width: 40px; min-width: 40px; }\n  }\n</style>\n<main aria-label=\"Vista previa de tarjeta de ejercicio\" class=\"bottom-dock-canvas\" data-kid=\"1\">\n    <article aria-label=\"Press banca plana\" class=\"bottom-dock-card\" data-kid=\"1-1\" id=\"bottom-dock-card\">\n        <section aria-label=\"Superficie de rendimiento\" class=\"performance-surface\" data-kid=\"1-1-1\">\n            <div class=\"editorial-meta\" data-kid=\"1-1-1-1\">\n                <span class=\"category\" data-kid=\"1-1-1-1-1\">\n                    PECHO\n                </span>\n                <span class=\"index\" data-kid=\"1-1-1-1-2\">\n                    01 / 04\n                </span>\n            </div>\n            <header class=\"identity\" data-kid=\"1-1-1-2\">\n                <h1 data-kid=\"1-1-1-2-1\">\n                    Press banca plana\n                </h1>\n                <p data-kid=\"1-1-1-2-2\">\n                    Controlá el descenso. Empujá con intención.\n                </p>\n                <button aria-label=\"Ver técnica de Press banca plana\" class=\"tech-button\" data-action=\"tech\" data-kid=\"1-1-1-2-3\" title=\"Ver técnica\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-player-play-filled\" data-kid=\"1-1-1-2-3-1\">\n                    </i>\n                </button>\n            </header>\n            <section aria-label=\"Prescripción del ejercicio\" class=\"prescription\" data-kid=\"1-1-1-3\">\n                <p class=\"section-kicker\" data-kid=\"1-1-1-3-1\">\n                    Prescripción\n                </p>\n                <div class=\"prescription-grid\" data-kid=\"1-1-1-3-2\">\n                    <div class=\"prescription-item\" data-kid=\"1-1-1-3-2-1\">\n                        <div class=\"prescription-value\" data-dynamic=\"true\" data-kid=\"1-1-1-3-2-1-1\" data-name=\"series count text\" data-reason=\"number reinitialized by click event\">\n                            4\n                            <em data-kid=\"1-1-1-3-2-1-1-1\">\n                                series\n                            </em>\n                        </div>\n                        <div class=\"prescription-label\" data-kid=\"1-1-1-3-2-1-2\">\n                            volumen\n                        </div>\n                    </div>\n                    <div class=\"prescription-item\" data-kid=\"1-1-1-3-2-2\">\n                        <div class=\"prescription-value\" data-dynamic=\"true\" data-kid=\"1-1-1-3-2-2-1\" data-name=\"reps count text\" data-reason=\"number reinitialized by click event\">\n                            12\n                            <em data-kid=\"1-1-1-3-2-2-1-1\">\n                                reps\n                            </em>\n                        </div>\n                        <div class=\"prescription-label\" data-kid=\"1-1-1-3-2-2-2\">\n                            objetivo\n                        </div>\n                    </div>\n                    <div class=\"prescription-item\" data-kid=\"1-1-1-3-2-3\">\n                        <div class=\"prescription-value\" data-kid=\"1-1-1-3-2-3-1\" data-name=\"rest time text\">\n                            90\n                            <em data-kid=\"1-1-1-3-2-3-1-1\">\n                                s rest\n                            </em>\n                        </div>\n                        <div class=\"prescription-label\" data-kid=\"1-1-1-3-2-3-2\">\n                            recuperación\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"adjust-title\" class=\"adjust-section\" data-kid=\"1-1-1-4\">\n                <div class=\"adjust-header\" data-kid=\"1-1-1-4-1\">\n                    <h2 data-kid=\"1-1-1-4-1-1\" id=\"adjust-title\">\n                        Ajustar serie\n                    </h2>\n                    <span data-kid=\"1-1-1-4-1-2\">\n                        Configurá tu carga\n                        <br data-kid=\"1-1-1-4-1-2-1\"/>\n                        antes de empezar\n                    </span>\n                </div>\n                <div class=\"control-console\" data-kid=\"1-1-1-4-2\">\n                    <div class=\"control-field\" data-control=\"weight\" data-kid=\"1-1-1-4-2-1\">\n                        <span class=\"control-label\" data-kid=\"1-1-1-4-2-1-1\">\n                            Peso\n                        </span>\n                        <span class=\"control-helper\" data-dynamic=\"true\" data-kid=\"1-1-1-4-2-1-2\" data-name=\"weight status helper text\" data-reason=\"text replaced by click events\" id=\"weight-helper\">\n                            Sin carga añadida\n                        </span>\n                        <div class=\"value-line\" data-kid=\"1-1-1-4-2-1-3\">\n                            <button aria-label=\"Reducir peso\" class=\"step-button\" data-direction=\"down\" data-kid=\"1-1-1-4-2-1-3-1\" data-step=\"weight\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-minus\" data-kid=\"1-1-1-4-2-1-3-1-1\">\n                                </i>\n                            </button>\n                            <output aria-live=\"polite\" class=\"empty\" data-dynamic=\"true\" data-kid=\"1-1-1-4-2-1-3-2\" data-name=\"weight output value text\" data-reason=\"value reinitialized by click events\" id=\"weight-value\">\n                                — kg\n                            </output>\n                            <button aria-label=\"Aumentar peso\" class=\"step-button\" data-direction=\"up\" data-kid=\"1-1-1-4-2-1-3-3\" data-step=\"weight\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-1-4-2-1-3-3-1\">\n                                </i>\n                            </button>\n                        </div>\n                        <button aria-label=\"Añadir peso a la serie\" class=\"weight-link\" data-action=\"weight\" data-kid=\"1-1-1-4-2-1-4\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-edit\" data-kid=\"1-1-1-4-2-1-4-1\">\n                            </i>\n                            Añadir peso\n                        </button>\n                    </div>\n                    <div class=\"control-field\" data-control=\"reps\" data-kid=\"1-1-1-4-2-2\">\n                        <span class=\"control-label\" data-kid=\"1-1-1-4-2-2-1\">\n                            Repeticiones\n                        </span>\n                        <span class=\"control-helper\" data-kid=\"1-1-1-4-2-2-2\">\n                            Objetivo por serie\n                        </span>\n                        <div class=\"value-line\" data-kid=\"1-1-1-4-2-2-3\">\n                            <button aria-label=\"Reducir repeticiones\" class=\"step-button\" data-direction=\"down\" data-kid=\"1-1-1-4-2-2-3-1\" data-step=\"reps\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-minus\" data-kid=\"1-1-1-4-2-2-3-1-1\">\n                                </i>\n                            </button>\n                            <output aria-live=\"polite\" data-dynamic=\"true\" data-kid=\"1-1-1-4-2-2-3-2\" data-name=\"reps output value text\" data-reason=\"value reinitialized by click events\" id=\"reps-value\">\n                                12\n                            </output>\n                            <button aria-label=\"Aumentar repeticiones\" class=\"step-button\" data-direction=\"up\" data-kid=\"1-1-1-4-2-2-3-3\" data-step=\"reps\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-1-4-2-2-3-3-1\">\n                                </i>\n                            </button>\n                        </div>\n                        <span class=\"sr-only\" data-kid=\"1-1-1-4-2-2-4\">\n                            Repeticiones por serie\n                        </span>\n                    </div>\n                </div>\n            </section>\n        </section>\n        <footer aria-label=\"Imagen de press banca\" class=\"photo-footer\" data-kid=\"1-1-2\">\n            <img alt=\"Atleta entrenando en luz dramática — foto de Cindy Koops, Unsplash\" data-kid=\"1-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1544021601-3e5723f9d333?auto=format&w=900&q=80&fit=crop\"/>\n        </footer>\n        <div aria-label=\"Acciones de la serie\" class=\"bottom-dock\" data-kid=\"1-1-3\">\n            <button aria-label=\"Guardar serie de Press banca plana\" class=\"save-button\" data-dynamic=\"true\" data-kid=\"1-1-3-1\" data-name=\"save button\" data-reason=\"innerHTML replaced on click\" id=\"save-button\" type=\"button\">\n                Guardar serie\n                <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-1-3-1-1\">\n                </i>\n            </button>\n            <button aria-label=\"Ver técnica de Press banca plana\" class=\"dock-tech\" data-action=\"tech\" data-kid=\"1-1-3-2\" title=\"Ver técnica\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-player-play\" data-kid=\"1-1-3-2-1\">\n                </i>\n            </button>\n        </div>\n        <div aria-live=\"polite\" class=\"live-status\" data-dynamic=\"true\" data-kid=\"1-1-4\" data-name=\"live status message container\" data-reason=\"text content updated by script\" id=\"live-status\" role=\"status\">\n        </div>\n    </article>\n</main>\n<script type=\"module\">\n    import { animate } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n\n  const card = document.querySelector('#bottom-dock-card');\n  const status = document.querySelector('#live-status');\n  const repsOutput = document.querySelector('#reps-value');\n  const weightOutput = document.querySelector('#weight-value');\n  const weightHelper = document.querySelector('#weight-helper');\n  const saveButton = document.querySelector('#save-button');\n  let reps = 12;\n  let weight = null;\n  let timer;\n\n  animate(card, { opacity: [0, 1], y: [20, 0], scale: [0.985, 1] }, { duration: 0.72, easing: [0.22, 1, 0.36, 1] });\n\n  function announce(message) {\n    status.textContent = message;\n    status.classList.add('visible');\n    clearTimeout(timer);\n    timer = setTimeout(() => status.classList.remove('visible'), 2200);\n  }\n\n  function pulse(target) {\n    animate(target, { scale: [1, 0.88, 1], y: [0, -3, 0] }, { duration: 0.25, easing: 'ease-out' });\n  }\n\n  document.querySelectorAll('[data-step]').forEach((button) => {\n    button.addEventListener('click', () => {\n      const type = button.dataset.step;\n      const direction = button.dataset.direction === 'up' ? 1 : -1;\n      const field = button.closest('.control-field');\n      field.classList.add('is-active');\n      setTimeout(() => field.classList.remove('is-active'), 850);\n\n      if (type === 'reps') {\n        reps = Math.max(1, Math.min(30, reps + direction));\n        repsOutput.textContent = reps;\n        pulse(repsOutput);\n        announce(`Repeticiones ajustadas a ${reps}`);\n      } else if (direction > 0) {\n        weight = Math.max(0, (weight ?? 0) + 2.5);\n        weightOutput.textContent = `${weight.toFixed(1)} kg`;\n        weightOutput.classList.remove('empty');\n        weightHelper.textContent = 'Carga por serie';\n        pulse(weightOutput);\n        announce(`Peso ajustado a ${weight.toFixed(1)} kilos`);\n      } else if (weight !== null) {\n        weight = Math.max(0, weight - 2.5);\n        weightOutput.textContent = weight === 0 ? '— kg' : `${weight.toFixed(1)} kg`;\n        if (weight === 0) {\n          weight = null;\n          weightOutput.classList.add('empty');\n          weightHelper.textContent = 'Sin carga añadida';\n        }\n        pulse(weightOutput);\n        announce('Peso reducido');\n      } else {\n        announce('Añadí peso usando el botón +');\n      }\n    });\n  });\n\n  document.querySelector('[data-action=\"weight\"]').addEventListener('click', () => {\n    if (weight === null) {\n      weight = 2.5;\n      weightOutput.textContent = '2.5 kg';\n      weightOutput.classList.remove('empty');\n      weightHelper.textContent = 'Carga por serie';\n      pulse(weightOutput);\n      announce('Peso añadido: 2.5 kilos');\n    } else {\n      announce(`Peso actual: ${weight.toFixed(1)} kilos`);\n    }\n  });\n\n  document.querySelectorAll('[data-action=\"tech\"]').forEach((button) => {\n    button.addEventListener('click', () => {\n      announce('Técnica: escápulas atrás, pies firmes y barra al centro del pecho.');\n      animate(button, { scale: [1, 0.9, 1] }, { duration: 0.3, easing: 'ease-out' });\n    });\n  });\n\n  saveButton.addEventListener('click', () => {\n    saveButton.innerHTML = 'Serie guardada <i class=\"ti ti-check\" aria-hidden=\"true\"></i>';\n    announce(weight === null ? `Serie guardada con ${reps} repeticiones.` : `Serie guardada: ${reps} repeticiones con ${weight.toFixed(1)} kilos.`);\n    animate(saveButton, { scale: [1, 0.97, 1] }, { duration: 0.3, easing: 'ease-out' });\n  });\n</script>\n",
